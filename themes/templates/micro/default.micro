# Generated by dotfiles-theme. Do not edit.
# Linked as ~/.config/micro/colorschemes/default.micro, so it shadows micro's
# builtin default; without a rendered theme micro keeps that builtin.
# Adapted from Catppuccin for micro (MIT).
color-link default "{{foreground}},{{background}}"
color-link comment "{{syntax_comment}}"
color-link selection "{{background}},{{accent}}"
color-link hlsearch "{{background}},{{accent}}"

color-link identifier "{{syntax_function}}"
color-link identifier.class "{{syntax_function}}"
color-link identifier.var "{{syntax_function}}"

color-link constant "{{syntax_constant}}"
color-link constant.number "{{syntax_number}}"
color-link constant.string "{{syntax_string}}"

color-link symbol "{{hue_pink}}"
color-link symbol.brackets "{{hue_rose}}"
color-link symbol.tag "{{syntax_tag}}"

color-link type "{{hue_blue}}"
color-link type.keyword "{{syntax_type}}"

color-link special "{{hue_pink}}"
color-link statement "{{syntax_keyword}}"
color-link preproc "{{hue_pink}}"

color-link underlined "{{hue_cyan}}"
color-link error "bold {{urgent}}"
color-link todo "bold {{warning}}"

color-link diff-added "{{success}}"
color-link diff-modified "{{warning}}"
color-link diff-deleted "{{urgent}}"

color-link gutter-error "{{urgent}}"
color-link gutter-warning "{{warning}}"

color-link scrollbar "{{syntax_comment}}"
color-link statusline "{{foreground}},{{background_alt}}"
color-link tabbar "{{foreground}},{{background_alt}}"
color-link indent-char "{{surface_hover}}"
color-link line-number "{{surface_hover}}"
color-link current-line-number "{{accent}}"

color-link cursor-line "{{surface}},{{foreground}}"
color-link color-column "{{surface}}"
color-link type.extended "default"
