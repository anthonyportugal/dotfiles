#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P)
STOW_DIR="$REPO_ROOT/home"
PACKAGES_DIR="$REPO_ROOT/packages"

COMMAND=""
PROFILE="desktop"
BACKEND_REQUEST="auto"
PLATFORM_REQUEST="auto"
TARGET_DIR=${HOME:?HOME no está definida}
APPLY=0
SYSTEM_ENABLED=1
STOW_ENABLED=1
MODE_SELECTION="both"
WM=""
WM_PATH=""
WM_PROFILE="desktop"
WM_PROFILE_SET=0
WM_ENTRYPOINT=""

declare -a WMS=()
declare -A WM_PATHS=()
declare -A WM_PROFILES=()
declare -A WM_ENTRYPOINTS=()

WALLPAPERS=0
WALLPAPERS_PATH=""
WALLPAPERS_ENTRYPOINT=""

PRIVATE=0
PRIVATE_PATH=""
PRIVATE_PROFILE="core"
PRIVATE_ENTRYPOINT=""
declare -a PRIVATE_WORK=()

PLATFORM=""
BACKEND=""

declare -a FEATURES=()
declare -a WM_FEATURES=()
declare -a REPO_PACKAGES=()
declare -a AUR_PACKAGES=()
declare -a EXTERNAL_PACKAGES=()
declare -a STOW_PACKAGES=()
declare -a INSTALLED_REPO_PACKAGES=()
declare -a INSTALLED_AUR_PACKAGES=()
declare -a MISSING_REPO_PACKAGES=()
declare -a MISSING_AUR_PACKAGES=()

declare -a LINK_MISSING=()
declare -a LINK_CONFLICTS=()
declare -a LINK_DUPLICATES=()
LINK_OK=0

info() {
  printf '==> %s\n' "$*"
}

warn() {
  printf 'aviso: %s\n' "$*" >&2
}

error() {
  printf 'error: %s\n' "$*" >&2
}

die() {
  error "$*"
  exit 1
}

usage_error() {
  error "$*"
  printf "Use '%s help' para ver la interfaz.\n" "$PROGRAM_NAME" >&2
  exit 2
}

usage() {
  cat <<EOF
Uso:
  $PROGRAM_NAME setup [opciones]
  $PROGRAM_NAME sync [opciones]
  $PROGRAM_NAME update [opciones]
  $PROGRAM_NAME bootstrap [opciones]
  $PROGRAM_NAME doctor [opciones]
  $PROGRAM_NAME unlink [opciones]
  $PROGRAM_NAME help

Comandos:
  setup      Asistente interactivo guiado para configurar e instalar por capas.
  sync       Re-sincroniza enlaces locales y paquetes sin tocar repositorios Git.
  update     Descarga actualizaciones de GitHub (fast-forward) y re-sincroniza.
  bootstrap  Resuelve dependencias y enlaces. Sólo modifica con --apply.
  doctor     Comprueba dependencias, sintaxis y enlaces sin modificar nada.
  unlink     Retira únicamente los enlaces Stow. Sólo modifica con --apply.

Opciones:
  --profile core|cli|desktop       Perfil acumulativo (default: desktop).
  --feature yazi-extras           Feature opt-in; se puede repetir.
  --backend auto|shelly|paru|yay|pacman
                                    Backend de paquetes (default: auto).
  --platform auto|cachyos|arch    Plataforma detectada u override explícito.
  --target DIR                    Home objetivo (default: \$HOME).
  --packages-only                 Opera o valida sólo paquetes del sistema.
  --stow-only                     Opera o valida sólo paquetes Stow.
  --wm bspwm|mangowm              Integra opcionalmente un WM independiente (repetible).
  --wm-path DIR                   Checkout externo del repositorio del WM.
  --wm-profile core|desktop       Perfil propio del WM (default: desktop).
  --wm-feature laptop|recording   Feature de MangoWM; se puede repetir.
  --wallpapers                    Integra la colección de wallpapers (anthonyportugal/walls).
  --wallpapers-path DIR           Checkout externo del repositorio de wallpapers.
  --private                       Integra la capa privada (anthonyportugal/dotfiles-private).
  --private-path DIR              Checkout externo del repositorio privado.
  --private-profile core|dev      Perfil de la capa privada (default: core).
  --private-work NOMBRE           Añade un componente laboral a la capa privada.
  --apply                         Aplica bootstrap/unlink; sin él hay dry-run.
  -h, --help                      Muestra esta ayuda.

Ejemplos:
  $PROGRAM_NAME setup
  $PROGRAM_NAME sync
  $PROGRAM_NAME update
  $PROGRAM_NAME bootstrap --profile desktop
  $PROGRAM_NAME bootstrap --profile desktop --feature yazi-extras --apply
  $PROGRAM_NAME bootstrap --wm bspwm --wm-path \$HOME/.dotfiles/wm/bspwm
  $PROGRAM_NAME bootstrap --wm mangowm --wm-path \$HOME/.dotfiles/wm/mangowm
  $PROGRAM_NAME doctor --profile desktop
  $PROGRAM_NAME unlink --profile desktop
  $PROGRAM_NAME unlink --profile desktop --apply
EOF
}

require_option_value() {
  local option_name=$1
  local option_value=${2-}
  [[ -n "$option_value" ]] || usage_error "$option_name necesita un valor"
}

parse_args() {
  if (( $# == 0 )); then
    if [[ -t 0 && -t 1 ]]; then
      COMMAND="setup"
      return 0
    fi
    usage
    exit 0
  fi

  COMMAND=$1
  shift

  case "$COMMAND" in
    bootstrap|doctor|unlink|sync|update|setup|install)
      ;;
    help|-h|--help)
      usage
      exit 0
      ;;
    *)
      usage_error "comando desconocido: $COMMAND"
      ;;
  esac

  while (( $# > 0 )); do
    case "$1" in
      --profile)
        require_option_value "$1" "${2-}"
        PROFILE=$2
        shift 2
        ;;
      --profile=*)
        PROFILE=${1#*=}
        require_option_value "--profile" "$PROFILE"
        shift
        ;;
      --feature)
        require_option_value "$1" "${2-}"
        FEATURES+=("$2")
        shift 2
        ;;
      --feature=*)
        local feature_value=${1#*=}
        require_option_value "--feature" "$feature_value"
        FEATURES+=("$feature_value")
        shift
        ;;
      --backend)
        require_option_value "$1" "${2-}"
        BACKEND_REQUEST=$2
        shift 2
        ;;
      --backend=*)
        BACKEND_REQUEST=${1#*=}
        require_option_value "--backend" "$BACKEND_REQUEST"
        shift
        ;;
      --platform)
        require_option_value "$1" "${2-}"
        PLATFORM_REQUEST=$2
        shift 2
        ;;
      --platform=*)
        PLATFORM_REQUEST=${1#*=}
        require_option_value "--platform" "$PLATFORM_REQUEST"
        shift
        ;;
      --target)
        require_option_value "$1" "${2-}"
        TARGET_DIR=$2
        shift 2
        ;;
      --target=*)
        TARGET_DIR=${1#*=}
        require_option_value "--target" "$TARGET_DIR"
        shift
        ;;
      --packages-only)
        [[ "$MODE_SELECTION" != "stow" ]] || \
          usage_error "--packages-only y --stow-only son excluyentes"
        MODE_SELECTION="packages"
        SYSTEM_ENABLED=1
        STOW_ENABLED=0
        shift
        ;;
      --stow-only)
        [[ "$MODE_SELECTION" != "packages" ]] || \
          usage_error "--packages-only y --stow-only son excluyentes"
        MODE_SELECTION="stow"
        SYSTEM_ENABLED=0
        STOW_ENABLED=1
        shift
        ;;
      --wm)
        require_option_value "$1" "${2-}"
        WM=$2
        case "$2" in
          both|all)
            append_unique WMS "mangowm"
            append_unique WMS "bspwm"
            ;;
          mango)
            WM="mangowm"
            append_unique WMS "mangowm"
            ;;
          *)
            append_unique WMS "$2"
            ;;
        esac
        shift 2
        ;;
      --wm=*)
        WM=${1#*=}
        require_option_value "--wm" "$WM"
        case "$WM" in
          both|all)
            append_unique WMS "mangowm"
            append_unique WMS "bspwm"
            ;;
          mango)
            WM="mangowm"
            append_unique WMS "mangowm"
            ;;
          *)
            append_unique WMS "$WM"
            ;;
        esac
        shift
        ;;
      --wm-path)
        require_option_value "$1" "${2-}"
        WM_PATH=$2
        if (( ${#WMS[@]} > 0 )); then
          WM_PATHS["${WMS[-1]}"]="$WM_PATH"
        fi
        shift 2
        ;;
      --wm-path=*)
        WM_PATH=${1#*=}
        require_option_value "--wm-path" "$WM_PATH"
        if (( ${#WMS[@]} > 0 )); then
          WM_PATHS["${WMS[-1]}"]="$WM_PATH"
        fi
        shift
        ;;
      --wm-profile)
        require_option_value "$1" "${2-}"
        WM_PROFILE=$2
        WM_PROFILE_SET=1
        shift 2
        ;;
      --wm-profile=*)
        WM_PROFILE=${1#*=}
        require_option_value "--wm-profile" "$WM_PROFILE"
        WM_PROFILE_SET=1
        shift
        ;;
      --wm-feature)
        require_option_value "$1" "${2-}"
        WM_FEATURES+=("$2")
        shift 2
        ;;
      --wm-feature=*)
        local wm_feature_value=${1#*=}
        require_option_value "--wm-feature" "$wm_feature_value"
        WM_FEATURES+=("$wm_feature_value")
        shift
        ;;
      --wallpapers)
        WALLPAPERS=1
        shift
        ;;
      --wallpapers-path)
        require_option_value "$1" "${2-}"
        WALLPAPERS_PATH=$2
        WALLPAPERS=1
        shift 2
        ;;
      --wallpapers-path=*)
        WALLPAPERS_PATH=${1#*=}
        require_option_value "--wallpapers-path" "$WALLPAPERS_PATH"
        WALLPAPERS=1
        shift
        ;;
      --private)
        PRIVATE=1
        shift
        ;;
      --private-path)
        require_option_value "$1" "${2-}"
        PRIVATE_PATH=$2
        PRIVATE=1
        shift 2
        ;;
      --private-path=*)
        PRIVATE_PATH=${1#*=}
        require_option_value "--private-path" "$PRIVATE_PATH"
        PRIVATE=1
        shift
        ;;
      --private-profile)
        require_option_value "$1" "${2-}"
        PRIVATE_PROFILE=$2
        PRIVATE=1
        shift 2
        ;;
      --private-profile=*)
        PRIVATE_PROFILE=${1#*=}
        require_option_value "--private-profile" "$PRIVATE_PROFILE"
        PRIVATE=1
        shift
        ;;
      --private-work)
        require_option_value "$1" "${2-}"
        PRIVATE_WORK+=("$2")
        PRIVATE=1
        shift 2
        ;;
      --private-work=*)
        local private_work_val=${1#*=}
        require_option_value "--private-work" "$private_work_val"
        PRIVATE_WORK+=("$private_work_val")
        PRIVATE=1
        shift
        ;;
      --apply)
        APPLY=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage_error "opción desconocida: $1"
        ;;
    esac
  done

  case "$PROFILE" in
    core|cli|desktop)
      ;;
    *)
      usage_error "perfil no soportado: $PROFILE"
      ;;
  esac

  case "$BACKEND_REQUEST" in
    auto|shelly|paru|yay|pacman)
      ;;
    *)
      usage_error "backend no soportado: $BACKEND_REQUEST"
      ;;
  esac

  case "$PLATFORM_REQUEST" in
    auto|cachyos|arch)
      ;;
    *)
      usage_error "plataforma no soportada: $PLATFORM_REQUEST"
      ;;
  esac

  case "$WM" in
    mango)
      WM="mangowm"
      ;;
    ""|bspwm|mangowm)
      ;;
    *)
      usage_error "WM no soportado: $WM"
      ;;
  esac

  case "$WM_PROFILE" in
    core|desktop)
      ;;
    *)
      usage_error "perfil de WM no soportado: $WM_PROFILE"
      ;;
  esac

  if [[ -z "$WM" && -n "$WM_PATH" ]]; then
    if [[ -f "$WM_PATH/bin/mango" ]]; then
      WM="mangowm"
      append_unique WMS "mangowm"
    elif [[ -f "$WM_PATH/bin/bspwm" ]]; then
      WM="bspwm"
      append_unique WMS "bspwm"
    fi
  fi

  if [[ "$COMMAND" =~ ^(bootstrap|doctor|unlink)$ ]]; then
    if [[ -n "$WM" ]]; then
      [[ -n "$WM_PATH" ]] || usage_error "--wm $WM requiere --wm-path DIR"
    else
      [[ -z "$WM_PATH" ]] || usage_error "--wm-path requiere --wm"
      (( WM_PROFILE_SET == 0 )) || usage_error "--wm-profile requiere --wm"
      (( ${#WM_FEATURES[@]} == 0 )) || usage_error "--wm-feature requiere --wm mangowm"
    fi
  fi

  if (( ${#WM_FEATURES[@]} > 0 )); then
    [[ "$WM" == mangowm || " ${WMS[*]} " =~ " mangowm " ]] || usage_error "--wm-feature sólo es compatible con --wm mangowm"
    local wm_feature
    local -a unique_wm_features=()
    for wm_feature in "${WM_FEATURES[@]}"; do
      case "$wm_feature" in
        laptop|recording)
          append_unique unique_wm_features "$wm_feature"
          ;;
        *)
          usage_error "feature de WM no soportado: $wm_feature"
          ;;
      esac
    done
    WM_FEATURES=("${unique_wm_features[@]}")
  fi

  if (( PRIVATE == 1 )); then
    case "$PRIVATE_PROFILE" in
      core|development|dev)
        [[ "$PRIVATE_PROFILE" != "dev" ]] || PRIVATE_PROFILE="development"
        ;;
      *)
        usage_error "perfil de capa privada no soportado: $PRIVATE_PROFILE"
        ;;
    esac
  else
    [[ -z "$PRIVATE_PATH" ]] || usage_error "--private-path requiere --private"
    (( ${#PRIVATE_WORK[@]} == 0 )) || usage_error "--private-work requiere --private"
  fi

  if [[ "$COMMAND" == "doctor" && "$APPLY" == 1 ]]; then
    usage_error "doctor siempre es read-only y no acepta --apply"
  fi

  if [[ "$COMMAND" == "unlink" ]]; then
    [[ "$MODE_SELECTION" != "packages" ]] || \
      usage_error "unlink sólo gestiona enlaces y no acepta --packages-only"
    SYSTEM_ENABLED=0
    STOW_ENABLED=1
  fi
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

trim_line() {
  local value=$1
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "$value"
}

append_unique() {
  local array_name=$1
  local value=$2
  local -n append_destination_ref=$array_name
  local existing

  for existing in "${append_destination_ref[@]}"; do
    [[ "$existing" != "$value" ]] || return 0
  done
  append_destination_ref+=("$value")
}

array_contains() {
  local array_name=$1
  local expected=$2
  local -n entries=$array_name
  local entry

  for entry in "${entries[@]}"; do
    [[ "$entry" != "$expected" ]] || return 0
  done
  return 1
}

read_manifest() {
  local manifest_path=$1
  local array_name=$2
  local -n manifest_destination_ref=$array_name
  local raw_line line
  declare -A manifest_seen=()

  [[ -f "$manifest_path" ]] || die "no existe el manifiesto $manifest_path"
  manifest_destination_ref=()

  while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
    line=$(trim_line "$raw_line")
    [[ -n "$line" ]] || continue
    [[ "$line" != \#* ]] || continue
    [[ "$line" != *\#* ]] || \
      die "comentario inline no permitido en $manifest_path: $line"
    [[ "$line" != -* ]] || die "entrada insegura en $manifest_path: $line"
    [[ "$line" =~ ^[A-Za-z0-9@._+:-]+$ ]] || \
      die "entrada inválida en $manifest_path: $line"
    [[ ! -v "manifest_seen[$line]" ]] || \
      die "entrada duplicada en $manifest_path: $line"
    manifest_seen["$line"]=1
    manifest_destination_ref+=("$line")
  done < "$manifest_path"
}

append_manifest_unique() {
  local array_name=$1
  local manifest_path=$2
  local -a manifest_entries=()
  local entry

  read_manifest "$manifest_path" manifest_entries
  for entry in "${manifest_entries[@]}"; do
    append_unique "$array_name" "$entry"
  done
}

validate_features() {
  local feature
  local -a unique_features=()

  for feature in "${FEATURES[@]}"; do
    case "$feature" in
      yazi-extras)
        append_unique unique_features "$feature"
        ;;
      *)
        usage_error "feature no soportado: $feature"
        ;;
    esac
  done
  FEATURES=("${unique_features[@]}")
}

read_os_release_value() {
  local requested_key=$1
  local key value

  [[ -r /etc/os-release ]] || return 1
  while IFS='=' read -r key value; do
    [[ "$key" == "$requested_key" ]] || continue
    if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
      value=${value:1:${#value}-2}
    fi
    printf '%s' "$value"
    return 0
  done < /etc/os-release
  return 1
}

detect_platform() {
  local os_id os_like os_identity

  if [[ "$PLATFORM_REQUEST" != "auto" ]]; then
    PLATFORM=$PLATFORM_REQUEST
    return 0
  fi

  os_id=$(read_os_release_value ID || true)
  os_like=$(read_os_release_value ID_LIKE || true)
  os_identity=" $os_id $os_like "

  if [[ "$os_identity" == *" cachyos "* ]]; then
    PLATFORM="cachyos"
  elif [[ "$os_identity" == *" arch "* || "$os_id" == arch* ]]; then
    PLATFORM="arch"
  else
    die "plataforma no soportada (${os_id:-desconocida}); use --platform sólo si es compatible con Arch"
  fi
}

package_in_official_arch_repos() {
  local package_name=$1
  local repo_name

  for repo_name in core extra multilib; do
    if pacman -Si "$repo_name/$package_name" >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

resolve_system_packages() {
  local -a tiers=()
  local -a fallback_packages=()
  local tier package_name feature

  REPO_PACKAGES=()
  AUR_PACKAGES=()
  EXTERNAL_PACKAGES=()

  case "$PROFILE" in
    core)
      tiers=(core)
      ;;
    cli)
      tiers=(core cli)
      ;;
    desktop)
      tiers=(core cli desktop)
      ;;
  esac

  for tier in "${tiers[@]}"; do
    append_manifest_unique REPO_PACKAGES "$PACKAGES_DIR/repo/$tier.txt"
  done

  for feature in "${FEATURES[@]}"; do
    append_manifest_unique REPO_PACKAGES "$PACKAGES_DIR/repo/$feature.txt"
  done

  if [[ "$PROFILE" == "desktop" ]]; then
    if [[ "$PLATFORM" == "cachyos" ]]; then
      append_manifest_unique REPO_PACKAGES "$PACKAGES_DIR/cachyos/desktop.txt"
    else
      read_manifest "$PACKAGES_DIR/aur/desktop-fallback.txt" fallback_packages
      for package_name in "${fallback_packages[@]}"; do
        if package_in_official_arch_repos "$package_name"; then
          append_unique REPO_PACKAGES "$package_name"
        else
          append_unique AUR_PACKAGES "$package_name"
        fi
      done
    fi
    append_manifest_unique EXTERNAL_PACKAGES "$PACKAGES_DIR/external/desktop.txt"
  fi
}

resolve_stow_packages() {
  local -a tiers=()
  local tier package_name

  STOW_PACKAGES=()
  case "$PROFILE" in
    core)
      tiers=(core)
      ;;
    cli)
      tiers=(core cli)
      ;;
    desktop)
      tiers=(core cli desktop)
      ;;
  esac

  for tier in "${tiers[@]}"; do
    local -a tier_packages=()
    read_manifest "$PACKAGES_DIR/stow/$tier.txt" tier_packages
    for package_name in "${tier_packages[@]}"; do
      [[ -d "$STOW_DIR/$package_name" ]] || \
        die "el paquete Stow '$package_name' no existe bajo $STOW_DIR"
      append_unique STOW_PACKAGES "$package_name"
    done
  done
}

detect_backend() {
  local -a backend_order=()
  local candidate

  if [[ "$BACKEND_REQUEST" != "auto" ]]; then
    command_exists "$BACKEND_REQUEST" || \
      die "el backend solicitado no está instalado: $BACKEND_REQUEST"
    BACKEND=$BACKEND_REQUEST
    return 0
  fi

  read_manifest "$PACKAGES_DIR/package-backends.txt" backend_order
  for candidate in "${backend_order[@]}"; do
    case "$candidate" in
      shelly)
        [[ "$PLATFORM" == "cachyos" ]] || continue
        ;;
      paru|yay|pacman)
        ;;
      *)
        die "backend desconocido en package-backends.txt: $candidate"
        ;;
    esac
    if command_exists "$candidate"; then
      BACKEND=$candidate
      return 0
    fi
  done

  die "no se encontró ningún backend de paquetes soportado"
}

package_is_installed() {
  pacman -Qq "$1" >/dev/null 2>&1
}

classify_packages() {
  local package_name

  INSTALLED_REPO_PACKAGES=()
  INSTALLED_AUR_PACKAGES=()
  MISSING_REPO_PACKAGES=()
  MISSING_AUR_PACKAGES=()

  for package_name in "${REPO_PACKAGES[@]}"; do
    if package_is_installed "$package_name"; then
      INSTALLED_REPO_PACKAGES+=("$package_name")
    else
      MISSING_REPO_PACKAGES+=("$package_name")
    fi
  done

  for package_name in "${AUR_PACKAGES[@]}"; do
    if package_is_installed "$package_name"; then
      INSTALLED_AUR_PACKAGES+=("$package_name")
    else
      MISSING_AUR_PACKAGES+=("$package_name")
    fi
  done
}

print_array() {
  local label=$1
  local array_name=$2
  local -n entries=$array_name

  if (( ${#entries[@]} == 0 )); then
    printf '  %-24s %s\n' "$label:" '(ninguno)'
  else
    printf '  %-24s %s\n' "$label:" "${entries[*]}"
  fi
}

format_command() {
  local argument
  printf '    '
  for argument in "$@"; do
    printf '%q ' "$argument"
  done
  printf '\n'
}

validate_wm_checkout() {
  local base_root wm_root current_wm

  if (( ${#WMS[@]} == 0 )) && [[ -n "$WM" ]]; then
    WMS+=("$WM")
  fi

  (( ${#WMS[@]} > 0 )) || return 0
  command_exists realpath || die "falta el comando requerido: realpath"

  base_root=$(realpath -m -- "$REPO_ROOT")

  for current_wm in "${WMS[@]}"; do
    case "$current_wm" in
      bspwm|mangowm)
        ;;
      *)
        die "entorno de ventanas no soportado: $current_wm"
        ;;
    esac

    local path="${WM_PATHS[$current_wm]-}"
    if [[ -z "$path" ]]; then
      if [[ -n "$WM_PATH" && ${#WMS[@]} -eq 1 ]]; then
        path="$WM_PATH"
      elif [[ -d "$TARGET_DIR/.dotfiles/wm/$current_wm" ]]; then
        path="$TARGET_DIR/.dotfiles/wm/$current_wm"
      elif [[ -d "$REPO_ROOT/../wm/$current_wm" ]]; then
        path="$REPO_ROOT/../wm/$current_wm"
      fi
    fi

    [[ -n "$path" ]] || die "--wm $current_wm requiere --wm-path DIR"

    wm_root=$(realpath -m -- "$path")
    [[ -d "$wm_root" ]] || die "el checkout del WM no existe: $wm_root"
    [[ "$wm_root" != "$base_root" && "$wm_root" != "$base_root/"* ]] || \
      die "el checkout del WM debe estar fuera del repositorio base: $wm_root"

    local entrypoint=""
    case "$current_wm" in
      bspwm)
        entrypoint="$wm_root/bin/bspwm"
        ;;
      mangowm)
        entrypoint="$wm_root/bin/mango"
        ;;
    esac

    [[ -f "$entrypoint" && -x "$entrypoint" ]] || \
      die "el checkout de $current_wm no expone el entrypoint ejecutable esperado: $entrypoint"

    WM_PATHS["$current_wm"]="$wm_root"
    WM_ENTRYPOINTS["$current_wm"]="$entrypoint"
  done

  WM="${WMS[0]}"
  WM_PATH="${WM_PATHS[${WMS[0]}]}"
  WM_ENTRYPOINT="${WM_ENTRYPOINTS[${WMS[0]}]}"
}

run_wm_operation() {
  local operation=$1
  local apply_mode=$2
  local current_wm

  (( ${#WMS[@]} > 0 )) || return 0

  for current_wm in "${WMS[@]}"; do
    local entrypoint="${WM_ENTRYPOINTS[$current_wm]}"
    local wm_path="${WM_PATHS[$current_wm]}"
    local -a wm_command=(
      "$entrypoint"
      "$operation"
      "--profile=${WM_PROFILES[$current_wm]:-$WM_PROFILE}"
      "--backend=$BACKEND_REQUEST"
      "--platform=$PLATFORM_REQUEST"
      "--target=$TARGET_DIR"
    )

    if [[ "$current_wm" == mangowm ]]; then
      local wm_feature
      for wm_feature in "${WM_FEATURES[@]}"; do
        wm_command+=("--feature=$wm_feature")
      done
    fi

    case "$MODE_SELECTION" in
      packages)
        wm_command+=(--packages-only)
        ;;
      stow)
        wm_command+=(--stow-only)
        ;;
    esac

    if [[ "$apply_mode" == 1 && "$operation" != doctor ]]; then
      wm_command+=(--apply)
    fi

    info "Delegando en el repositorio $current_wm ($wm_path)"
    format_command "${wm_command[@]}"
    "${wm_command[@]}"
  done
}

validate_wallpapers_checkout() {
  local base_root walls_root

  (( WALLPAPERS == 1 )) || return 0
  command_exists realpath || die "falta el comando requerido: realpath"

  if [[ -z "$WALLPAPERS_PATH" ]]; then
    if [[ -d "$TARGET_DIR/.dotfiles/walls" ]]; then
      WALLPAPERS_PATH="$TARGET_DIR/.dotfiles/walls"
    elif [[ -d "$REPO_ROOT/../walls" ]]; then
      WALLPAPERS_PATH="$REPO_ROOT/../walls"
    elif [[ -L "$TARGET_DIR/.local/share/wallpapers" ]]; then
      local link_dest
      link_dest=$(readlink -f "$TARGET_DIR/.local/share/wallpapers" || true)
      if [[ -f "$link_dest/bin/walls" ]]; then
        WALLPAPERS_PATH=$link_dest
      elif [[ -f "${link_dest%/*}/bin/walls" ]]; then
        WALLPAPERS_PATH=${link_dest%/*}
      fi
    elif [[ -L "$TARGET_DIR/Pictures/Wallpapers" ]]; then
      local link_dest
      link_dest=$(readlink -f "$TARGET_DIR/Pictures/Wallpapers" || true)
      if [[ -f "$link_dest/bin/walls" ]]; then
        WALLPAPERS_PATH=$link_dest
      elif [[ -f "${link_dest%/*}/bin/walls" ]]; then
        WALLPAPERS_PATH=${link_dest%/*}
      fi
    fi
  fi

  [[ -n "$WALLPAPERS_PATH" ]] || die "--wallpapers requiere un checkout disponible o la opción --wallpapers-path DIR"

  base_root=$(realpath -m -- "$REPO_ROOT")
  walls_root=$(realpath -m -- "$WALLPAPERS_PATH")
  [[ -d "$walls_root" ]] || die "el checkout de wallpapers no existe: $walls_root"
  [[ "$walls_root" != "$base_root" && "$walls_root" != "$base_root/"* ]] || \
    die "el checkout de wallpapers debe estar fuera del repositorio base: $walls_root"

  WALLPAPERS_ENTRYPOINT="$walls_root/bin/walls"
  [[ -f "$WALLPAPERS_ENTRYPOINT" && -x "$WALLPAPERS_ENTRYPOINT" ]] || \
    die "el checkout de wallpapers no expone el entrypoint ejecutable esperado: $WALLPAPERS_ENTRYPOINT"
  WALLPAPERS_PATH=$walls_root
}

run_wallpapers_operation() {
  local operation=$1
  local apply_mode=$2
  local -a walls_command=()

  (( WALLPAPERS == 1 )) || return 0

  case "$operation" in
    doctor)
      walls_command=("$WALLPAPERS_ENTRYPOINT" doctor --target "$TARGET_DIR")
      ;;
    bootstrap)
      if [[ "$apply_mode" == 1 ]]; then
        walls_command=("$WALLPAPERS_ENTRYPOINT" link --target "$TARGET_DIR")
      else
        info "Simulando enlace de wallpapers (ejecute con --apply para aplicar)"
        format_command "$WALLPAPERS_ENTRYPOINT" link --target "$TARGET_DIR"
        return 0
      fi
      ;;
    unlink)
      if [[ "$apply_mode" == 1 ]]; then
        walls_command=("$WALLPAPERS_ENTRYPOINT" unlink --target "$TARGET_DIR")
      else
        info "Simulando desvinculación de wallpapers (ejecute con --apply para aplicar)"
        format_command "$WALLPAPERS_ENTRYPOINT" unlink --target "$TARGET_DIR"
        return 0
      fi
      ;;
  esac

  info "Operando sobre repositorio de wallpapers ($WALLPAPERS_PATH)"
  format_command "${walls_command[@]}"
  "${walls_command[@]}"
}

validate_private_checkout() {
  local base_root private_root

  (( PRIVATE == 1 )) || return 0
  command_exists realpath || die "falta el comando requerido: realpath"

  if [[ -z "$PRIVATE_PATH" ]]; then
    if [[ -d "$TARGET_DIR/.dotfiles/private" ]]; then
      PRIVATE_PATH="$TARGET_DIR/.dotfiles/private"
    elif [[ -d "$REPO_ROOT/../private" ]]; then
      PRIVATE_PATH="$REPO_ROOT/../private"
    fi
  fi

  [[ -n "$PRIVATE_PATH" ]] || die "--private requiere un checkout disponible o la opción --private-path DIR"

  base_root=$(realpath -m -- "$REPO_ROOT")
  private_root=$(realpath -m -- "$PRIVATE_PATH")
  [[ -d "$private_root" ]] || die "el checkout de la capa privada no existe: $private_root"
  [[ "$private_root" != "$base_root" && "$private_root" != "$base_root/"* ]] || \
    die "el checkout de la capa privada debe estar fuera del repositorio base: $private_root"

  PRIVATE_ENTRYPOINT="$private_root/bin/dotfiles-private"
  [[ -f "$PRIVATE_ENTRYPOINT" && -x "$PRIVATE_ENTRYPOINT" ]] || \
    die "el checkout de la capa privada no expone el entrypoint ejecutable esperado: $PRIVATE_ENTRYPOINT"
  PRIVATE_PATH=$private_root
}

build_private_command() {
  local operation=$1
  local apply_mode=$2
  local output_name=$3
  local -n private_output_ref=$output_name

  private_output_ref=(
    "$PRIVATE_ENTRYPOINT"
    "$operation"
    "--profile=$PRIVATE_PROFILE"
    "--backend=$BACKEND_REQUEST"
    "--platform=$PLATFORM_REQUEST"
    "--target=$TARGET_DIR"
  )

  local work_item
  for work_item in "${PRIVATE_WORK[@]}"; do
    private_output_ref+=("--work=$work_item")
  done

  case "$MODE_SELECTION" in
    packages)
      private_output_ref+=(--packages-only)
      ;;
    stow)
      private_output_ref+=(--stow-only)
      ;;
  esac

  if [[ "$apply_mode" == 1 && "$operation" != doctor ]]; then
    private_output_ref+=(--apply)
  fi
}

run_private_operation() {
  local operation=$1
  local apply_mode=$2
  local -a private_command=()

  (( PRIVATE == 1 )) || return 0
  build_private_command "$operation" "$apply_mode" private_command
  info "Delegando en el repositorio privado ($PRIVATE_PATH)"
  format_command "${private_command[@]}"
  "${private_command[@]}"
}



# ShellCheck no puede seguir el array que se devuelve mediante nameref.
# shellcheck disable=SC2034
build_repo_install_command() {
  local output_name=$1
  local -n repo_output_ref=$output_name

  repo_output_ref=()
  (( ${#MISSING_REPO_PACKAGES[@]} > 0 )) || return 0
  case "$BACKEND" in
    shelly)
      repo_output_ref=(shelly install standard "${MISSING_REPO_PACKAGES[@]}")
      ;;
    paru|yay)
      # Evita que el helper convierta silenciosamente una entrada repo en AUR.
      repo_output_ref=("$BACKEND" -S --needed --repo "${MISSING_REPO_PACKAGES[@]}")
      ;;
    pacman)
      if (( EUID == 0 )); then
        repo_output_ref=(pacman -S --needed "${MISSING_REPO_PACKAGES[@]}")
      else
        repo_output_ref=(sudo pacman -S --needed "${MISSING_REPO_PACKAGES[@]}")
      fi
      ;;
  esac
}

# ShellCheck no puede seguir el array que se devuelve mediante nameref.
# shellcheck disable=SC2034
build_aur_install_command() {
  local output_name=$1
  local -n aur_output_ref=$output_name

  aur_output_ref=()
  (( ${#MISSING_AUR_PACKAGES[@]} > 0 )) || return 0
  case "$BACKEND" in
    shelly)
      aur_output_ref=(shelly install aur "${MISSING_AUR_PACKAGES[@]}")
      ;;
    paru|yay)
      # Mantiene explícita la procedencia declarada por el manifest.
      aur_output_ref=("$BACKEND" -S --needed --aur "${MISSING_AUR_PACKAGES[@]}")
      ;;
    pacman)
      return 1
      ;;
  esac
}

show_package_commands() {
  local -a repo_command=()
  local -a aur_command=()
  local result=0

  info "Comandos de instalación previstos"
  build_repo_install_command repo_command
  if (( ${#repo_command[@]} > 0 )); then
    format_command "${repo_command[@]}"
  fi

  if ! build_aur_install_command aur_command; then
    error "pacman no puede instalar los paquetes AUR faltantes: ${MISSING_AUR_PACKAGES[*]}"
    result=1
  elif (( ${#aur_command[@]} > 0 )); then
    format_command "${aur_command[@]}"
  fi

  if (( ${#repo_command[@]} == 0 && ${#aur_command[@]} == 0 )); then
    printf '    (todos los paquetes seleccionados ya están instalados)\n'
  fi
  return "$result"
}

validate_package_plan() {
  local result=0

  if (( ${#EXTERNAL_PACKAGES[@]} > 0 )); then
    error "no hay adaptador para fuentes externas: ${EXTERNAL_PACKAGES[*]}"
    result=1
  fi
  if [[ "$BACKEND" == "pacman" && ${#MISSING_AUR_PACKAGES[@]} -gt 0 ]]; then
    error "el perfil necesita AUR pero pacman sólo gestiona repositorios; instale Shelly, paru o yay, o fuerce otro backend"
    result=1
  fi
  return "$result"
}

execute_package_install() {
  local -a repo_command=()
  local -a aur_command=()

  validate_package_plan || return 1
  if [[ "$BACKEND" == "pacman" && "$EUID" -ne 0 ]]; then
    command_exists sudo || die "sudo es necesario para instalar paquetes con pacman"
  fi

  build_repo_install_command repo_command
  build_aur_install_command aur_command

  if (( ${#repo_command[@]} > 0 )); then
    info "Instalando paquetes de repositorio con $BACKEND"
    "${repo_command[@]}"
  fi
  if (( ${#aur_command[@]} > 0 )); then
    info "Instalando paquetes AUR con $BACKEND; revise PKGBUILD y prompts del helper"
    "${aur_command[@]}"
  fi

  classify_packages
  if (( ${#MISSING_REPO_PACKAGES[@]} > 0 || ${#MISSING_AUR_PACKAGES[@]} > 0 )); then
    print_array "Repo aún faltantes" MISSING_REPO_PACKAGES
    print_array "AUR aún faltantes" MISSING_AUR_PACKAGES
    error "la validación posterior de paquetes falló"
    return 1
  fi
  return 0
}

inspect_links() {
  local package_name package_dir source_path relative_path target_path
  local canonical_source canonical_target existing_source link_value
  local package_entries relative_parent parent_component current_parent parent_state
  local -a parent_components=()
  declare -A target_owners=()
  declare -A parent_states=()

  LINK_OK=0
  LINK_MISSING=()
  LINK_CONFLICTS=()
  LINK_DUPLICATES=()

  for package_name in "${STOW_PACKAGES[@]}"; do
    package_dir="$STOW_DIR/$package_name"
    package_entries=0
    while IFS= read -r -d '' source_path; do
      ((package_entries += 1))
      relative_path=${source_path#"$package_dir"/}
      target_path="$TARGET_DIR/$relative_path"

      if [[ -v "target_owners[$target_path]" ]]; then
        existing_source=${target_owners[$target_path]}
        LINK_DUPLICATES+=("$target_path <- $existing_source y $source_path")
        continue
      fi
      target_owners["$target_path"]=$source_path

      relative_parent=${relative_path%/*}
      if [[ "$relative_parent" != "$relative_path" ]]; then
        IFS='/' read -r -a parent_components <<< "$relative_parent"
        current_parent=$TARGET_DIR
        for parent_component in "${parent_components[@]}"; do
          [[ -n "$parent_component" ]] || continue
          current_parent="$current_parent/$parent_component"
          if [[ -v "parent_states[$current_parent]" ]]; then
            parent_state=${parent_states[$current_parent]}
            [[ "$parent_state" == "ok" ]] && continue
            break
          fi

          if [[ -L "$current_parent" ]]; then
            link_value=$(readlink -- "$current_parent" || true)
            LINK_CONFLICTS+=("$current_parent (directorio padre es symlink a $link_value)")
            parent_states["$current_parent"]="blocked"
            break
          elif [[ -e "$current_parent" && ! -d "$current_parent" ]]; then
            LINK_CONFLICTS+=("$current_parent (ruta padre existe y no es directorio)")
            parent_states["$current_parent"]="blocked"
            break
          elif [[ -d "$current_parent" ]]; then
            parent_states["$current_parent"]="ok"
          else
            parent_states["$current_parent"]="missing"
            break
          fi
        done
      fi

      if [[ -L "$target_path" ]]; then
        canonical_source=$(realpath -m -- "$source_path")
        canonical_target=$(realpath -m -- "$target_path")
        if [[ "$canonical_source" == "$canonical_target" ]]; then
          ((LINK_OK += 1))
        else
          link_value=$(readlink -- "$target_path" || true)
          LINK_CONFLICTS+=("$target_path (symlink a $link_value)")
        fi
      elif [[ -e "$target_path" ]]; then
        LINK_CONFLICTS+=("$target_path (ya existe y no es el enlace esperado)")
      else
        LINK_MISSING+=("$target_path")
      fi
    done < <(find "$package_dir" -mindepth 1 \( -type f -o -type l \) -print0)

    (( package_entries > 0 )) || \
      LINK_CONFLICTS+=("$package_dir (paquete Stow vacío)")
  done
}

print_link_issues() {
  local issue

  for issue in "${LINK_DUPLICATES[@]}"; do
    error "ownership duplicado: $issue"
  done
  for issue in "${LINK_CONFLICTS[@]}"; do
    error "colisión: $issue"
  done
}

ensure_no_link_collisions() {
  inspect_links
  print_link_issues
  if (( ${#LINK_DUPLICATES[@]} > 0 || ${#LINK_CONFLICTS[@]} > 0 )); then
    return 1
  fi
  info "Preflight Stow: $LINK_OK enlaces correctos, ${#LINK_MISSING[@]} por crear, 0 colisiones"
  return 0
}

run_stow() {
  local operation=$1
  local simulate=$2
  local -a stow_command=(
    stow
    "--dir=$STOW_DIR"
    "--target=$TARGET_DIR"
    --no-folding
  )

  if [[ "$operation" == "delete" ]]; then
    stow_command+=(--delete)
  fi
  if [[ "$simulate" == 1 ]]; then
    stow_command+=(--simulate --verbose=1)
  else
    stow_command+=(--verbose=1)
  fi
  stow_command+=("${STOW_PACKAGES[@]}")

  format_command "${stow_command[@]}"
  "${stow_command[@]}"
}

validate_links_installed() {
  inspect_links
  print_link_issues
  if (( ${#LINK_DUPLICATES[@]} > 0 || ${#LINK_CONFLICTS[@]} > 0 || ${#LINK_MISSING[@]} > 0 )); then
    local missing_path
    for missing_path in "${LINK_MISSING[@]}"; do
      error "enlace ausente: $missing_path"
    done
    return 1
  fi
  info "Enlaces validados: $LINK_OK correctos"
  return 0
}

validate_links_unlinked() {
  inspect_links
  if (( LINK_OK > 0 )); then
    error "quedaron $LINK_OK enlaces que todavía apuntan al stow directory"
    return 1
  fi
  info "Unlink validado: no quedan enlaces administrados para el perfil"
  return 0
}

validate_zsh_syntax() {
  local config_path
  local result=0
  local -a config_paths=("$STOW_DIR/zsh/.zshrc")

  command_exists zsh || return 0
  while IFS= read -r -d '' config_path; do
    config_paths+=("$config_path")
  done < <(find "$STOW_DIR/zsh/.config/zsh" -type f -name '*.zsh' -print0)

  for config_path in "${config_paths[@]}"; do
    if ! zsh -n "$config_path"; then
      error "sintaxis Zsh inválida: $config_path"
      result=1
    fi
  done
  (( result == 0 )) && info "Sintaxis Zsh validada (${#config_paths[@]} archivos)"
  return "$result"
}

validate_git_contract() {
  local config_path="$STOW_DIR/git/.config/git/config"
  local legacy_config="$TARGET_DIR/.gitconfig"
  local identity_key
  local -a include_paths=()

  array_contains STOW_PACKAGES git || return 0
  command_exists git || {
    error "Git es necesario para validar su configuración pública"
    return 1
  }
  [[ -f "$config_path" ]] || {
    error "falta la configuración Git pública: $config_path"
    return 1
  }
  git config --file "$config_path" --list --name-only >/dev/null || {
    error "configuración Git pública inválida: $config_path"
    return 1
  }
  [[ $(git config --file "$config_path" --get user.useConfigOnly || true) == true ]] || {
    error "Git público debe usar user.useConfigOnly=true para fallar sin identidad"
    return 1
  }
  for identity_key in user.name user.email user.signingKey; do
    if git config --file "$config_path" --get "$identity_key" >/dev/null 2>&1; then
      error "Git público no debe definir $identity_key"
      return 1
    fi
  done
  mapfile -t include_paths < <(
    git config --file "$config_path" --get-all include.path || true
  )
  if (( ${#include_paths[@]} != 2 )) || \
      [[ "${include_paths[0]-}" != \~/.config/git/private.gitconfig ]] || \
      [[ "${include_paths[1]-}" != \~/.config/git/local.gitconfig ]]; then
    error "los includes Git deben conservar la precedencia público → privado → local"
    return 1
  fi
  if [[ -e "$legacy_config" || -L "$legacy_config" ]]; then
    error "configuración Git legacy detectada: $legacy_config"
    error "Git la leería después de ~/.config/git/config y podría sobrescribir el contrato nuevo; respáldela y migre sus responsabilidades antes de aplicar"
    return 1
  fi
  info "Contrato Git público validado (fail-closed, sin identidad y sin ~/.gitconfig legacy)"
}

select_registered_zsh_shell() {
  local shell_path

  if command_exists chsh; then
    while read -r shell_path _; do
      [[ "${shell_path##*/}" == zsh && -x "$shell_path" ]] || continue
      printf '%s\n' "$shell_path"
      return 0
    done < <(chsh --list-shells 2>/dev/null)
  fi

  if [[ -r /etc/shells ]]; then
    while read -r shell_path _; do
      [[ "${shell_path##*/}" == zsh && -x "$shell_path" ]] || continue
      printf '%s\n' "$shell_path"
      return 0
    done < /etc/shells
  fi

  return 1
}

report_zsh_activation() {
  local account current_home login_shell passwd_entry registered_zsh_shell
  local target_home

  (( STOW_ENABLED == 1 )) || return 0
  command_exists zsh || return 0

  current_home=$(realpath -m -- "$HOME")
  target_home=$(realpath -m -- "$TARGET_DIR")
  [[ "$target_home" == "$current_home" ]] || return 0

  account=${USER-}
  [[ -n "$account" ]] || account=$(id -un 2>/dev/null || true)
  [[ -n "$account" ]] || return 0

  if command_exists getent; then
    passwd_entry=$(getent passwd "$account" 2>/dev/null || true)
    [[ -n "$passwd_entry" ]] && login_shell=${passwd_entry##*:}
  fi
  login_shell=${login_shell:-${SHELL-}}

  if [[ "${login_shell##*/}" != zsh ]]; then
    warn "Zsh está instalado, pero el shell de login de '$account' es '${login_shell:-desconocido}'; Bash no carga los plugins de .zshrc"
    if registered_zsh_shell=$(select_registered_zsh_shell); then
      warn "prueba inmediata: exec zsh; cambio persistente: chsh -s $registered_zsh_shell (después cierre por completo la sesión)"
    else
      warn "no se encontró una ruta ejecutable de Zsh registrada por chsh; revise 'chsh --list-shells' antes de cambiar la cuenta"
    fi
  elif [[ "${SHELL##*/}" != zsh ]]; then
    warn "el shell de login ya es Zsh, pero esta sesión conserva SHELL='${SHELL:-desconocido}'; cierre la sesión y vuelva a entrar"
  else
    info "Shell de login Zsh validado: $login_shell"
  fi
}

validate_alacritty_syntax() {
  local config_path="$STOW_DIR/alacritty/.config/alacritty/alacritty.toml"

  [[ "$PROFILE" == desktop ]] || return 0
  [[ -f "$config_path" ]] || {
    error "falta la configuración de Alacritty: $config_path"
    return 1
  }
  command_exists alacritty || return 0

  if ! alacritty migrate --dry-run --skip-imports \
      --config-file "$config_path" >/dev/null; then
    error "configuración de Alacritty inválida: $config_path"
    return 1
  fi
  info "Configuración de Alacritty validada"
}

target_is_current_home() {
  local current_home target_home

  current_home=$(realpath -m -- "$HOME")
  target_home=$(realpath -m -- "$TARGET_DIR")
  [[ "$target_home" == "$current_home" ]]
}

apply_session_preferences() {
  local preferences="$TARGET_DIR/.local/lib/dotfiles/session-preferences"

  [[ "$PROFILE" == desktop ]] || return 0
  (( STOW_ENABLED == 1 )) || return 0
  if ! target_is_current_home; then
    info "Preferencias de sesión omitidas: el target no es el home actual"
    return 0
  fi
  if [[ ! -x "$preferences" ]]; then
    warn "no se encontró el entrypoint de preferencias: $preferences"
    return 0
  fi
  if ! "$preferences" apply; then
    warn "no se pudo aplicar prefer-dark durante el bootstrap; MangoWM volverá a intentarlo al iniciar sesión"
    return 0
  fi
  info "Preferencia GTK validada: prefer-dark"
}

validate_session_preferences() {
  local preferences="$TARGET_DIR/.local/lib/dotfiles/session-preferences"

  [[ "$PROFILE" == desktop ]] || return 0
  (( STOW_ENABLED == 1 )) || return 0
  target_is_current_home || return 0
  [[ -x "$preferences" ]] || {
    error "falta el entrypoint de preferencias: $preferences"
    return 1
  }
  if ! "$preferences" check >/dev/null; then
    error "la preferencia GTK oscura no está aplicada; ejecute '$preferences apply'"
    return 1
  fi
  info "Preferencia GTK validada: prefer-dark"
}

link_cli_command() {
  (( STOW_ENABLED == 1 )) || return 0
  local target_bin="$TARGET_DIR/.local/bin"
  local bin_link="$target_bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  mkdir -p -- "$target_bin" 2>/dev/null || return 0

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      info "Comando dotfiles ya enlazado en $bin_link"
    else
      ln -sfn -- "$script_source" "$bin_link"
      info "Comando dotfiles actualizado en $bin_link"
    fi
  elif [[ -e "$bin_link" ]]; then
    warn "$bin_link ya existe y no es un enlace simbólico. No se sobrescribirá."
  else
    ln -sfn -- "$script_source" "$bin_link"
    info "Comando dotfiles enlazado en $bin_link"
  fi
}

unlink_cli_command() {
  local bin_link="$TARGET_DIR/.local/bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      rm -f -- "$bin_link"
      info "Enlace del comando dotfiles retirado: $bin_link"
    else
      warn "$bin_link enlaza a $current_target (ajeno a este repositorio). Omitiendo."
    fi
  fi
}

validate_cli_command() {
  (( STOW_ENABLED == 1 )) || return 0
  local bin_link="$TARGET_DIR/.local/bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      info "Comando CLI validado: $bin_link"
      return 0
    else
      warn "$bin_link enlaza a $current_target en lugar de $script_source"
      return 0
    fi
  fi
  return 0
}

preflight() {
  command_exists find || die "falta el comando requerido: find"
  command_exists realpath || die "falta el comando requerido: realpath"

  if (( SYSTEM_ENABLED == 1 )); then
    [[ -d "$PACKAGES_DIR" ]] || die "no existe $PACKAGES_DIR"
    command_exists pacman || die "pacman es necesario para resolver el estado de paquetes"
  fi

  if (( STOW_ENABLED == 1 )); then
    [[ -f "$STOW_DIR/.stow" ]] || die "falta el marcador $STOW_DIR/.stow"
    TARGET_DIR=$(realpath -m -- "$TARGET_DIR")
    [[ -d "$TARGET_DIR" ]] || die "el target no es un directorio existente: $TARGET_DIR"
    [[ "$TARGET_DIR" != "/" ]] || die "se rechaza usar / como target de Stow"
    if (( APPLY == 1 )); then
      [[ -w "$TARGET_DIR" ]] || die "el target no es escribible: $TARGET_DIR"
      if (( EUID == 0 )) && [[ -n "${SUDO_USER-}" ]]; then
        die "no ejecute el bootstrap completo con sudo; el script eleva sólo el package manager"
      fi
    fi
  fi
}

prepare() {
  validate_features
  preflight

  if (( SYSTEM_ENABLED == 1 )); then
    detect_platform
    resolve_system_packages
    detect_backend
    classify_packages
  fi
  if (( STOW_ENABLED == 1 )); then
    resolve_stow_packages
  fi
}

print_plan() {
  local execution_mode

  if [[ "$COMMAND" == "doctor" ]]; then
    execution_mode="read-only"
  elif [[ "$APPLY" == 1 ]]; then
    execution_mode="apply"
  else
    execution_mode="dry-run"
  fi

  info "Plan del repositorio base"
  printf '  %-24s %s\n' 'Comando:' "$COMMAND"
  printf '  %-24s %s\n' 'Modo:' "$execution_mode"
  printf '  %-24s %s\n' 'Perfil:' "$PROFILE"
  print_array "Features" FEATURES

  if (( ${#WMS[@]} > 1 )); then
    printf '  %-24s %s\n' 'WMs opcionales:' "${WMS[*]}"
    local current_wm
    for current_wm in "${WMS[@]}"; do
      printf '  %-24s %s\n' "  Checkout $current_wm:" "${WM_PATHS[$current_wm]:-desconocido}"
    done
    print_array "Features MangoWM" WM_FEATURES
  elif [[ -n "$WM" ]]; then
    printf '  %-24s %s\n' 'WM opcional:' "$WM"
    printf '  %-24s %s\n' 'Checkout WM:' "$WM_PATH"
    printf '  %-24s %s\n' 'Perfil WM:' "$WM_PROFILE"
    print_array "Features WM" WM_FEATURES
  fi

  if (( WALLPAPERS == 1 )); then
    printf '  %-24s %s\n' 'Wallpapers:' "$WALLPAPERS_PATH"
  fi

  if (( PRIVATE == 1 )); then
    printf '  %-24s %s\n' 'Capa privada:' "$PRIVATE_PATH"
    printf '  %-24s %s\n' 'Perfil privado:' "$PRIVATE_PROFILE"
    print_array "Trabajo privado" PRIVATE_WORK
  fi

  if (( SYSTEM_ENABLED == 1 )); then
    printf '  %-24s %s\n' 'Plataforma:' "$PLATFORM"
    printf '  %-24s %s\n' 'Backend:' "$BACKEND"
    print_array "Paquetes repo" REPO_PACKAGES
    print_array "Paquetes AUR" AUR_PACKAGES
    print_array "Paquetes externos" EXTERNAL_PACKAGES
    print_array "Repo faltantes" MISSING_REPO_PACKAGES
    print_array "AUR faltantes" MISSING_AUR_PACKAGES
  fi
  if (( STOW_ENABLED == 1 )); then
    printf '  %-24s %s\n' 'Target:' "$TARGET_DIR"
    print_array "Paquetes Stow" STOW_PACKAGES
  fi
}

bootstrap() {
  local plan_valid=1

  prepare
  print_plan

  if (( SYSTEM_ENABLED == 1 )); then
    show_package_commands || plan_valid=0
    validate_package_plan || plan_valid=0
  fi

  if (( STOW_ENABLED == 1 )); then
    validate_git_contract || plan_valid=0
    ensure_no_link_collisions || plan_valid=0
    if command_exists stow; then
      info "Simulación nativa de GNU Stow"
      run_stow install 1 || plan_valid=0
    elif (( SYSTEM_ENABLED == 1 )) && array_contains MISSING_REPO_PACKAGES stow; then
      warn "Stow aún no está instalado; el preflight interno pasó y el perfil lo instalará antes de enlazar"
    else
      error "GNU Stow no está instalado"
      plan_valid=0
    fi
  fi

  (( plan_valid == 1 )) || die "el preflight falló; no se modificó nada"

  if (( APPLY == 0 )); then
    info "Dry-run completado; vuelva a ejecutar con --apply para aplicar este plan"
    return 0
  fi

  if (( SYSTEM_ENABLED == 1 )); then
    execute_package_install || die "falló la instalación o su validación"
  fi

  if (( STOW_ENABLED == 1 )); then
    command_exists stow || die "GNU Stow no quedó disponible después de instalar paquetes"
    ensure_no_link_collisions || die "apareció una colisión antes de enlazar"
    info "Última simulación de GNU Stow antes de aplicar"
    run_stow install 1 || die "la simulación de GNU Stow falló"
    info "Aplicando enlaces GNU Stow"
    run_stow install 0 || die "GNU Stow no pudo crear los enlaces"
    validate_links_installed || die "falló la validación posterior de enlaces"
    apply_session_preferences
    link_cli_command
  fi

  if (( SYSTEM_ENABLED == 1 )); then
    validate_zsh_syntax || die "falló la validación de configuración"
    validate_alacritty_syntax || die "falló la validación de configuración"
  fi
  report_zsh_activation
  info "Bootstrap completado"
}

doctor() {
  local result=0

  prepare
  print_plan

  if (( SYSTEM_ENABLED == 1 )); then
    if (( ${#MISSING_REPO_PACKAGES[@]} > 0 || ${#MISSING_AUR_PACKAGES[@]} > 0 )); then
      error "faltan paquetes del perfil"
      result=1
    else
      info "Paquetes validados: ${#REPO_PACKAGES[@]} de repo y ${#AUR_PACKAGES[@]} de AUR"
    fi
    validate_package_plan || result=1
    validate_zsh_syntax || result=1
    validate_alacritty_syntax || result=1
  fi

  if (( STOW_ENABLED == 1 )); then
    validate_git_contract || result=1
    if ! command_exists stow; then
      error "GNU Stow no está instalado"
      result=1
    fi
    validate_links_installed || result=1
    validate_session_preferences || result=1
    validate_cli_command || result=1
  fi

  report_zsh_activation

  if (( result == 0 )); then
    info "Doctor: todo correcto para el alcance seleccionado"
  else
    error "Doctor: se encontraron problemas"
  fi
  return "$result"
}

unlink_dotfiles() {
  prepare
  print_plan

  command_exists stow || die "GNU Stow es necesario para retirar enlaces"
  info "Simulación de unlink con GNU Stow"
  run_stow delete 1 || die "la simulación de unlink falló; no se modificó nada"

  if (( APPLY == 0 )); then
    info "Dry-run completado; vuelva a ejecutar con --apply para retirar los enlaces"
    return 0
  fi

  info "Retirando enlaces GNU Stow; no se eliminarán paquetes ni archivos ajenos"
  run_stow delete 0 || die "GNU Stow no pudo retirar los enlaces"
  validate_links_unlinked || die "falló la validación posterior de unlink"
  unlink_cli_command
  info "Unlink completado"
}

bootstrap_with_optional_components() {
  if (( ${#WMS[@]} > 0 )) && [[ "$APPLY" == 1 ]]; then
    info "Preflight del WM antes de modificar la base"
    run_wm_operation bootstrap 0 || die "falló el preflight del repositorio $WM; no se modificó la base"
  elif [[ -n "$WM" && "$APPLY" == 1 ]]; then
    info "Preflight del WM antes de modificar la base"
    run_wm_operation bootstrap 0 || die "falló el preflight del repositorio $WM; no se modificó la base"
  fi

  if (( PRIVATE == 1 && APPLY == 1 )); then
    info "Preflight de la capa privada antes de modificar la base"
    run_private_operation bootstrap 0 || die "falló el preflight de la capa privada; no se modificó la base"
  fi

  bootstrap
  run_wm_operation bootstrap "$APPLY" || die "falló el bootstrap del repositorio $WM"
  run_wallpapers_operation bootstrap "$APPLY" || die "falló la vinculación del repositorio de wallpapers"
  run_private_operation bootstrap "$APPLY" || die "falló el bootstrap de la capa privada"
}

doctor_with_optional_components() {
  local result=0

  if ! doctor; then
    result=1
  fi
  if ! run_wm_operation doctor 0; then
    error "Doctor: falló la validación del repositorio $WM"
    result=1
  fi
  if ! run_wallpapers_operation doctor 0; then
    error "Doctor: falló la validación del repositorio de wallpapers"
    result=1
  fi
  if ! run_private_operation doctor 0; then
    error "Doctor: falló la validación de la capa privada"
    result=1
  fi
  return "$result"
}

unlink_with_optional_components() {
  if (( ${#WMS[@]} > 0 )) && [[ "$APPLY" == 1 ]]; then
    info "Preflight de unlink del WM antes de modificar la base"
    run_wm_operation unlink 0 || die "falló el preflight de unlink del repositorio $WM; no se modificó la base"
  elif [[ -n "$WM" && "$APPLY" == 1 ]]; then
    info "Preflight de unlink del WM antes de modificar la base"
    run_wm_operation unlink 0 || die "falló el preflight de unlink del repositorio $WM; no se modificó la base"
  fi

  if (( PRIVATE == 1 && APPLY == 1 )); then
    info "Preflight de unlink de la capa privada antes de modificar la base"
    run_private_operation unlink 0 || die "falló el preflight de unlink de la capa privada; no se modificó la base"
  fi

  unlink_dotfiles
  run_wm_operation unlink "$APPLY" || die "falló el unlink del repositorio $WM"
  run_wallpapers_operation unlink "$APPLY" || die "falló el unlink del repositorio de wallpapers"
  run_private_operation unlink "$APPLY" || die "falló el unlink de la capa privada"
}

sync_environment() {
  info "Iniciando re-sincronización local del entorno..."

  if (( ${#WMS[@]} == 0 )); then
    if [[ -d "$TARGET_DIR/.dotfiles/wm/mangowm" || -d "$REPO_ROOT/../wm/mangowm" ]]; then
      append_unique WMS "mangowm"
    fi
    if [[ -d "$TARGET_DIR/.dotfiles/wm/bspwm" || -d "$REPO_ROOT/../wm/bspwm" ]]; then
      append_unique WMS "bspwm"
    fi
  fi
  if (( WALLPAPERS == 0 )); then
    if [[ -d "$TARGET_DIR/.dotfiles/walls" || -d "$REPO_ROOT/../walls" ]]; then
      WALLPAPERS=1
    fi
  fi
  if (( PRIVATE == 0 )); then
    if [[ -d "$TARGET_DIR/.dotfiles/private" || -d "$REPO_ROOT/../private" ]]; then
      PRIVATE=1
    fi
  fi

  validate_wm_checkout
  validate_wallpapers_checkout
  validate_private_checkout

  APPLY=1
  bootstrap_with_optional_components
  info "Re-sincronización local completada exitosamente."
}

update_from_remote() {
  info "Comprobando repositorios locales en $HOME/.dotfiles/..."
  command_exists git || die "git es necesario para actualizar desde repositorios remotos"

  local -a repos_to_update=()
  repos_to_update+=("$REPO_ROOT")

  local candidate
  for candidate in \
    "$REPO_ROOT/../wm/mangowm" "$TARGET_DIR/.dotfiles/wm/mangowm" \
    "$REPO_ROOT/../wm/bspwm" "$TARGET_DIR/.dotfiles/wm/bspwm" \
    "$REPO_ROOT/../walls" "$TARGET_DIR/.dotfiles/walls" \
    "$REPO_ROOT/../private" "$TARGET_DIR/.dotfiles/private"; do
    if [[ -d "$candidate/.git" ]]; then
      local real_cand
      real_cand=$(realpath -m "$candidate")
      append_unique repos_to_update "$real_cand"
    fi
  done

  local repo
  for repo in "${repos_to_update[@]}"; do
    local repo_name=${repo##*/}
    info "Verificando estado de Git en $repo_name ($repo)..."
    local git_status
    git_status=$(git -C "$repo" status --porcelain 2>/dev/null || true)
    if [[ -n "$git_status" ]]; then
      warn "El repositorio $repo_name tiene cambios locales sin confirmar; omitiendo git pull para proteger su trabajo"
    else
      info "Descargando actualizaciones en $repo_name..."
      if ! git -C "$repo" pull --ff-only; then
        warn "No se pudo realizar fast-forward en $repo_name; omitiendo"
      fi
    fi
  done

  info "Aplicando re-sincronización local tras la actualización remota..."
  sync_environment
}

wizard_colors() {
  if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && (( $(tput colors 2>/dev/null || echo 0) >= 8 )); then
    C_RESET='\033[0m'
    C_BOLD='\033[1m'
    C_DIM='\033[2m'
    C_PINK='\033[38;2;245;194;231m'
    C_MAUVE='\033[38;2;203;166;247m'
    C_BLUE='\033[38;2;137;180;250m'
    C_GREEN='\033[38;2;166;227;161m'
    C_YELLOW='\033[38;2;249;226;175m'
    C_RED='\033[38;2;243;139;168m'
    C_SUBTEXT='\033[38;2;166;173;200m'
  else
    C_RESET='' C_BOLD='' C_DIM='' C_PINK='' C_MAUVE='' C_BLUE=''
    C_GREEN='' C_YELLOW='' C_RED='' C_SUBTEXT=''
  fi
}

prompt_choice() {
  local var_name=$1
  local title=$2
  shift 2
  local -a options=("$@")
  local choice=""

  printf '\n%b%s%b\n' "${C_BOLD}${C_MAUVE}" "$title" "$C_RESET"
  local i=1
  for opt in "${options[@]}"; do
    printf '  %b[%d]%b %s\n' "$C_PINK" "$i" "$C_RESET" "$opt"
    (( i++ ))
  done

  while true; do
    printf '%bSelecciona una opción (1-%d): %b' "$C_BLUE" "${#options[@]}" "$C_RESET"
    read -r choice || return 1
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#options[@]} )); then
      printf -v "$var_name" '%d' "$(( choice - 1 ))"
      return 0
    fi
    printf '%bOpción inválida. Intenta nuevamente.%b\n' "$C_RED" "$C_RESET"
  done
}

prompt_yes_no() {
  local question=$1
  local default_val=${2:-Y}
  local response=""
  local prompt_suffix="[S/n]"
  [[ "$default_val" =~ ^[Nn]$ ]] && prompt_suffix="[s/N]"

  while true; do
    printf '%b%s %b%s%b ' "${C_BOLD}" "$question" "${C_SUBTEXT}" "$prompt_suffix" "$C_RESET"
    read -r response || return 1
    if [[ -z "$response" ]]; then
      response=$default_val
    fi
    case "$response" in
      [sS]|[yY]|[sS][iI]|[yY][eE][sS])
        return 0
        ;;
      [nN]|[nN][oO])
        return 1
        ;;
      *)
        printf '%bPor favor responde S o N.%b\n' "$C_RED" "$C_RESET"
        ;;
    esac
  done
}

prompt_input() {
  local prompt_text=$1
  local default_text=${2-}
  local var_name=$3
  local -n result_ref=$var_name
  local input_val=""

  if [[ -n "$default_text" ]]; then
    printf '%b%s %b[%s]: %b' "${C_BOLD}" "$prompt_text" "${C_SUBTEXT}" "$default_text" "$C_RESET"
  else
    printf '%b%s: %b' "${C_BOLD}" "$prompt_text" "$C_RESET"
  fi
  read -r input_val || return 1
  if [[ -z "$input_val" && -n "$default_text" ]]; then
    result_ref=$default_text
  else
    result_ref=$input_val
  fi
}

wizard_clone_if_missing() {
  local repo_name=$1
  local default_url_https=$2
  local default_url_ssh=$3
  local target_dest=$4

  if [[ -d "$target_dest" ]]; then
    return 0
  fi

  printf '\n%b%s no está presente en %s.%b\n' "$C_YELLOW" "$repo_name" "$target_dest" "$C_RESET"
  if prompt_yes_no "¿Deseas clonarlo automáticamente desde GitHub?" Y; then
    local proto_choice=0
    prompt_choice proto_choice "¿Qué protocolo deseas usar?" \
      "HTTPS (Recomendado / Sin llaves SSH previas)" \
      "SSH (Requiere claves SSH activas en GitHub)"
    local clone_url="$default_url_https"
    if (( proto_choice == 1 )); then
      clone_url="$default_url_ssh"
    fi

    info "Clonando $repo_name ($clone_url) en $target_dest..."
    mkdir -p "$(dirname "$target_dest")"
    if git clone "$clone_url" "$target_dest"; then
      info "$repo_name clonado exitosamente."
      return 0
    else
      warn "No se pudo clonar $repo_name automáticamente."
      return 1
    fi
  fi
  return 1
}

run_interactive_wizard() {
  wizard_colors

  clear 2>/dev/null || true
  printf '%b' "$C_MAUVE"
  cat <<'EOF'
╭─────────────────────────────────────────────────────────────╮
│             ANTHONY PORTUGAL — DOTFILES WIZARD              │
│       Instalación Modular y Guiada por Capas (Catppuccin)   │
╰─────────────────────────────────────────────────────────────╯
EOF
  printf '%b\n' "$C_RESET"

  printf '%bEstado actual detectado:%b\n' "${C_BOLD}" "$C_RESET"
  printf '  • Base:     %b[✓ Presente]%b (%s)\n' "$C_GREEN" "$C_RESET" "$REPO_ROOT"

  local mango_status="${C_SUBTEXT}[No presente]${C_RESET}"
  if [[ -d "$REPO_ROOT/../wm/mangowm" || -d "$TARGET_DIR/.dotfiles/wm/mangowm" ]]; then
    mango_status="${C_GREEN}[✓ Presente]${C_RESET}"
  fi
  printf '  • MangoWM:  %b\n' "$mango_status"

  local bspwm_status="${C_SUBTEXT}[No presente]${C_RESET}"
  if [[ -d "$REPO_ROOT/../wm/bspwm" || -d "$TARGET_DIR/.dotfiles/wm/bspwm" ]]; then
    bspwm_status="${C_GREEN}[✓ Presente]${C_RESET}"
  fi
  printf '  • BSPWM:    %b\n' "$bspwm_status"

  local walls_status="${C_SUBTEXT}[No presente]${C_RESET}"
  if [[ -d "$REPO_ROOT/../walls" || -d "$TARGET_DIR/.dotfiles/walls" ]]; then
    walls_status="${C_GREEN}[✓ Presente]${C_RESET}"
  fi
  printf '  • Walls:    %b\n' "$walls_status"

  local private_status="${C_SUBTEXT}[No presente]${C_RESET}"
  if [[ -d "$REPO_ROOT/../private" || -d "$TARGET_DIR/.dotfiles/private" ]]; then
    private_status="${C_GREEN}[✓ Presente]${C_RESET}"
  fi
  printf '  • Private:  %b\n' "$private_status"

  local action_choice=0
  prompt_choice action_choice "¿Qué deseas hacer?" \
    "Asistente de Configuración (Setup Wizard por Capas)" \
    "Re-sincronizar Entorno Local (Sync enlaces y paquetes sin tocar Git)" \
    "Actualizar desde GitHub (Remote Update + Sync)" \
    "Diagnóstico de Salud (Doctor)" \
    "Retirar Enlaces (Unlink)" \
    "Salir"

  case "$action_choice" in
    1)
      sync_environment || true
      return 0
      ;;
    2)
      update_from_remote || true
      return 0
      ;;
    3)
      doctor_with_optional_components || true
      return 0
      ;;
    4)
      unlink_with_optional_components || true
      return 0
      ;;
    5)
      info "Hasta luego."
      return 0
      ;;
  esac

  printf '\n%b=== ASISTENTE DE CONFIGURACIÓN POR CAPAS ===%b\n' "${C_BOLD}${C_PINK}" "$C_RESET"

  local profile_choice=2
  prompt_choice profile_choice "Paso 1: Selecciona el Perfil Base del Sistema" \
    "Core (Zsh, Git, herramientas esenciales de terminal)" \
    "CLI (Core + Micro, Yazi, Neovim/herramientas modernas)" \
    "Desktop [Recomendado] (CLI + Tema GTK Catppuccin, fuentes, audio, portales XDG)"
  case "$profile_choice" in
    0) PROFILE="core" ;;
    1) PROFILE="cli" ;;
    2) PROFILE="desktop" ;;
  esac

  WMS=()
  local wm_choice=0
  prompt_choice wm_choice "Paso 2: Selecciona los Entornos de Ventana a configurar" \
    "MangoWM (Wayland moderno + Waybar + Fuzzel + Mako)" \
    "BSPWM (X11 clásico + Polybar + Rofi + Dunst + Picom)" \
    "Ambos (MangoWM y BSPWM)" \
    "Ninguno (Solo terminal / Ya poseo mi propio gestor)"

  case "$wm_choice" in
    0)
      append_unique WMS "mangowm"
      ;;
    1)
      append_unique WMS "bspwm"
      ;;
    2)
      append_unique WMS "mangowm"
      append_unique WMS "bspwm"
      ;;
    3)
      ;;
  esac

  local wm
  for wm in "${WMS[@]}"; do
    local wm_target_path="$TARGET_DIR/.dotfiles/wm/$wm"
    case "$wm" in
      mangowm)
        wizard_clone_if_missing "dotfiles-mangowm" \
          "https://github.com/anthonyportugal/dotfiles-mangowm.git" \
          "git@github.com:anthonyportugal/dotfiles-mangowm.git" \
          "$wm_target_path" || true
        ;;
      bspwm)
        wizard_clone_if_missing "dotfiles-bspwm" \
          "https://github.com/anthonyportugal/dotfiles-bspwm.git" \
          "git@github.com:anthonyportugal/dotfiles-bspwm.git" \
          "$wm_target_path" || true
        ;;
    esac
  done

  WM_FEATURES=()
  for wm in "${WMS[@]}"; do
    if [[ "$wm" == "mangowm" ]]; then
      printf '\n%bOpciones para MangoWM:%b\n' "${C_BOLD}" "$C_RESET"
      if prompt_yes_no "  ¿Activar grabación de pantalla (wf-recorder, menú de audio, Waybar)?" Y; then
        append_unique WM_FEATURES "recording"
      fi
      if prompt_yes_no "  ¿Activar soporte de laptop (brillo, control de batería)?" N; then
        append_unique WM_FEATURES "laptop"
      fi
    fi
  done

  WALLPAPERS=0
  printf '\n%bColección de Fondos de Pantalla:%b\n' "${C_BOLD}" "$C_RESET"
  if prompt_yes_no "¿Deseas integrar la colección de wallpapers (anthonyportugal/walls)?" Y; then
    WALLPAPERS=1
    local walls_dest="$TARGET_DIR/.dotfiles/walls"
    wizard_clone_if_missing "walls" \
      "https://github.com/anthonyportugal/walls.git" \
      "git@github.com:anthonyportugal/walls.git" \
      "$walls_dest" || true
  fi

  PRIVATE=0
  printf '\n%bCapa Privada de Configuración (Identidad, SSH, llaves):%b\n' "${C_BOLD}" "$C_RESET"
  local existing_private=""
  if [[ -d "$REPO_ROOT/../private" ]]; then
    existing_private="$REPO_ROOT/../private"
  elif [[ -d "$TARGET_DIR/.dotfiles/private" ]]; then
    existing_private="$TARGET_DIR/.dotfiles/private"
  fi

  if [[ -n "$existing_private" ]]; then
    if prompt_yes_no "Capa privada detectada en $existing_private. ¿Deseas integrarla?" Y; then
      PRIVATE=1
      PRIVATE_PATH="$existing_private"
      if prompt_yes_no "  ¿Habilitar perfil de desarrollo 'development' (PNPM, dev paths, AI codex)?" Y; then
        PRIVATE_PROFILE="development"
      else
        PRIVATE_PROFILE="core"
      fi
      if prompt_yes_no "  ¿Habilitar componente laboral (csti)?" N; then
        PRIVATE_WORK+=("csti")
      fi
    fi
  else
    printf '%bNo se detectó capa privada en ~/.dotfiles/private.%b\n' "$C_SUBTEXT" "$C_RESET"
    local custom_private_url=""
    prompt_input "Ingresa la URL del repo privado a clonar (o ENTER para omitir)" "" custom_private_url
    if [[ -n "$custom_private_url" ]]; then
      local private_dest="$TARGET_DIR/.dotfiles/private"
      info "Clonando repositorio privado en $private_dest..."
      mkdir -p "$TARGET_DIR/.dotfiles"
      if git clone "$custom_private_url" "$private_dest"; then
        PRIVATE=1
        PRIVATE_PATH="$private_dest"
        info "Repositorio privado clonado exitosamente."
      else
        warn "No se pudo clonar el repositorio privado. Continuando sin capa privada."
      fi
    else
      if prompt_yes_no "¿Deseas configurar tu identidad Git local (user.name y user.email)?" Y; then
        local git_name="" git_email=""
        prompt_input "Nombre para Git" "Anthony Portugal" git_name
        prompt_input "Email para Git" "" git_email
        if [[ -n "$git_name" && -n "$git_email" ]]; then
          mkdir -p "$TARGET_DIR/.config/git"
          git config --file "$TARGET_DIR/.config/git/local.gitconfig" user.name "$git_name"
          git config --file "$TARGET_DIR/.config/git/local.gitconfig" user.email "$git_email"
          info "Identidad Git guardada en ~/.config/git/local.gitconfig"
        fi
      fi
    fi
  fi

  local mode_choice=0
  prompt_choice mode_choice "Paso 6: Selecciona el Alcance de la Instalación" \
    "Completo: Instalar paquetes del sistema (repo/AUR) + Enlaces Stow [Recomendado]" \
    "Solo enlaces: Enlazar dotfiles con Stow (Sin tocar paquetes / Sin sudo)"
  if (( mode_choice == 1 )); then
    MODE_SELECTION="stow"
    SYSTEM_ENABLED=0
    STOW_ENABLED=1
  else
    MODE_SELECTION="both"
    SYSTEM_ENABLED=1
    STOW_ENABLED=1
  fi

  printf '\n%b' "$C_BLUE"
  cat <<EOF
╭─────────────────────────────────────────────────────────────╮
│              RESUMEN DEL PLAN DE INSTALACIÓN                │
├─────────────────────────────────────────────────────────────┤
EOF
  printf '│  • Perfil Base:       %-38s│\n' "$PROFILE"
  local wms_str="${WMS[*]:-(ninguno)}"
  printf '│  • Window Managers:   %-38s│\n' "$wms_str"
  local feat_str="${WM_FEATURES[*]:-(ninguna)}"
  printf '│  • Features WM:       %-38s│\n' "$feat_str"
  local walls_str="No"
  (( WALLPAPERS == 1 )) && walls_str="Sí (${WALLPAPERS_PATH:-~/.dotfiles/walls})"
  printf '│  • Wallpapers:        %-38s│\n' "$walls_str"
  local priv_str="No"
  (( PRIVATE == 1 )) && priv_str="Sí (${PRIVATE_PATH:-~/.dotfiles/private})"
  printf '│  • Capa Privada:      %-38s│\n' "$priv_str"
  printf '│  • Modo de Operación: %-38s│\n' "$MODE_SELECTION"
  printf '│  • Directorio Target: %-38s│\n' "$TARGET_DIR"
  cat <<'EOF'
╰─────────────────────────────────────────────────────────────╯
EOF
  printf '%b\n' "$C_RESET"

  local final_choice=0
  prompt_choice final_choice "¿Cómo deseas proceder?" \
    "Aplicar los cambios ahora mismo (--apply)" \
    "Simulación previa (Dry-Run: ver qué enlaces y paquetes se tocarían sin modificar nada)" \
    "Cancelar y salir"

  case "$final_choice" in
    0)
      APPLY=1
      ;;
    1)
      APPLY=0
      ;;
    2)
      info "Operación cancelada por el usuario."
      return 0
      ;;
  esac

  COMMAND="bootstrap"
  validate_wm_checkout
  validate_wallpapers_checkout
  validate_private_checkout
  bootstrap_with_optional_components
}

main() {
  parse_args "$@"

  case "$COMMAND" in
    setup|install)
      run_interactive_wizard
      ;;
    sync)
      sync_environment
      ;;
    update)
      update_from_remote
      ;;
    bootstrap)
      validate_wm_checkout
      validate_wallpapers_checkout
      validate_private_checkout
      bootstrap_with_optional_components
      ;;
    doctor)
      validate_wm_checkout
      validate_wallpapers_checkout
      validate_private_checkout
      doctor_with_optional_components
      ;;
    unlink)
      validate_wm_checkout
      validate_wallpapers_checkout
      validate_private_checkout
      unlink_with_optional_components
      ;;
  esac
}

main "$@"
