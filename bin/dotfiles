#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_DIR=$(cd -- "$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P)
PACKAGES_DIR="$REPO_ROOT/packages"
LAYERS_DIR="$REPO_ROOT/layers"
# A WM name is a single directory under layers/wm/, never a path.
WM_NAME_PATTERN='^[a-z0-9][a-z0-9_-]*$'
# Every layer resolves its backend with the same, root-level order.
PACKAGE_BACKENDS_FILE="$PACKAGES_DIR/package-backends.txt"

COMMAND=""
PROFILE="desktop"
PROFILE_EXPLICIT=0
BACKEND_REQUEST="auto"
SYSTEM_ARGS=()
PLATFORM_REQUEST="auto"
TARGET_DIR=${HOME:?HOME no está definida}
APPLY=0
SYSTEM_ENABLED=1
STOW_ENABLED=1
MODE_SELECTION="both"
WM=""
WM_PROFILE="desktop"
WM_PROFILE_SET=0

declare -a WMS=()
declare -A WM_PROFILES=()

WALLPAPERS=0
WALLPAPERS_PATH=""
WALLPAPERS_ENTRYPOINT=""

PRIVATE=0
PRIVATE_PATH=""
PRIVATE_PROFILE="core"
PRIVATE_PROFILE_EXPLICIT=0
PRIVATE_ENTRYPOINT=""
declare -a PRIVATE_WORK=()
PRIVATE_WORK_EXPLICIT=0

HARNESS=0
HARNESS_PATH=""
HARNESS_ENTRYPOINT=""
COMPLETION_SHELL="zsh"
BASE_ONLY=0
ALL_COMPONENTS=0
COMPONENT_EXPLICIT=0

PLATFORM=""
BACKEND=""

declare -a FEATURES=()
# Read through array_contains by name.
# shellcheck disable=SC2034
SUPPORTED_FEATURES=(yazi-extras)
declare -a REPO_PACKAGES=()
declare -a AUR_PACKAGES=()
declare -a EXTERNAL_PACKAGES=()
declare -a STOW_PACKAGES=()
declare -a INSTALLED_REPO_PACKAGES=()
declare -a INSTALLED_AUR_PACKAGES=()
declare -a MISSING_REPO_PACKAGES=()
declare -a MISSING_AUR_PACKAGES=()

declare -a LINK_MISSING=()
declare -a LINK_CONFLICTS=()
declare -a LINK_DUPLICATES=()
declare -a LINK_REPLACE=()
LINK_OK=0

# Layers of this run, each after the layers it requires (resolve_selected_layers).
declare -a SELECTED_LAYERS=()
# Base layers in cumulative order; each requires the previous one.
BASE_LAYERS=(core cli desktop)
FAILED_LAYER=""

DOTFILES_LANG="${DOTFILES_LANG:-en}"
FORCE_YES=0

LIB_DIR="$REPO_ROOT/lib"

# shellcheck source=../lib/colors.sh
source "$LIB_DIR/colors.sh"
setup_colors

# shellcheck source=../lib/core.sh
source "$LIB_DIR/core.sh"
# shellcheck source=../lib/packages.sh
source "$LIB_DIR/packages.sh"
# shellcheck source=../lib/links.sh
source "$LIB_DIR/links.sh"
# shellcheck source=../lib/receipts.sh
source "$LIB_DIR/receipts.sh"
# shellcheck source=../lib/layers.sh
source "$LIB_DIR/layers.sh"
# shellcheck source=../lib/layer_ops.sh
source "$LIB_DIR/layer_ops.sh"

# shellcheck source=../lib/completions.sh
source "$LIB_DIR/completions.sh"

# shellcheck source=../lib/wizard.sh
source "$LIB_DIR/wizard.sh"

# shellcheck source=../lib/system.sh
source "$LIB_DIR/system.sh"


# Adds a --wm value to WMS: a layer name under layers/wm/, "all"/"both" for
# every WM layer, or the "mango" alias.
add_wm_selection() {
  local requested=$1 wm_layer

  case "$requested" in
    all|both)
      for wm_layer in "$LAYERS_DIR"/wm/*/; do
        [[ -f "$wm_layer/layer.conf" ]] || continue
        wm_layer=${wm_layer%/}
        append_unique WMS "${wm_layer##*/}"
      done
      ;;
    mango)
      append_unique WMS mangowm
      ;;
    *)
      append_unique WMS "$requested"
      ;;
  esac
  WM=${WMS[0]:-}
}

usage() {
  if [[ "${DOTFILES_LANG:-en}" == "es" ]]; then
    cat <<EOF
Uso:
  $PROGRAM_NAME setup [opciones]
  $PROGRAM_NAME sync [opciones]
  $PROGRAM_NAME update [opciones]
  $PROGRAM_NAME doctor [opciones]
  $PROGRAM_NAME unlink [opciones]
  $PROGRAM_NAME system [setup|doctor] [opciones]
  $PROGRAM_NAME help

Comandos:
  setup       Asistente interactivo guiado para configurar e instalar por capas.
  sync        Re-aplica la selección guardada (perfil, WMs) sin tocar Git.
  update      Descarga actualizaciones (fast-forward) y re-aplica la selección guardada.
  doctor      Comprueba dependencias, sintaxis y enlaces sin modificar nada.
  unlink      Retira únicamente los enlaces Stow del sistema.
  system      Capa opcional de sistema (Ly, Limine, DNS-over-TLS) con sudo explícito;
              nunca la ejecutan bootstrap, sync ni update. Ver '$PROGRAM_NAME system help'.

Opciones:
  --profile core|cli|desktop       Perfil acumulativo (default: desktop).
  --lang en|es                     Idioma de la interfaz (default: en).
  --feature yazi-extras            Feature opt-in; aplica también la capa que la declara (cli).
  --backend auto|shelly|paru|yay|pacman
                                   Backend de paquetes (default: auto).
  --platform auto|cachyos|arch     Plataforma detectada u override explícito.
  --target DIR                     Home objetivo (default: \$HOME).
  --wm NOMBRE|all                  Capa de WM de layers/wm/ (bspwm, mangowm); se puede repetir.
                                   Elegir un WM aplica también el perfil desktop.
  --wm-profile core|desktop        Perfil de los WMs (default: desktop o el del recibo).
  --base-only                      Ejecuta diagnósticos únicamente para el repositorio base.
  --all                            Diagnostica o sincroniza todos los componentes disponibles.
  --agent-harness                  Integrar agent-harness (cadena de herramientas para agentes IA).
  --agent-harness-path DIR         Ruta explícita al repositorio agent-harness.
  -y, --yes                        Confirmación automática en prompts de actualización.
  -h, --help                       Muestra esta ayuda.

Ejemplos:
  $PROGRAM_NAME setup
  $PROGRAM_NAME sync
  $PROGRAM_NAME update
  $PROGRAM_NAME doctor
  $PROGRAM_NAME unlink
EOF
  else
    cat <<EOF
Usage:
  $PROGRAM_NAME setup [options]
  $PROGRAM_NAME sync [options]
  $PROGRAM_NAME update [options]
  $PROGRAM_NAME doctor [options]
  $PROGRAM_NAME unlink [options]
  $PROGRAM_NAME system [setup|doctor] [options]
  $PROGRAM_NAME help

Commands:
  setup       Interactive guided assistant to configure and install by layers.
  sync        Re-applies the saved selection (profile, WMs) without touching Git.
  update      Pulls updates (fast-forward) and re-applies the saved selection.
  doctor      Verifies dependencies, syntax, and symlinks without modifying anything.
  unlink      Removes GNU Stow symlinks from the system.
  system      Optional system layer (Ly, Limine, DNS-over-TLS) under an explicit sudo;
              bootstrap, sync and update never run it. See '$PROGRAM_NAME system help'.

Options:
  --profile core|cli|desktop       Cumulative profile (default: desktop).
  --lang en|es                     Interface language (default: en).
  --feature yazi-extras            Opt-in feature; also applies the layer declaring it (cli).
  --backend auto|shelly|paru|yay|pacman
                                   Package backend (default: auto).
  --platform auto|cachyos|arch     Detected platform or explicit override.
  --target DIR                     Target home directory (default: \$HOME).
  --wm NAME|all                    WM layer from layers/wm/ (bspwm, mangowm); repeatable.
                                   Choosing a WM also applies the desktop profile.
  --wm-profile core|desktop        WM profile (default: desktop or the saved one).
  --base-only                      Run diagnostics solely for the base repository.
  --all                            Diagnose or synchronize all available components.
  --agent-harness                  Integrate agent-harness (AI coding agents toolchain).
  --agent-harness-path DIR         Explicit path to agent-harness repository.
  -y, --yes                        Automatic yes to update prompts.
  -h, --help                       Show this help.

Examples:
  $PROGRAM_NAME setup
  $PROGRAM_NAME sync
  $PROGRAM_NAME update
  $PROGRAM_NAME doctor
  $PROGRAM_NAME unlink
EOF
  fi
}

require_option_value() {
  local option_name=$1
  local option_value=${2-}
  [[ -n "$option_value" ]] || usage_error "$option_name necesita un valor"
}

parse_args() {
  local -a args_filtered=()
  while (( $# > 0 )); do
    case "$1" in
      --lang)
        require_option_value "$1" "${2-}"
        DOTFILES_LANG=$2
        export DOTFILES_LANG
        shift 2
        ;;
      --lang=*)
        DOTFILES_LANG=${1#*=}
        require_option_value "--lang" "$DOTFILES_LANG"
        export DOTFILES_LANG
        shift
        ;;
      *)
        args_filtered+=("$1")
        shift
        ;;
    esac
  done
  if (( ${#args_filtered[@]} > 0 )); then
    set -- "${args_filtered[@]}"
  else
    set --
  fi

  if (( $# == 0 )); then
    if [[ -t 0 && -t 1 ]]; then
      COMMAND="setup"
      return 0
    fi
    usage
    exit 0
  fi

  COMMAND=$1
  shift

  case "$COMMAND" in
    bootstrap|doctor|unlink|sync|update|setup|install)
      ;;
    completion)
      COMPLETION_SHELL=${1:-zsh}
      return 0
      ;;
    system)
      # The system layer parses its own options (see lib/system.sh).
      SYSTEM_ARGS=("$@")
      return 0
      ;;
    help|-h|--help)
      usage
      exit 0
      ;;
    *)
      usage_error "$(_t "unknown command: $COMMAND" "comando desconocido: $COMMAND")"
      ;;
  esac

  while (( $# > 0 )); do
    case "$1" in
      -y|--yes)
        FORCE_YES=1
        shift
        ;;
      --profile)
        require_option_value "$1" "${2-}"
        PROFILE=$2
        PROFILE_EXPLICIT=1
        shift 2
        ;;
      --profile=*)
        PROFILE=${1#*=}
        PROFILE_EXPLICIT=1
        require_option_value "--profile" "$PROFILE"
        shift
        ;;
      --feature)
        require_option_value "$1" "${2-}"
        FEATURES+=("$2")
        shift 2
        ;;
      --feature=*)
        local feature_value=${1#*=}
        require_option_value "--feature" "$feature_value"
        FEATURES+=("$feature_value")
        shift
        ;;
      --backend)
        require_option_value "$1" "${2-}"
        BACKEND_REQUEST=$2
        shift 2
        ;;
      --backend=*)
        BACKEND_REQUEST=${1#*=}
        require_option_value "--backend" "$BACKEND_REQUEST"
        shift
        ;;
      --platform)
        require_option_value "$1" "${2-}"
        PLATFORM_REQUEST=$2
        shift 2
        ;;
      --platform=*)
        PLATFORM_REQUEST=${1#*=}
        require_option_value "--platform" "$PLATFORM_REQUEST"
        shift
        ;;
      --target)
        require_option_value "$1" "${2-}"
        TARGET_DIR=$2
        shift 2
        ;;
      --target=*)
        TARGET_DIR=${1#*=}
        require_option_value "--target" "$TARGET_DIR"
        shift
        ;;
      --packages-only)
        [[ "$MODE_SELECTION" != "stow" ]] || \
          usage_error "--packages-only y --stow-only son excluyentes"
        MODE_SELECTION="packages"
        SYSTEM_ENABLED=1
        STOW_ENABLED=0
        shift
        ;;
      --stow-only)
        [[ "$MODE_SELECTION" != "packages" ]] || \
          usage_error "--packages-only y --stow-only son excluyentes"
        MODE_SELECTION="stow"
        SYSTEM_ENABLED=0
        STOW_ENABLED=1
        shift
        ;;
      --wm)
        require_option_value "$1" "${2-}"
        WM=$2
        COMPONENT_EXPLICIT=1
        add_wm_selection "$2"
        shift 2
        ;;
      --wm=*)
        WM=${1#*=}
        require_option_value "--wm" "$WM"
        COMPONENT_EXPLICIT=1
        add_wm_selection "$WM"
        shift
        ;;
      --wm-path|--wm-path=*)
        usage_error "--wm-path ya no existe: los WMs viven en $LAYERS_DIR/wm/<nombre>; use sólo --wm <nombre>"
        ;;
      --wm-profile)
        require_option_value "$1" "${2-}"
        WM_PROFILE=$2
        WM_PROFILE_SET=1
        shift 2
        ;;
      --wm-profile=*)
        WM_PROFILE=${1#*=}
        require_option_value "--wm-profile" "$WM_PROFILE"
        WM_PROFILE_SET=1
        shift
        ;;
      --wm-feature)
        require_option_value "$1" "${2-}"
        warn "el flag --wm-feature está deprecado; las capacidades están integradas en el perfil desktop del WM"
        shift 2
        ;;
      --wm-feature=*)
        local wm_feature_value=${1#*=}
        require_option_value "--wm-feature" "$wm_feature_value"
        warn "el flag --wm-feature está deprecado; las capacidades están integradas en el perfil desktop del WM"
        shift
        ;;
      --wallpapers)
        WALLPAPERS=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --wallpapers-path)
        require_option_value "$1" "${2-}"
        WALLPAPERS_PATH=$2
        WALLPAPERS=1
        COMPONENT_EXPLICIT=1
        shift 2
        ;;
      --wallpapers-path=*)
        WALLPAPERS_PATH=${1#*=}
        require_option_value "--wallpapers-path" "$WALLPAPERS_PATH"
        WALLPAPERS=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --private)
        PRIVATE=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --private-path)
        require_option_value "$1" "${2-}"
        PRIVATE_PATH=$2
        PRIVATE=1
        COMPONENT_EXPLICIT=1
        shift 2
        ;;
      --private-path=*)
        PRIVATE_PATH=${1#*=}
        require_option_value "--private-path" "$PRIVATE_PATH"
        PRIVATE=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --private-profile)
        require_option_value "$1" "${2-}"
        PRIVATE_PROFILE=$2
        PRIVATE_PROFILE_EXPLICIT=1
        PRIVATE=1
        COMPONENT_EXPLICIT=1
        shift 2
        ;;
      --private-profile=*)
        PRIVATE_PROFILE=${1#*=}
        require_option_value "--private-profile" "$PRIVATE_PROFILE"
        PRIVATE_PROFILE_EXPLICIT=1
        PRIVATE=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --private-work)
        require_option_value "$1" "${2-}"
        PRIVATE_WORK+=("$2")
        PRIVATE_WORK_EXPLICIT=1
        PRIVATE=1
        COMPONENT_EXPLICIT=1
        shift 2
        ;;
      --private-work=*)
        local private_work_val=${1#*=}
        require_option_value "--private-work" "$private_work_val"
        PRIVATE_WORK+=("$private_work_val")
        PRIVATE_WORK_EXPLICIT=1
        PRIVATE=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --agent-harness|--harness)
        HARNESS=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --agent-harness-path|--harness-path)
        require_option_value "$1" "${2-}"
        HARNESS_PATH=$2
        HARNESS=1
        COMPONENT_EXPLICIT=1
        shift 2
        ;;
      --agent-harness-path=*|--harness-path=*)
        HARNESS_PATH=${1#*=}
        require_option_value "--agent-harness-path" "$HARNESS_PATH"
        HARNESS=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --base-only)
        BASE_ONLY=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --all)
        ALL_COMPONENTS=1
        shift
        ;;
      --apply)
        APPLY=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage_error "opción desconocida: $1"
        ;;
    esac
  done

  case "$PROFILE" in
    core|cli|desktop)
      ;;
    *)
      usage_error "perfil no soportado: $PROFILE"
      ;;
  esac

  case "$BACKEND_REQUEST" in
    auto|shelly|paru|yay|pacman)
      ;;
    *)
      usage_error "backend no soportado: $BACKEND_REQUEST"
      ;;
  esac

  case "$PLATFORM_REQUEST" in
    auto|cachyos|arch)
      ;;
    *)
      usage_error "plataforma no soportada: $PLATFORM_REQUEST"
      ;;
  esac

  case "$WM_PROFILE" in
    core|desktop)
      ;;
    *)
      usage_error "perfil de WM no soportado: $WM_PROFILE"
      ;;
  esac

  if [[ "$COMMAND" =~ ^(bootstrap|unlink|doctor)$ && -z "$WM" ]]; then
    (( WM_PROFILE_SET == 0 )) || usage_error "--wm-profile requiere --wm"
  fi

  if (( BASE_ONLY == 1 && ALL_COMPONENTS == 1 )); then
    usage_error "--base-only y --all son mutuamente excluyentes"
  fi

  if (( BASE_ONLY == 1 )) && [[ "$COMMAND" != "doctor" ]]; then
    usage_error "--base-only solo está soportado para el comando doctor"
  fi

  if (( PRIVATE == 1 )); then
    case "$PRIVATE_PROFILE" in
      core|development|dev)
        [[ "$PRIVATE_PROFILE" != "dev" ]] || PRIVATE_PROFILE="development"
        ;;
      *)
        usage_error "perfil de capa privada no soportado: $PRIVATE_PROFILE"
        ;;
    esac
  else
    [[ -z "$PRIVATE_PATH" ]] || usage_error "--private-path requiere --private"
    (( ${#PRIVATE_WORK[@]} == 0 )) || usage_error "--private-work requiere --private"
  fi

  if (( HARNESS == 0 )); then
    [[ -z "$HARNESS_PATH" ]] || usage_error "--agent-harness-path requiere --agent-harness"
  fi

  if [[ "$COMMAND" == "doctor" && "$APPLY" == 1 ]]; then
    usage_error "doctor siempre es read-only y no acepta --apply"
  fi

  if [[ "$COMMAND" == "unlink" ]]; then
    [[ "$MODE_SELECTION" != "packages" ]] || \
      usage_error "unlink sólo gestiona enlaces y no acepta --packages-only"
    SYSTEM_ENABLED=0
    STOW_ENABLED=1
  fi
}

validate_features() {
  local feature
  local -a unique_features=()

  for feature in "${FEATURES[@]}"; do
    array_contains SUPPORTED_FEATURES "$feature" || usage_error "feature no soportado: $feature"
    append_unique unique_features "$feature"
  done
  FEATURES=("${unique_features[@]}")
}



detect_active_environment() {
  # Every WM layer ships with the repository, so only what is installed counts.
  if (( ${#WMS[@]} == 0 )); then
    if [[ -L "$TARGET_DIR/.config/mango/config.conf" || -f "$(receipt_path mangowm)" ]]; then
      append_unique WMS "mangowm"
    fi
    if [[ -L "$TARGET_DIR/.config/bspwm/bspwmrc" || -f "$(receipt_path bspwm)" ]]; then
      append_unique WMS "bspwm"
    fi
  fi

  if (( WALLPAPERS == 0 )); then
    if [[ -L "$TARGET_DIR/.local/share/wallpapers" || -L "$TARGET_DIR/Pictures/Wallpapers" || "$COMMAND" == "sync" ]]; then
      if [[ -d "$TARGET_DIR/.dotfiles/walls" || -d "$REPO_ROOT/../walls" ]]; then
        WALLPAPERS=1
      fi
    fi
  fi

  if (( PRIVATE == 0 )); then
    if [[ -f "$TARGET_DIR/.local/state/dotfiles/private.receipt" || "$COMMAND" == "sync" ]]; then
      if [[ -d "$TARGET_DIR/.dotfiles/private" || -d "$REPO_ROOT/../private" ]]; then
        PRIVATE=1
      fi
    fi
  fi

  if (( HARNESS == 0 )); then
    if [[ -f "$TARGET_DIR/.local/state/dotfiles/agent-harness.receipt" || "$COMMAND" == "sync" ]]; then
      if [[ -d "$TARGET_DIR/.dotfiles/agent-harness" || -d "$REPO_ROOT/../agent-harness" ]]; then
        HARNESS=1
      fi
    fi
  fi
}

detect_all_environment() {
  local wm_layer
  for wm_layer in "$LAYERS_DIR"/wm/*/; do
    [[ -f "$wm_layer/layer.conf" ]] || continue
    wm_layer=${wm_layer%/}
    append_unique WMS "${wm_layer##*/}"
  done
  if [[ -d "$TARGET_DIR/.dotfiles/walls" || -d "$REPO_ROOT/../walls" ]]; then
    WALLPAPERS=1
  fi
  if [[ -d "$TARGET_DIR/.dotfiles/private" || -d "$REPO_ROOT/../private" ]]; then
    PRIVATE=1
  fi
  if [[ -d "$TARGET_DIR/.dotfiles/agent-harness" || -d "$REPO_ROOT/../agent-harness" ]]; then
    HARNESS=1
  fi
}

resolve_wm_layers() {
  local current_wm

  if (( ${#WMS[@]} == 0 )) && [[ -n "$WM" ]]; then
    WMS+=("$WM")
  fi
  (( ${#WMS[@]} > 0 )) || return 0

  for current_wm in "${WMS[@]}"; do
    [[ "$current_wm" =~ $WM_NAME_PATTERN ]] || die "nombre de WM inválido: $current_wm"
    [[ -f "$LAYERS_DIR/wm/$current_wm/layer.conf" ]] || \
      die "entorno de ventanas no soportado: $current_wm (no existe $LAYERS_DIR/wm/$current_wm/layer.conf)"

    if (( WM_PROFILE_SET == 0 )) && [[ -z "${WM_PROFILES[$current_wm]:-}" ]]; then
      local -A wm_receipt=()
      if read_receipt "$current_wm" wm_receipt; then
        local saved_wm_profile=${wm_receipt[PROFILE]:-}
        if [[ "$saved_wm_profile" == "core" || "$saved_wm_profile" == "desktop" ]]; then
          WM_PROFILES["$current_wm"]="$saved_wm_profile"
        fi
      fi
    fi
  done

  WM="${WMS[0]}"
}


validate_wallpapers_checkout() {
  local base_root walls_root

  (( WALLPAPERS == 1 )) || return 0
  command_exists realpath || die "falta el comando requerido: realpath"

  if [[ -z "$WALLPAPERS_PATH" ]]; then
    if [[ -d "$TARGET_DIR/.dotfiles/walls" ]]; then
      WALLPAPERS_PATH="$TARGET_DIR/.dotfiles/walls"
    elif [[ -d "$REPO_ROOT/../walls" ]]; then
      WALLPAPERS_PATH="$REPO_ROOT/../walls"
    elif [[ -L "$TARGET_DIR/.local/share/wallpapers" ]]; then
      local link_dest
      link_dest=$(readlink -f "$TARGET_DIR/.local/share/wallpapers" || true)
      if [[ -f "$link_dest/bin/walls" ]]; then
        WALLPAPERS_PATH=$link_dest
      elif [[ -f "${link_dest%/*}/bin/walls" ]]; then
        WALLPAPERS_PATH=${link_dest%/*}
      fi
    elif [[ -L "$TARGET_DIR/Pictures/Wallpapers" ]]; then
      local link_dest
      link_dest=$(readlink -f "$TARGET_DIR/Pictures/Wallpapers" || true)
      if [[ -f "$link_dest/bin/walls" ]]; then
        WALLPAPERS_PATH=$link_dest
      elif [[ -f "${link_dest%/*}/bin/walls" ]]; then
        WALLPAPERS_PATH=${link_dest%/*}
      fi
    fi
  fi

  [[ -n "$WALLPAPERS_PATH" ]] || die "--wallpapers requiere un checkout disponible o la opción --wallpapers-path DIR"

  base_root=$(realpath -m -- "$REPO_ROOT")
  walls_root=$(realpath -m -- "$WALLPAPERS_PATH")
  [[ -d "$walls_root" ]] || die "el checkout de wallpapers no existe: $walls_root"
  [[ "$walls_root" != "$base_root" && "$walls_root" != "$base_root/"* ]] || \
    die "el checkout de wallpapers debe estar fuera del repositorio base: $walls_root"

  WALLPAPERS_ENTRYPOINT="$walls_root/bin/walls"
  [[ -f "$WALLPAPERS_ENTRYPOINT" && -x "$WALLPAPERS_ENTRYPOINT" ]] || \
    die "el checkout de wallpapers no expone el entrypoint ejecutable esperado: $WALLPAPERS_ENTRYPOINT"
  WALLPAPERS_PATH=$walls_root
}

run_wallpapers_operation() {
  local operation=$1
  local apply_mode=$2
  local -a walls_command=()

  (( WALLPAPERS == 1 )) || return 0

  case "$operation" in
    doctor)
      walls_command=("$WALLPAPERS_ENTRYPOINT" doctor --target "$TARGET_DIR")
      ;;
    bootstrap)
      if [[ "$apply_mode" == 1 ]]; then
        walls_command=("$WALLPAPERS_ENTRYPOINT" link --target "$TARGET_DIR")
      else
        info "Simulando enlace de wallpapers (ejecute con --apply para aplicar)"
        format_command "$WALLPAPERS_ENTRYPOINT" link --target "$TARGET_DIR"
        return 0
      fi
      ;;
    unlink)
      if [[ "$apply_mode" == 1 ]]; then
        walls_command=("$WALLPAPERS_ENTRYPOINT" unlink --target "$TARGET_DIR")
      else
        info "Simulando desvinculación de wallpapers (ejecute con --apply para aplicar)"
        format_command "$WALLPAPERS_ENTRYPOINT" unlink --target "$TARGET_DIR"
        return 0
      fi
      ;;
  esac

  info "Operando sobre repositorio de wallpapers ($WALLPAPERS_PATH)"
  format_command "${walls_command[@]}"
  "${walls_command[@]}"
}

load_private_receipt() {
  local -A private_receipt=()
  read_receipt private private_receipt || return 0

  local val=${private_receipt[PROFILE]:-}
  if (( PRIVATE_PROFILE_EXPLICIT == 0 )) && [[ "$val" == core || "$val" == development ]]; then
    PRIVATE_PROFILE="$val"
  fi

  val=${private_receipt[WORK]:-}
  if (( PRIVATE_WORK_EXPLICIT == 0 )) && [[ -n "$val" ]]; then
    local work_item
    for work_item in $val; do
      append_unique PRIVATE_WORK "$work_item"
    done
  fi
}

validate_private_checkout() {
  local base_root private_root

  (( PRIVATE == 1 )) || return 0
  command_exists realpath || die "falta el comando requerido: realpath"

  if [[ -z "$PRIVATE_PATH" ]]; then
    if [[ -d "$TARGET_DIR/.dotfiles/private" ]]; then
      PRIVATE_PATH="$TARGET_DIR/.dotfiles/private"
    elif [[ -d "$REPO_ROOT/../private" ]]; then
      PRIVATE_PATH="$REPO_ROOT/../private"
    fi
  fi

  [[ -n "$PRIVATE_PATH" ]] || die "--private requiere un checkout disponible o la opción --private-path DIR"

  base_root=$(realpath -m -- "$REPO_ROOT")
  private_root=$(realpath -m -- "$PRIVATE_PATH")
  [[ -d "$private_root" ]] || die "el checkout de la capa privada no existe: $private_root"
  [[ "$private_root" != "$base_root" && "$private_root" != "$base_root/"* ]] || \
    die "el checkout de la capa privada debe estar fuera del repositorio base: $private_root"

  PRIVATE_ENTRYPOINT="$private_root/bin/dotfiles-private"
  [[ -f "$PRIVATE_ENTRYPOINT" && -x "$PRIVATE_ENTRYPOINT" ]] || \
    die "el checkout de la capa privada no expone el entrypoint ejecutable esperado: $PRIVATE_ENTRYPOINT"
  PRIVATE_PATH=$private_root
  load_private_receipt
}

build_private_command() {
  local operation=$1
  local apply_mode=$2
  local output_name=$3
  local -n private_output_ref=$output_name

  private_output_ref=(
    "$PRIVATE_ENTRYPOINT"
    "$operation"
    "--profile=$PRIVATE_PROFILE"
    "--backend=$BACKEND_REQUEST"
    "--platform=$PLATFORM_REQUEST"
    "--target=$TARGET_DIR"
  )

  local work_item
  for work_item in "${PRIVATE_WORK[@]}"; do
    private_output_ref+=("--work=$work_item")
  done

  case "$MODE_SELECTION" in
    packages)
      private_output_ref+=(--packages-only)
      ;;
    stow)
      private_output_ref+=(--stow-only)
      ;;
  esac

  if [[ "$apply_mode" == 1 && "$operation" != doctor ]]; then
    private_output_ref+=(--apply)
  fi
}

run_private_operation() {
  local operation=$1
  local apply_mode=$2
  local -a private_command=()

  (( PRIVATE == 1 )) || return 0
  build_private_command "$operation" "$apply_mode" private_command
  info "Delegando en el repositorio privado ($PRIVATE_PATH)"
  format_command "${private_command[@]}"
  "${private_command[@]}"
}

validate_harness_checkout() {
  local base_root harness_root

  (( HARNESS == 1 )) || return 0
  command_exists realpath || die "falta el comando requerido: realpath"

  if [[ -z "$HARNESS_PATH" ]]; then
    if [[ -d "$TARGET_DIR/.dotfiles/agent-harness" ]]; then
      HARNESS_PATH="$TARGET_DIR/.dotfiles/agent-harness"
    elif [[ -d "$REPO_ROOT/../agent-harness" ]]; then
      HARNESS_PATH="$REPO_ROOT/../agent-harness"
    fi
  fi

  [[ -n "$HARNESS_PATH" ]] || die "--agent-harness requiere un checkout disponible o la opción --agent-harness-path DIR"

  base_root=$(realpath -m -- "$REPO_ROOT")
  harness_root=$(realpath -m -- "$HARNESS_PATH")
  [[ -d "$harness_root" ]] || die "el checkout de agent-harness no existe: $harness_root"
  [[ "$harness_root" != "$base_root" && "$harness_root" != "$base_root/"* ]] || \
    die "el checkout de agent-harness debe estar fuera del repositorio base: $harness_root"

  HARNESS_ENTRYPOINT="$harness_root/bin/agent-harness"
  [[ -f "$HARNESS_ENTRYPOINT" && -x "$HARNESS_ENTRYPOINT" ]] || \
    die "el checkout de agent-harness no expone el entrypoint ejecutable esperado: $HARNESS_ENTRYPOINT"
  HARNESS_PATH=$harness_root
}

run_harness_operation() {
  local operation=$1
  local apply_mode=$2
  local -a harness_command=()

  (( HARNESS == 1 )) || return 0

  case "$operation" in
    doctor)
      harness_command=("$HARNESS_ENTRYPOINT" doctor)
      ;;
    bootstrap)
      if [[ "$apply_mode" == 1 ]]; then
        harness_command=("$HARNESS_ENTRYPOINT" setup --target all)
      else
        info "$(_t "Simulating agent-harness setup (dry-run)" "Simulando configuración de agent-harness (dry-run)")"
        harness_command=("$HARNESS_ENTRYPOINT" setup --target all --dry-run)
      fi
      ;;
    unlink)
      return 0
      ;;
  esac

  info "Operando sobre repositorio agent-harness ($HARNESS_PATH)"
  format_command "${harness_command[@]}"
  "${harness_command[@]}"
}













link_cli_command() {
  (( STOW_ENABLED == 1 )) || return 0
  local target_bin="$TARGET_DIR/.local/bin"
  local bin_link="$target_bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  mkdir -p -- "$target_bin" 2>/dev/null || return 0

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      info "Comando dotfiles ya enlazado en $bin_link"
    else
      ln -sfn -- "$script_source" "$bin_link"
      info "Comando dotfiles actualizado en $bin_link"
    fi
  elif [[ -e "$bin_link" ]]; then
    warn "$bin_link ya existe y no es un enlace simbólico. No se sobrescribirá."
  else
    ln -sfn -- "$script_source" "$bin_link"
    info "Comando dotfiles enlazado en $bin_link"
  fi
}

unlink_cli_command() {
  local bin_link="$TARGET_DIR/.local/bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      rm -f -- "$bin_link"
      info "Enlace del comando dotfiles retirado: $bin_link"
    else
      warn "$bin_link enlaza a $current_target (ajeno a este repositorio). Omitiendo."
    fi
  fi
}

validate_cli_command() {
  (( STOW_ENABLED == 1 )) || return 0
  local bin_link="$TARGET_DIR/.local/bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      info "Comando CLI validado: $bin_link"
      return 0
    else
      warn "$bin_link enlaza a $current_target en lugar de $script_source"
      return 0
    fi
  fi
  return 0
}



# Resolves the layers of this run: base tiers up to PROFILE plus the WM layers,
# each after what it requires. A WM requires the desktop layer, so choosing one
# raises the recorded profile to desktop.
resolve_selected_layers() {
  local wm feature base_layer
  local -a requested=("$PROFILE")
  local -A base_conf=()

  # A selected feature pulls in the base layer that declares it.
  for feature in "${FEATURES[@]}"; do
    for base_layer in "${BASE_LAYERS[@]}"; do
      read_layer_conf "$LAYERS_DIR/$base_layer" base_conf
      [[ " ${base_conf[features]:-} " == *" $feature "* ]] || continue
      if (( $(base_layer_rank "$base_layer") > $(base_layer_rank "$PROFILE") )); then
        info "La feature $feature requiere la capa $base_layer; se aplica $base_layer en lugar de $PROFILE"
        PROFILE=$base_layer
        requested=("$PROFILE")
      fi
      break
    done
  done

  for wm in "${WMS[@]}"; do
    requested+=("wm/$wm")
  done
  SELECTED_LAYERS=()
  resolve_layers "$LAYERS_DIR" SELECTED_LAYERS "${requested[@]}"

  if [[ "$PROFILE" != desktop ]] && array_contains SELECTED_LAYERS desktop; then
    info "Los WMs requieren el perfil desktop; se aplica desktop en lugar de $PROFILE"
    PROFILE=desktop
  fi
}

# Prints the position of base layer $1 in BASE_LAYERS (core=0, cli=1, ...).
base_layer_rank() {
  local index
  for index in "${!BASE_LAYERS[@]}"; do
    [[ "${BASE_LAYERS[index]}" != "$1" ]] || { printf '%s' "$index"; return 0; }
  done
  die "capa base desconocida: $1"
}

# Prints the profile a selected layer runs with.
layer_profile() {
  case "$1" in
    wm/*) printf '%s' "${WM_PROFILES[${1#wm/}]:-$WM_PROFILE}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Prints the composite doctor label of a selected layer.
layer_label() {
  case "$1" in
    wm/*) printf 'Window Manager (%s)' "${1#wm/}" ;;
    *) printf 'Base (%s)' "$1" ;;
  esac
}

# Common start of bootstrap, doctor and unlink: validates the request,
# resolves the layers and prints the selection plan.
prepare_selection() {
  local execution_mode current_layer

  validate_features
  command_exists realpath || die "falta el comando requerido: realpath"
  TARGET_DIR=$(realpath -m -- "$TARGET_DIR")
  resolve_selected_layers

  if [[ "$COMMAND" == "doctor" ]]; then
    execution_mode="read-only"
  elif [[ "$APPLY" == 1 ]]; then
    execution_mode="apply"
  else
    execution_mode="dry-run"
  fi

  info "Plan de la selección"
  printf '  %-24s %s\n' 'Comando:' "$COMMAND"
  printf '  %-24s %s\n' 'Modo:' "$execution_mode"
  printf '  %-24s %s\n' 'Perfil:' "$PROFILE"
  print_array "Features" FEATURES
  for current_layer in "${SELECTED_LAYERS[@]}"; do
    printf '  %-24s %s\n' "Capa $current_layer:" "perfil $(layer_profile "$current_layer")"
  done
  printf '  %-24s %s\n' 'Target:' "$TARGET_DIR"

  if (( WALLPAPERS == 1 )); then
    printf '  %-24s %s\n' 'Wallpapers:' "$WALLPAPERS_PATH"
  fi

  if (( PRIVATE == 1 )); then
    printf '  %-24s %s\n' 'Capa privada:' "$PRIVATE_PATH"
    printf '  %-24s %s\n' 'Perfil privado:' "$PRIVATE_PROFILE"
    print_array "Trabajo privado" PRIVATE_WORK
  fi

  if (( HARNESS == 1 )); then
    printf '  %-24s %s\n' 'Agent Harness:' "$HARNESS_PATH"
  fi
}

# Runs operation $1 with apply mode $2 on every selected layer, in reverse
# order when $3 is "reverse". Stops at the first failing layer.
run_selected_layers() {
  local operation=$1 apply_mode=$2 order=${3:-forward}
  local -a layers=("${SELECTED_LAYERS[@]}")
  local index current_layer

  for (( index = 0; index < ${#layers[@]}; index++ )); do
    if [[ "$order" == reverse ]]; then
      current_layer=${layers[${#layers[@]} - 1 - index]}
    else
      current_layer=${layers[index]}
    fi
    if ! run_layer "$LAYERS_DIR" "$current_layer" "$operation" "$(layer_profile "$current_layer")" "$apply_mode"; then
      FAILED_LAYER=$current_layer
      return 1
    fi
  done
}




bootstrap_with_optional_components() {
  prepare_selection

  if (( APPLY == 1 )); then
    info "Preflight de todas las capas antes de modificar nada"
    run_selected_layers bootstrap 0 || \
      die "falló el preflight de la capa $FAILED_LAYER; no se modificó la base"
  fi

  if (( PRIVATE == 1 && APPLY == 1 )); then
    info "Preflight de la capa privada antes de modificar la base"
    run_private_operation bootstrap 0 || die "falló el preflight de la capa privada; no se modificó la base"
  fi

  if (( HARNESS == 1 && APPLY == 1 )); then
    info "Preflight de agent-harness antes de modificar la base"
    run_harness_operation bootstrap 0 || die "falló el preflight de agent-harness; no se modificó la base"
  fi

  run_selected_layers bootstrap "$APPLY" || die "falló el bootstrap de la capa $FAILED_LAYER"
  if (( APPLY == 1 )); then
    # Recorded as soon as the layers are on disk, so a failing optional
    # component below never leaves applied layers without a selection.
    save_selection_receipt
    (( STOW_ENABLED == 0 )) || link_cli_command
  fi
  run_wallpapers_operation bootstrap "$APPLY" || die "falló la vinculación del repositorio de wallpapers"
  run_private_operation bootstrap "$APPLY" || die "falló el bootstrap de la capa privada"
  run_harness_operation bootstrap "$APPLY" || die "falló el bootstrap de agent-harness"

  if (( APPLY == 1 )) && (( ${SYSTEM_INSTALL:-0} == 1 )) && [[ -n "${SYSTEM_PATH:-}" && -f "$SYSTEM_PATH/install.sh" ]]; then
    local -a sys_flags=()
    case "${SYSTEM_MODE:-all}" in
      ly)      sys_flags=("--ly") ;;
      limine)  sys_flags=("--limine") ;;
      dns)     sys_flags=("--dns") ;;
      ly-dns)  sys_flags=("--ly" "--dns") ;;
      *)       sys_flags=("--all") ;;
    esac
    if [[ "${SYSTEM_MODE:-all}" != "ly" && "${SYSTEM_MODE:-all}" != "limine" && -n "${SYSTEM_DNS_PROVIDER:-}" ]]; then
      sys_flags+=("--provider" "$SYSTEM_DNS_PROVIDER")
    fi
    info "Siguiente paso recomendado (Capa del Sistema):"
    info "  sudo $SYSTEM_PATH/install.sh ${sys_flags[*]} --install"
  fi
}

doctor_with_optional_components() {
  local result=0 current_layer
  local -a report_items=()

  prepare_selection
  for current_layer in "${SELECTED_LAYERS[@]}"; do
    if run_layer "$LAYERS_DIR" "$current_layer" doctor "$(layer_profile "$current_layer")" 0; then
      report_items+=("  ✓ $(layer_label "$current_layer"): OK")
    else
      report_items+=("  ✗ $(layer_label "$current_layer"): FAIL")
      error "Doctor: falló la validación de la capa $current_layer"
      result=1
    fi
  done
  if (( STOW_ENABLED == 1 )); then
    validate_cli_command || result=1
  fi

  if (( WALLPAPERS == 1 )); then
    if run_wallpapers_operation doctor 0; then
      report_items+=("  ✓ Wallpapers (walls): OK")
    else
      report_items+=("  ✗ Wallpapers (walls): FAIL")
      error "Doctor: falló la validación del repositorio de wallpapers"
      result=1
    fi
  fi

  if (( PRIVATE == 1 )); then
    if run_private_operation doctor 0; then
      report_items+=("  ✓ Private (dotfiles-private): OK")
    else
      report_items+=("  ✗ Private (dotfiles-private): FAIL")
      error "Doctor: falló la validación de la capa privada"
      result=1
    fi
  fi

  if (( HARNESS == 1 )); then
    if run_harness_operation doctor 0; then
      report_items+=("  ✓ Agent Harness (agent-harness): OK")
    else
      report_items+=("  ✗ Agent Harness (agent-harness): FAIL")
      error "Doctor: falló la validación de agent-harness"
      result=1
    fi
  fi

  printf '\n%b%s%b\n' "${C_BOLD}${C_MAUVE}" "$(_t "=== Composite Doctor Summary ===" "=== Resumen del Doctor Compuesto ===")" "$C_RESET"
  local item
  for item in "${report_items[@]}"; do
    if [[ "$item" == *"OK"* ]]; then
      printf '%b%s%b\n' "$C_GREEN" "$item" "$C_RESET"
    else
      printf '%b%s%b\n' "$C_RED" "$item" "$C_RESET"
    fi
  done
  printf '\n'

  if (( result == 0 )); then
    success "$(_t "All ${#report_items[@]} audited component(s) passed doctor checks." "Los ${#report_items[@]} componente(s) auditados pasaron el chequeo de doctor exitosamente.")"
  else
    error "$(_t "Doctor detected issues across audited components." "Doctor detectó problemas en los componentes auditados.")"
  fi
  return "$result"
}

unlink_with_optional_components() {
  prepare_selection

  if (( APPLY == 1 )); then
    info "Preflight de unlink de todas las capas antes de modificar nada"
    run_selected_layers unlink 0 reverse || \
      die "falló el preflight de unlink de la capa $FAILED_LAYER; no se modificó la base"
  fi

  if (( PRIVATE == 1 && APPLY == 1 )); then
    info "Preflight de unlink de la capa privada antes de modificar la base"
    run_private_operation unlink 0 || die "falló el preflight de unlink de la capa privada; no se modificó la base"
  fi

  run_selected_layers unlink "$APPLY" reverse || die "falló el unlink de la capa $FAILED_LAYER"
  (( APPLY == 0 )) || unlink_cli_command
  run_wallpapers_operation unlink "$APPLY" || die "falló el unlink del repositorio de wallpapers"
  run_private_operation unlink "$APPLY" || die "falló el unlink de la capa privada"
  run_harness_operation unlink "$APPLY" || die "falló el unlink de agent-harness"
  # Only once every component is gone, so a failed unlink can be retried
  # with the same saved selection.
  (( APPLY == 0 )) || rm -f -- "$(receipt_path dotfiles)"
}

# Records what this machine selected so sync/update re-apply it without flags.
save_selection_receipt() {
  write_receipt dotfiles PROFILE="$PROFILE" FEATURES="${FEATURES[*]}" WMS="${WMS[*]}" BACKEND="${BACKEND:-}"
}

# Restores the recorded selection for whatever the command line left unset.
load_selection_receipt() {
  local -A selection=()
  local entry
  local -a entries=() restored=()

  read_receipt dotfiles selection || return 0
  if (( PROFILE_EXPLICIT == 0 )); then
    case "${selection[PROFILE]:-}" in
      core|cli|desktop)
        PROFILE=${selection[PROFILE]}
        ;;
      *)
        # Never install more than this machine recorded.
        warn "perfil inválido en el recibo de selección: ${selection[PROFILE]:-vacío}; se usa core"
        PROFILE=core
        ;;
    esac
    restored+=("perfil $PROFILE")
  fi
  if (( ${#FEATURES[@]} == 0 )); then
    read -r -a entries <<< "${selection[FEATURES]:-}"
    for entry in "${entries[@]}"; do
      if array_contains SUPPORTED_FEATURES "$entry"; then
        append_unique FEATURES "$entry"
      else
        warn "se ignora una feature inválida en el recibo de selección: $entry"
      fi
    done
    (( ${#FEATURES[@]} == 0 )) || restored+=("features ${FEATURES[*]}")
  fi
  if (( ${#WMS[@]} == 0 )); then
    read -r -a entries <<< "${selection[WMS]:-}"
    for entry in "${entries[@]}"; do
      if [[ "$entry" =~ $WM_NAME_PATTERN && -f "$LAYERS_DIR/wm/$entry/layer.conf" ]]; then
        append_unique WMS "$entry"
      else
        warn "se ignora un WM inválido en el recibo de selección: $entry"
      fi
    done
    (( ${#WMS[@]} == 0 )) || restored+=("WMs ${WMS[*]}")
  fi
  restore_saved_backend "${selection[BACKEND]:-}"
  if (( ${#restored[@]} > 0 )); then
    local summary
    printf -v summary '%s, ' "${restored[@]}"
    info "Selección restaurada del recibo: ${summary%, }"
  fi
}

sync_environment() {
  info "Iniciando re-sincronización local del entorno..."
  load_selection_receipt

  if (( ALL_COMPONENTS == 1 )); then
    detect_all_environment
  else
    detect_active_environment
  fi

  resolve_wm_layers
  validate_wallpapers_checkout
  validate_private_checkout
  validate_harness_checkout

  APPLY=1
  bootstrap_with_optional_components
  success "$(_t "Local resynchronization completed successfully." "Re-sincronización local completada exitosamente.")"
}

# The system layer is never applied by update: when the pulled range changed
# it and this machine applied it before, only say how to re-apply it.
notify_system_layer_update() {
  local range=$1
  local -A saved=()

  [[ -n "$range" ]] || return 0
  read_receipt system saved || return 0
  git -C "$REPO_ROOT" diff --quiet "$range" -- layers/system && return 0
  warn "$(_t "The system layer changed; update does not apply it. Re-apply it with" "La capa system cambió; update no la aplica. Vuelva a aplicarla con"): dotfiles system setup ${saved[SYSTEM_ARGS]:-}"
}

update_from_remote() {
  info "$(_t "Checking local repositories in $TARGET_DIR/.dotfiles/..." "Comprobando repositorios locales en $TARGET_DIR/.dotfiles/...")"
  command_exists git || die "$(_t "git is required to update from remote repositories" "git es necesario para actualizar desde repositorios remotos")"

  local -a repos_to_update=()
  repos_to_update+=("$REPO_ROOT")

  local candidate
  for candidate in \
    "$REPO_ROOT/../walls" "$TARGET_DIR/.dotfiles/walls" \
    "$REPO_ROOT/../private" "$TARGET_DIR/.dotfiles/private" \
    "$REPO_ROOT/../agent-harness" "$TARGET_DIR/.dotfiles/agent-harness"; do
    if [[ -d "$candidate/.git" ]]; then
      local real_cand
      real_cand=$(realpath -m "$candidate")
      append_unique repos_to_update "$real_cand"
    fi
  done

  local -a updated_repos=()
  local repo system_range=""
  for repo in "${repos_to_update[@]}"; do
    local repo_name=${repo##*/}
    info "$(_t "Verifying Git status in" "Verificando estado de Git en") $repo_name ($repo)..."
    local git_status
    git_status=$(git -C "$repo" status --porcelain 2>/dev/null || true)
    if [[ -n "$git_status" ]]; then
      warn "$(_t "Repository $repo_name has uncommitted local changes; skipping git pull to protect your work" "El repositorio $repo_name tiene cambios locales sin confirmar; omitiendo git pull para proteger su trabajo")"
    else
      local head_before head_after pull_output
      head_before=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
      if ! pull_output=$(GIT_SSH_COMMAND="ssh -o BatchMode=yes" GIT_TERMINAL_PROMPT=0 git -C "$repo" pull --ff-only 2>&1); then
        warn "$(_t "Could not fast-forward $repo_name; skipping" "No se pudo realizar fast-forward en $repo_name; omitiendo")"
        [[ -n "$pull_output" ]] && printf '%s\n' "$pull_output"
      else
        head_after=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
        if [[ -n "$head_before" && -n "$head_after" && "$head_before" != "$head_after" ]]; then
          info "$repo_name: $(_t "updated" "actualizado") (${head_before:0:7}..${head_after:0:7})"
          updated_repos+=("$repo_name")
          [[ "$repo" != "$REPO_ROOT" ]] || system_range="$head_before..$head_after"
        else
          info "$repo_name: $(_t "already up to date" "ya está al día")"
        fi
      fi
    fi
  done

  if (( ${#updated_repos[@]} == 0 )); then
    success "$(_t "All repositories are already up to date. No synchronization needed." "Todos los repositorios ya están al día. No se requiere sincronización.")"
    return 0
  fi
  notify_system_layer_update "$system_range"

  info "$(_t "Updated repositories:" "Repositorios con novedades:") ${updated_repos[*]}"
  local do_sync=1
  if [[ -t 0 && -t 1 ]] && (( ${FORCE_YES:-0} == 0 )); then
    local question
    question=$(_t \
      "Changes were downloaded in ${#updated_repos[@]} repository(ies). Do you want to resynchronize the environment now?" \
      "Se descargaron cambios en ${#updated_repos[@]} repositorio(s). ¿Deseas re-sincronizar el entorno ahora?")
    if ! prompt_yes_no "$question" "Y"; then
      do_sync=0
    fi
  fi

  if (( do_sync == 1 )); then
    info "$(_t "Applying local resynchronization after remote update..." "Aplicando re-sincronización local tras la actualización remota...")"
    sync_environment
  else
    info "$(_t "Resynchronization skipped by user. You can run '$PROGRAM_NAME sync' whenever you want to apply it." "Re-sincronización omitida por el usuario. Puedes ejecutar '$PROGRAM_NAME sync' cuando desees aplicarla.")"
  fi
}

cmd_doctor() {
  if (( BASE_ONLY == 0 )); then
    if (( ALL_COMPONENTS == 1 )); then
      detect_all_environment
    elif (( COMPONENT_EXPLICIT == 0 )); then
      detect_active_environment
    fi
  fi

  resolve_wm_layers
  validate_wallpapers_checkout
  validate_private_checkout
  validate_harness_checkout
  doctor_with_optional_components
}

cmd_unlink() {
  unlink_with_optional_components
}

main() {
  parse_args "$@"

  case "$COMMAND" in
    setup|install)
      run_interactive_wizard
      ;;
    sync)
      sync_environment
      ;;
    update)
      update_from_remote
      ;;
    bootstrap)
      resolve_wm_layers
      validate_wallpapers_checkout
      validate_private_checkout
      validate_harness_checkout
      bootstrap_with_optional_components
      ;;
    doctor)
      cmd_doctor
      ;;
    unlink)
      resolve_wm_layers
      validate_wallpapers_checkout
      validate_private_checkout
      validate_harness_checkout
      cmd_unlink
      ;;
    completion)
      cmd_completion
      ;;
    system)
      cmd_system "${SYSTEM_ARGS[@]}"
      ;;
  esac
}

main "$@"
