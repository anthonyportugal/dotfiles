#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_DIR=$(cd -- "$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P)
PACKAGES_DIR="$REPO_ROOT/packages"
LAYERS_DIR="$REPO_ROOT/layers"
# A WM name is a single directory under layers/wm/, never a path.
WM_NAME_PATTERN='^[a-z0-9][a-z0-9_-]*$'
# Every layer resolves its backend with the same, root-level order.
PACKAGE_BACKENDS_FILE="$PACKAGES_DIR/package-backends.txt"

COMMAND=""
PROFILE="desktop"
PROFILE_EXPLICIT=0
BACKEND_REQUEST="auto"
SYSTEM_ARGS=()
PLATFORM_REQUEST="auto"
TARGET_DIR=${HOME:?HOME no está definida}
APPLY=0
SYSTEM_ENABLED=1
STOW_ENABLED=1
MODE_SELECTION="both"
WM=""
WM_PROFILE="desktop"
WM_PROFILE_SET=0

declare -a WMS=()
declare -A WM_PROFILES=()

# External components (components.conf) recorded in the target's receipt.
declare -a RECORDED_COMPONENTS=()
ADD_ARGS=()
SWITCH_ARGS=()

# Overlay: a second layers root (--overlay DIR), usually a private repository.
OVERLAY_PATH=""
OVERLAY_EXPLICIT=0
NO_OVERLAY=0
OVERLAY_READY=0
declare -a OVERLAY_LAYERS=()

COMPLETION_SHELL="zsh"
BASE_ONLY=0
ALL_COMPONENTS=0
COMPONENT_EXPLICIT=0

PLATFORM=""
BACKEND=""

declare -a FEATURES=()
# Opt-in layers chosen with --layer (or pulled in by one of their features).
declare -a OPTIONAL_LAYERS=()
# Filled by discover_layers: the opt-in layers, every declared feature and the
# layer declaring it. Read through array_contains by name.
# shellcheck disable=SC2034
declare -a SUPPORTED_LAYERS=() SUPPORTED_FEATURES=()
declare -A FEATURE_LAYERS=()
declare -a REPO_PACKAGES=()
declare -a AUR_PACKAGES=()
declare -a EXTERNAL_PACKAGES=()
declare -a STOW_PACKAGES=()
declare -a INSTALLED_REPO_PACKAGES=()
declare -a INSTALLED_AUR_PACKAGES=()
declare -a MISSING_REPO_PACKAGES=()
declare -a MISSING_AUR_PACKAGES=()

declare -a LINK_MISSING=()
declare -a LINK_CONFLICTS=()
declare -a LINK_DUPLICATES=()
declare -a LINK_REPLACE=()
LINK_OK=0

# Layers of this run, each after the layers it requires (resolve_selected_layers).
declare -a SELECTED_LAYERS=()
# Base layers in cumulative order; each requires the previous one.
BASE_LAYERS=(core cli desktop)
FAILED_LAYER=""

# What this run retires because the selection receipt recorded more than the
# run selects (compute_retired_selection). One unit per layer: its root,
# profile and recorded features; an empty package list unlinks the whole
# layer, otherwise only those Stow packages (dropped features of a kept layer).
declare -a RETIRE_ROOTS=() RETIRE_LAYERS=() RETIRE_PROFILES=() RETIRE_FEATURES=() RETIRE_PACKAGE_LISTS=()
# Names on the plan's retire line: layers, then features, then components.
declare -a RETIRE_NAMES=()
# Recorded components the wizard dropped; unlinked and forgotten on apply.
declare -a RETIRED_COMPONENTS=()

# An explicit language (DOTFILES_LANG or --lang) always wins; otherwise setup
# follows $LANG (see wizard_detect_language) and every other command uses en.
DOTFILES_LANG_EXPLICIT=0
[[ -z "${DOTFILES_LANG:-}" ]] || DOTFILES_LANG_EXPLICIT=1
DOTFILES_LANG="${DOTFILES_LANG:-en}"
FORCE_YES=0

LIB_DIR="$REPO_ROOT/lib"

# shellcheck source=../lib/colors.sh
source "$LIB_DIR/colors.sh"
setup_colors

# shellcheck source=../lib/core.sh
source "$LIB_DIR/core.sh"
# shellcheck source=../lib/packages.sh
source "$LIB_DIR/packages.sh"
# shellcheck source=../lib/links.sh
source "$LIB_DIR/links.sh"
# shellcheck source=../lib/receipts.sh
source "$LIB_DIR/receipts.sh"
# shellcheck source=../lib/external.sh
source "$LIB_DIR/external.sh"
# shellcheck source=../lib/components.sh
source "$LIB_DIR/components.sh"
# shellcheck source=../lib/layers.sh
source "$LIB_DIR/layers.sh"
# shellcheck source=../lib/layer_ops.sh
source "$LIB_DIR/layer_ops.sh"

# shellcheck source=../lib/switch.sh
source "$LIB_DIR/switch.sh"

# shellcheck source=../lib/completions.sh
source "$LIB_DIR/completions.sh"

# shellcheck source=../lib/wizard.sh
source "$LIB_DIR/wizard.sh"

# shellcheck source=../lib/system.sh
source "$LIB_DIR/system.sh"


# Adds a --wm value to WMS: a layer name under layers/wm/, "all"/"both" for
# every WM layer, or the "mango" alias.
add_wm_selection() {
  local requested=$1 wm_layer

  case "$requested" in
    all|both)
      for wm_layer in "$LAYERS_DIR"/wm/*/; do
        [[ -f "$wm_layer/layer.conf" ]] || continue
        wm_layer=${wm_layer%/}
        append_unique WMS "${wm_layer##*/}"
      done
      ;;
    mango)
      append_unique WMS mangowm
      ;;
    *)
      append_unique WMS "$requested"
      ;;
  esac
  WM=${WMS[0]:-}
}

usage() {
  if [[ "${DOTFILES_LANG:-en}" == "es" ]]; then
    cat <<EOF
Uso:
  $PROGRAM_NAME setup [opciones]
  $PROGRAM_NAME bootstrap [opciones] [--apply]
  $PROGRAM_NAME sync [opciones]
  $PROGRAM_NAME update [opciones]
  $PROGRAM_NAME doctor [opciones]
  $PROGRAM_NAME unlink [opciones]
  $PROGRAM_NAME add NOMBRE [--target DIR] [-n|--dry-run]
  $PROGRAM_NAME switch RUTA [--overlay RUTA|--no-overlay] [--from RUTA] [--with-packages] [--target DIR] [--apply]
  $PROGRAM_NAME switch --rollback [--target DIR] [--apply]
  $PROGRAM_NAME system [setup|doctor] [opciones]
  $PROGRAM_NAME completion [zsh|bash]
  $PROGRAM_NAME help

Comandos:
  setup       Asistente guiado corto: perfil (servidor o escritorio), WMs, overlay y extras;
              parte de la selección guardada (Enter la conserva) y luego muestra el plan
              y pregunta aplicar, simular (dry-run) o cancelar. Si encuentra otra
              instalación (~/.dotfiles anterior u otro checkout), ofrece antes migrarla
              con la lógica de switch.
  bootstrap   Instala la selección indicada por flags sin asistente; sin --apply solo
              muestra el plan (dry-run). Lo que la selección guardada tenía y esta no
              (capas, features, WMs, un perfil menor, el overlay) se retira: el plan lo
              lista en 'Se retiran:' y solo se quitan enlaces hacia este checkout u overlay.
  sync        Re-aplica la selección guardada (perfil, capas, WMs, componentes) sin tocar Git;
              lo que un flag descarta se retira como en bootstrap.
  update      Descarga el repositorio público y el overlay (fast-forward) y re-aplica la
              selección guardada; los componentes pasan a su nueva ref fijada.
  doctor      Comprueba dependencias, sintaxis, enlaces y componentes sin modificar nada.
  unlink      Retira los enlaces Stow y los de los componentes (conserva sus checkouts).
  add         Añade un componente externo de components.conf (p. ej. walls): lo clona en
              ~/.local/share/dotfiles/NOMBRE en su commit fijado y crea sus enlaces.
  switch      Cambia el checkout activo del target a RUTA: detecta la instalación actual
              (el ecosistema anterior de ~/.dotfiles u otro checkout del monorepo, o --from),
              traduce su selección (perfil, WMs, private al overlay, walls al componente,
              el tema, el fondo guardado, mimeapps.list) y lista lo que no migra. Sin
              --apply solo muestra el plan; con --apply comprueba colisiones antes de tocar nada, guarda un
              manifiesto en ~/.local/state/dotfiles/transactions/, retira solo los enlaces
              hacia el checkout anterior y aplica la selección con el bootstrap de RUTA (solo
              enlaces salvo --with-packages); si algo falla restaura el target tal como estaba.
              --rollback deshace el último cambio (los archivos nuevos se apartan, no se borran).
  system      Capa opcional de sistema (Ly, Limine, DNS-over-TLS) con sudo explícito;
              nunca la ejecutan bootstrap, sync ni update. Ver '$PROGRAM_NAME system help'.
  completion  Imprime el script de autocompletado para zsh (default) o bash.

Opciones:
  --profile core|cli|desktop       Perfil acumulativo (default: desktop).
  --lang en|es                     Idioma de la interfaz (default: en; setup sigue a \$LANG).
  --feature NOMBRE                 Feature opt-in (yazi-extras, dev-containers, dev-js, dev-go, dev-tauri,
                                   dev-herdr); aplica también la capa que la declara.
  --layer NOMBRE                   Capa opcional que ningún perfil incluye (dev); se puede repetir.
  --overlay RUTA                   Repositorio con layers/ propias (p. ej. ~/.dotfiles-private); cada
                                   capa se aplica sola cuando lo que requiere está elegido.
  --no-overlay                     Deja de aplicar el overlay guardado en el recibo.
  --backend auto|shelly|paru|yay|pacman
                                   Backend de paquetes (default: auto).
  --platform auto|cachyos|arch     Plataforma detectada u override explícito.
  --target DIR                     Home objetivo (default: \$HOME).
  --wm NOMBRE|all                  Capa de WM de layers/wm/ (bspwm, mangowm); se puede repetir.
                                   Elegir un WM aplica también el perfil desktop.
  --wm-profile core|desktop        Perfil de los WMs (default: desktop o el del recibo).
  --base-only                      Ejecuta diagnósticos únicamente para el repositorio base.
  --all                            Diagnostica o sincroniza todos los componentes disponibles.
  --apply                          Aplica bootstrap o unlink (sin él solo se muestra el plan).
  --stow-only | --packages-only    Solo enlaces (sin paquetes ni sudo) o solo paquetes.
  -y, --yes                        Confirmación automática en prompts de actualización.
  -h, --help                       Muestra esta ayuda.

Ejemplos:
  $PROGRAM_NAME setup
  $PROGRAM_NAME bootstrap --profile cli --layer dev --apply
  $PROGRAM_NAME sync
  $PROGRAM_NAME update
  $PROGRAM_NAME doctor
  $PROGRAM_NAME unlink
  $PROGRAM_NAME add walls
  $PROGRAM_NAME switch ~/.dotfiles --apply
EOF
  else
    cat <<EOF
Usage:
  $PROGRAM_NAME setup [options]
  $PROGRAM_NAME bootstrap [options] [--apply]
  $PROGRAM_NAME sync [options]
  $PROGRAM_NAME update [options]
  $PROGRAM_NAME doctor [options]
  $PROGRAM_NAME unlink [options]
  $PROGRAM_NAME add NAME [--target DIR] [-n|--dry-run]
  $PROGRAM_NAME switch DIR [--overlay DIR|--no-overlay] [--from DIR] [--with-packages] [--target DIR] [--apply]
  $PROGRAM_NAME switch --rollback [--target DIR] [--apply]
  $PROGRAM_NAME system [setup|doctor] [options]
  $PROGRAM_NAME completion [zsh|bash]
  $PROGRAM_NAME help

Commands:
  setup       Short guided setup: profile (server or desktop), WMs, overlay and extras;
              starts from the saved selection (Enter keeps it), then shows the plan
              and asks to apply, dry-run or cancel. When it finds another install
              (the old ~/.dotfiles or another checkout), it first offers to migrate
              it with the switch logic.
  bootstrap   Installs the selection given by flags without the wizard; without --apply
              it only prints the plan (dry-run). What the saved selection had and this
              one drops (layers, features, WMs, a lower profile, the overlay) is retired:
              the plan lists it under 'Retiring:' and only links into this checkout or
              overlay are removed.
  sync        Re-applies the saved selection (profile, layers, WMs, components) without touching Git;
              what a flag drops is retired as with bootstrap.
  update      Pulls the public repository and the overlay (fast-forward) and re-applies the
              saved selection; components move to their newly pinned ref.
  doctor      Verifies dependencies, syntax, symlinks, and components without modifying anything.
  unlink      Removes GNU Stow symlinks and component links (component checkouts are kept).
  add         Adds an external component from components.conf (e.g. walls): clones it into
              ~/.local/share/dotfiles/NAME at its pinned commit and creates its links.
  switch      Makes DIR the target's active checkout: detects the current install (the
              previous ~/.dotfiles ecosystem or another monorepo checkout, or --from),
              translates its selection (profile, WMs, private to the overlay, walls to the
              component, the theme, the saved wallpaper, mimeapps.list) and lists what does
              not migrate. Without --apply it only prints the plan; with --apply it checks
              collisions before touching anything, saves a manifest under
              ~/.local/state/dotfiles/transactions/,
              removes only the links into the previous checkout and applies the selection with
              DIR's bootstrap (links only unless --with-packages); when anything fails the
              target is restored as it was. --rollback undoes the last switch (files that
              appeared since are set aside, never deleted).
  system      Optional system layer (Ly, Limine, DNS-over-TLS) under an explicit sudo;
              bootstrap, sync and update never run it. See '$PROGRAM_NAME system help'.
  completion  Prints the shell completion script for zsh (default) or bash.

Options:
  --profile core|cli|desktop       Cumulative profile (default: desktop).
  --lang en|es                     Interface language (default: en; setup follows \$LANG).
  --feature NAME                   Opt-in feature (yazi-extras, dev-containers, dev-js, dev-go, dev-tauri,
                                   dev-herdr); also applies the layer declaring it.
  --layer NAME                     Opt-in layer no profile includes (dev); repeatable.
  --overlay DIR                    Repository with its own layers/ (e.g. ~/.dotfiles-private); each
                                   layer applies on its own once what it requires is selected.
  --no-overlay                     Stop applying the overlay saved in the receipt.
  --backend auto|shelly|paru|yay|pacman
                                   Package backend (default: auto).
  --platform auto|cachyos|arch     Detected platform or explicit override.
  --target DIR                     Target home directory (default: \$HOME).
  --wm NAME|all                    WM layer from layers/wm/ (bspwm, mangowm); repeatable.
                                   Choosing a WM also applies the desktop profile.
  --wm-profile core|desktop        WM profile (default: desktop or the saved one).
  --base-only                      Run diagnostics solely for the base repository.
  --all                            Diagnose or synchronize all available components.
  --apply                          Apply bootstrap or unlink (without it only the plan is shown).
  --stow-only | --packages-only    Links only (no packages, no sudo) or packages only.
  -y, --yes                        Automatic yes to update prompts.
  -h, --help                       Show this help.

Examples:
  $PROGRAM_NAME setup
  $PROGRAM_NAME bootstrap --profile cli --layer dev --apply
  $PROGRAM_NAME sync
  $PROGRAM_NAME update
  $PROGRAM_NAME doctor
  $PROGRAM_NAME unlink
  $PROGRAM_NAME add walls
  $PROGRAM_NAME switch ~/.dotfiles --apply
EOF
  fi
}

require_option_value() {
  local option_name=$1
  local option_value=${2-}
  [[ -n "$option_value" ]] || usage_error "$option_name necesita un valor"
}

parse_args() {
  local -a args_filtered=()
  while (( $# > 0 )); do
    case "$1" in
      --lang)
        require_option_value "$1" "${2-}"
        DOTFILES_LANG=$2
        DOTFILES_LANG_EXPLICIT=1
        export DOTFILES_LANG
        shift 2
        ;;
      --lang=*)
        DOTFILES_LANG=${1#*=}
        require_option_value "--lang" "$DOTFILES_LANG"
        DOTFILES_LANG_EXPLICIT=1
        export DOTFILES_LANG
        shift
        ;;
      *)
        args_filtered+=("$1")
        shift
        ;;
    esac
  done
  if (( ${#args_filtered[@]} > 0 )); then
    set -- "${args_filtered[@]}"
  else
    set --
  fi

  if (( $# == 0 )); then
    if [[ -t 0 && -t 1 ]]; then
      COMMAND="setup"
      return 0
    fi
    usage
    exit 0
  fi

  COMMAND=$1
  shift

  case "$COMMAND" in
    bootstrap|doctor|unlink|sync|update|setup)
      ;;
    completion)
      COMPLETION_SHELL=${1:-zsh}
      return 0
      ;;
    system)
      # The system layer parses its own options (see lib/system.sh).
      SYSTEM_ARGS=("$@")
      return 0
      ;;
    add)
      # add parses its own options (see lib/components.sh).
      ADD_ARGS=("$@")
      return 0
      ;;
    switch)
      # switch parses its own options (see lib/switch.sh).
      SWITCH_ARGS=("$@")
      return 0
      ;;
    help|-h|--help)
      usage
      exit 0
      ;;
    *)
      usage_error "$(_t "unknown command: $COMMAND" "comando desconocido: $COMMAND")"
      ;;
  esac

  while (( $# > 0 )); do
    case "$1" in
      -y|--yes)
        FORCE_YES=1
        shift
        ;;
      --profile)
        require_option_value "$1" "${2-}"
        PROFILE=$2
        PROFILE_EXPLICIT=1
        shift 2
        ;;
      --profile=*)
        PROFILE=${1#*=}
        PROFILE_EXPLICIT=1
        require_option_value "--profile" "$PROFILE"
        shift
        ;;
      --feature)
        require_option_value "$1" "${2-}"
        FEATURES+=("$2")
        shift 2
        ;;
      --feature=*)
        local feature_value=${1#*=}
        require_option_value "--feature" "$feature_value"
        FEATURES+=("$feature_value")
        shift
        ;;
      --layer)
        require_option_value "$1" "${2-}"
        OPTIONAL_LAYERS+=("$2")
        shift 2
        ;;
      --layer=*)
        local layer_value=${1#*=}
        require_option_value "--layer" "$layer_value"
        OPTIONAL_LAYERS+=("$layer_value")
        shift
        ;;
      --backend)
        require_option_value "$1" "${2-}"
        BACKEND_REQUEST=$2
        shift 2
        ;;
      --backend=*)
        BACKEND_REQUEST=${1#*=}
        require_option_value "--backend" "$BACKEND_REQUEST"
        shift
        ;;
      --platform)
        require_option_value "$1" "${2-}"
        PLATFORM_REQUEST=$2
        shift 2
        ;;
      --platform=*)
        PLATFORM_REQUEST=${1#*=}
        require_option_value "--platform" "$PLATFORM_REQUEST"
        shift
        ;;
      --target)
        require_option_value "$1" "${2-}"
        TARGET_DIR=$2
        shift 2
        ;;
      --target=*)
        TARGET_DIR=${1#*=}
        require_option_value "--target" "$TARGET_DIR"
        shift
        ;;
      --packages-only)
        [[ "$MODE_SELECTION" != "stow" ]] || \
          usage_error "--packages-only y --stow-only son excluyentes"
        MODE_SELECTION="packages"
        SYSTEM_ENABLED=1
        STOW_ENABLED=0
        shift
        ;;
      --stow-only)
        [[ "$MODE_SELECTION" != "packages" ]] || \
          usage_error "--packages-only y --stow-only son excluyentes"
        MODE_SELECTION="stow"
        SYSTEM_ENABLED=0
        STOW_ENABLED=1
        shift
        ;;
      --wm)
        require_option_value "$1" "${2-}"
        WM=$2
        COMPONENT_EXPLICIT=1
        add_wm_selection "$2"
        shift 2
        ;;
      --wm=*)
        WM=${1#*=}
        require_option_value "--wm" "$WM"
        COMPONENT_EXPLICIT=1
        add_wm_selection "$WM"
        shift
        ;;
      --wm-path|--wm-path=*)
        usage_error "--wm-path ya no existe: los WMs viven en $LAYERS_DIR/wm/<nombre>; use sólo --wm <nombre>"
        ;;
      --wm-profile)
        require_option_value "$1" "${2-}"
        WM_PROFILE=$2
        WM_PROFILE_SET=1
        shift 2
        ;;
      --wm-profile=*)
        WM_PROFILE=${1#*=}
        require_option_value "--wm-profile" "$WM_PROFILE"
        WM_PROFILE_SET=1
        shift
        ;;
      --wm-feature)
        require_option_value "$1" "${2-}"
        warn "el flag --wm-feature está deprecado; las capacidades están integradas en el perfil desktop del WM"
        shift 2
        ;;
      --wm-feature=*)
        local wm_feature_value=${1#*=}
        require_option_value "--wm-feature" "$wm_feature_value"
        warn "el flag --wm-feature está deprecado; las capacidades están integradas en el perfil desktop del WM"
        shift
        ;;
      --wallpapers|--wallpapers=*|--wallpapers-path|--wallpapers-path=*)
        usage_error "${1%%=*} ya no existe: walls es un componente externo de components.conf; use 'dotfiles add walls'"
        ;;
      --overlay)
        require_option_value "$1" "${2-}"
        OVERLAY_PATH=$2
        OVERLAY_EXPLICIT=1
        shift 2
        ;;
      --overlay=*)
        OVERLAY_PATH=${1#*=}
        require_option_value "--overlay" "$OVERLAY_PATH"
        OVERLAY_EXPLICIT=1
        shift
        ;;
      --no-overlay)
        NO_OVERLAY=1
        shift
        ;;
      --private|--private=*|--private-path|--private-path=*|--private-profile|--private-profile=*|--private-work|--private-work=*)
        usage_error "${1%%=*} se reemplazó por --overlay RUTA (un repositorio con layers/, p. ej. ~/.dotfiles-private)"
        ;;
      --agent-harness|--agent-harness=*|--harness|--harness=*|--agent-harness-path|--agent-harness-path=*|--harness-path|--harness-path=*)
        usage_error "${1%%=*} ya no existe: agent-harness es un proyecto independiente; use su propio instalador"
        ;;
      --base-only)
        BASE_ONLY=1
        COMPONENT_EXPLICIT=1
        shift
        ;;
      --all)
        ALL_COMPONENTS=1
        shift
        ;;
      --apply)
        APPLY=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage_error "opción desconocida: $1"
        ;;
    esac
  done

  case "$PROFILE" in
    core|cli|desktop)
      ;;
    *)
      usage_error "perfil no soportado: $PROFILE"
      ;;
  esac

  case "$BACKEND_REQUEST" in
    auto|shelly|paru|yay|pacman)
      ;;
    *)
      usage_error "backend no soportado: $BACKEND_REQUEST"
      ;;
  esac

  case "$PLATFORM_REQUEST" in
    auto|cachyos|arch)
      ;;
    *)
      usage_error "plataforma no soportada: $PLATFORM_REQUEST"
      ;;
  esac

  case "$WM_PROFILE" in
    core|desktop)
      ;;
    *)
      usage_error "perfil de WM no soportado: $WM_PROFILE"
      ;;
  esac

  if [[ "$COMMAND" =~ ^(bootstrap|unlink|doctor)$ && -z "$WM" ]]; then
    (( WM_PROFILE_SET == 0 )) || usage_error "--wm-profile requiere --wm"
  fi

  if (( BASE_ONLY == 1 && ALL_COMPONENTS == 1 )); then
    usage_error "--base-only y --all son mutuamente excluyentes"
  fi

  if (( BASE_ONLY == 1 )) && [[ "$COMMAND" != "doctor" ]]; then
    usage_error "--base-only solo está soportado para el comando doctor"
  fi

  if (( OVERLAY_EXPLICIT == 1 && NO_OVERLAY == 1 )); then
    usage_error "--overlay y --no-overlay son mutuamente excluyentes"
  fi

  # setup asks for the selection itself; refuse it instead of dropping it.
  if [[ "$COMMAND" == "setup" ]] && (( PROFILE_EXPLICIT == 1 || ${#WMS[@]} > 0 || ${#FEATURES[@]} > 0 || ${#OPTIONAL_LAYERS[@]} > 0 )); then
    usage_error "setup pregunta el perfil, los WMs y los extras; para pasarlos como opciones use bootstrap"
  fi


  if [[ "$COMMAND" == "doctor" && "$APPLY" == 1 ]]; then
    usage_error "doctor siempre es read-only y no acepta --apply"
  fi

  if [[ "$COMMAND" == "unlink" ]]; then
    [[ "$MODE_SELECTION" != "packages" ]] || \
      usage_error "unlink sólo gestiona enlaces y no acepta --packages-only"
    SYSTEM_ENABLED=0
    STOW_ENABLED=1
  fi
}

# Opt-in layers are the layers under layers/ with a layer.conf that are
# neither base nor WM layers; features come from base and opt-in layers.
discover_layers() {
  local layer_dir name feature
  local -A conf=()
  local -a declared=()

  SUPPORTED_LAYERS=() SUPPORTED_FEATURES=() FEATURE_LAYERS=()
  for layer_dir in "$LAYERS_DIR"/*/; do
    name=${layer_dir%/}
    name=${name##*/}
    [[ -f "$LAYERS_DIR/$name/layer.conf" && "$name" != wm ]] || continue
    array_contains BASE_LAYERS "$name" || SUPPORTED_LAYERS+=("$name")
    read_layer_conf "$LAYERS_DIR/$name" conf
    read -r -a declared <<< "${conf[features]:-}"
    for feature in "${declared[@]}"; do
      [[ -z "${FEATURE_LAYERS[$feature]:-}" ]] || \
        die "la feature $feature está declarada en ${FEATURE_LAYERS[$feature]} y en $name"
      FEATURE_LAYERS["$feature"]=$name
      SUPPORTED_FEATURES+=("$feature")
    done
  done
}

validate_features() {
  local feature name
  local -a unique_features=() unique_layers=()

  for feature in "${FEATURES[@]}"; do
    array_contains SUPPORTED_FEATURES "$feature" || usage_error "feature no soportado: $feature"
    append_unique unique_features "$feature"
  done
  FEATURES=("${unique_features[@]}")
  for name in "${OPTIONAL_LAYERS[@]}"; do
    array_contains SUPPORTED_LAYERS "$name" || \
      usage_error "capa opcional no soportada: $name (disponibles: ${SUPPORTED_LAYERS[*]:-ninguna})"
    append_unique unique_layers "$name"
  done
  OPTIONAL_LAYERS=("${unique_layers[@]}")
}



detect_active_environment() {
  # Every WM layer ships with the repository, so only what is installed counts.
  if (( ${#WMS[@]} == 0 )); then
    if [[ -L "$TARGET_DIR/.config/mango/config.conf" || -f "$(receipt_path mangowm)" ]]; then
      append_unique WMS "mangowm"
    fi
    if [[ -L "$TARGET_DIR/.config/bspwm/bspwmrc" || -f "$(receipt_path bspwm)" ]]; then
      append_unique WMS "bspwm"
    fi
  fi
}

detect_all_environment() {
  local wm_layer
  for wm_layer in "$LAYERS_DIR"/wm/*/; do
    [[ -f "$wm_layer/layer.conf" ]] || continue
    wm_layer=${wm_layer%/}
    append_unique WMS "${wm_layer##*/}"
  done
}

resolve_wm_layers() {
  local current_wm

  if (( ${#WMS[@]} == 0 )) && [[ -n "$WM" ]]; then
    WMS+=("$WM")
  fi
  (( ${#WMS[@]} > 0 )) || return 0

  for current_wm in "${WMS[@]}"; do
    [[ "$current_wm" =~ $WM_NAME_PATTERN ]] || die "nombre de WM inválido: $current_wm"
    [[ -f "$LAYERS_DIR/wm/$current_wm/layer.conf" ]] || \
      die "entorno de ventanas no soportado: $current_wm (no existe $LAYERS_DIR/wm/$current_wm/layer.conf)"

    if (( WM_PROFILE_SET == 0 )) && [[ -z "${WM_PROFILES[$current_wm]:-}" ]]; then
      local -A wm_receipt=()
      if read_receipt "$current_wm" wm_receipt; then
        local saved_wm_profile=${wm_receipt[PROFILE]:-}
        if [[ "$saved_wm_profile" == "core" || "$saved_wm_profile" == "desktop" ]]; then
          WM_PROFILES["$current_wm"]="$saved_wm_profile"
        fi
      fi
    fi
  done

  WM="${WMS[0]}"
}


# Validates the selected overlay and adds its layers and features to the
# discovered ones. Runs once; a recorded overlay that is gone stops here.
prepare_overlay() {
  local root layer_dir name receipt feature
  local -A conf=()
  local -a declared=()

  (( OVERLAY_READY == 0 )) || return 0
  OVERLAY_READY=1
  (( NO_OVERLAY == 0 )) || OVERLAY_PATH=""
  [[ -n "$OVERLAY_PATH" ]] || return 0

  root=$(realpath -m -- "$OVERLAY_PATH")
  [[ -d "$root" ]] || die "no existe el overlay: $root (indique otra ruta con --overlay RUTA o continúe sin él con --no-overlay)"
  [[ "$root" != "$REPO_ROOT" && "$root" != "$REPO_ROOT/"* ]] || \
    die "el overlay debe estar fuera del repositorio público: $root"
  [[ -d "$root/layers" ]] || die "el overlay no contiene layers/: $root"
  OVERLAY_PATH=$root
  LAYER_OVERLAY_ROOT="$root/layers"

  OVERLAY_LAYERS=()
  for layer_dir in "$LAYER_OVERLAY_ROOT"/*/; do
    name=${layer_dir%/}
    name=${name##*/}
    # Checked before layer.conf, so an overlay wm/ can never shadow a WM layer.
    [[ ! -e "$LAYERS_DIR/$name" ]] || die "la capa $name del overlay ya existe en el repositorio público"
    [[ -f "$LAYER_OVERLAY_ROOT/$name/layer.conf" ]] || continue
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "nombre de capa inválido en el overlay: $name"
    read_layer_conf "$LAYER_OVERLAY_ROOT/$name" conf
    # Each layer keeps its own receipt; the public ones are never shared.
    receipt=${conf[receipt]:-$name}
    if [[ "$receipt" == dotfiles || "$receipt" == components || -e "$LAYERS_DIR/$receipt" || -e "$LAYERS_DIR/wm/$receipt" ]]; then
      die "la capa $name del overlay usa un recibo reservado: $receipt"
    fi
    read -r -a declared <<< "${conf[features]:-}"
    for feature in "${declared[@]}"; do
      [[ -z "${FEATURE_LAYERS[$feature]:-}" ]] || \
        die "la feature $feature está declarada en ${FEATURE_LAYERS[$feature]} y en $name"
      FEATURE_LAYERS["$feature"]=$name
      SUPPORTED_FEATURES+=("$feature")
    done
    OVERLAY_LAYERS+=("$name")
  done

  # A misspelled requirement would otherwise keep a layer from ever applying.
  local dependency
  local -a dependencies=()
  for name in "${OVERLAY_LAYERS[@]}"; do
    read_layer_conf "$LAYER_OVERLAY_ROOT/$name" conf
    read -r -a dependencies <<< "${conf[requires]:-}"
    for dependency in "${dependencies[@]}"; do
      [[ -f "$LAYERS_DIR/$dependency/layer.conf" ]] || array_contains OVERLAY_LAYERS "$dependency" || \
        die "la capa $name del overlay requiere una capa que no existe: $dependency"
    done
  done
}

link_cli_command() {
  (( STOW_ENABLED == 1 )) || return 0
  local target_bin="$TARGET_DIR/.local/bin"
  local bin_link="$target_bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  mkdir -p -- "$target_bin" 2>/dev/null || return 0

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      info "Comando dotfiles ya enlazado en $bin_link"
    else
      ln -sfn -- "$script_source" "$bin_link"
      info "Comando dotfiles actualizado en $bin_link"
    fi
  elif [[ -e "$bin_link" ]]; then
    warn "$bin_link ya existe y no es un enlace simbólico. No se sobrescribirá."
  else
    ln -sfn -- "$script_source" "$bin_link"
    info "Comando dotfiles enlazado en $bin_link"
  fi
}

unlink_cli_command() {
  local bin_link="$TARGET_DIR/.local/bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      rm -f -- "$bin_link"
      info "Enlace del comando dotfiles retirado: $bin_link"
    else
      warn "$bin_link enlaza a $current_target (ajeno a este repositorio). Omitiendo."
    fi
  fi
}

validate_cli_command() {
  (( STOW_ENABLED == 1 )) || return 0
  local bin_link="$TARGET_DIR/.local/bin/dotfiles"
  local script_source="$SCRIPT_DIR/dotfiles"

  if [[ -L "$bin_link" ]]; then
    local current_target
    current_target=$(readlink -f -- "$bin_link" || true)
    if [[ "$current_target" == "$script_source" ]]; then
      info "Comando CLI validado: $bin_link"
      return 0
    else
      warn "$bin_link enlaza a $current_target en lugar de $script_source"
      return 0
    fi
  fi
  return 0
}



# Resolves the layers of this run: base tiers up to PROFILE plus the WM layers,
# each after what it requires. A WM requires the desktop layer, so choosing one
# raises the recorded profile to desktop.
resolve_selected_layers() {
  local wm feature layer base_layer
  local -a requested=()

  # A selected feature pulls in the layer that declares it.
  local -a overlay_requested=()
  for feature in "${FEATURES[@]}"; do
    layer=${FEATURE_LAYERS[$feature]}
    if array_contains OVERLAY_LAYERS "$layer"; then
      append_unique overlay_requested "$layer"
    elif ! array_contains BASE_LAYERS "$layer"; then
      append_unique OPTIONAL_LAYERS "$layer"
    elif (( $(base_layer_rank "$layer") > $(base_layer_rank "$PROFILE") )); then
      info "La feature $feature requiere la capa $layer; se aplica $layer en lugar de $PROFILE"
      PROFILE=$layer
    fi
  done

  requested=("$PROFILE" "${OPTIONAL_LAYERS[@]}")
  for wm in "${WMS[@]}"; do
    requested+=("wm/$wm")
  done
  requested+=("${overlay_requested[@]}")
  SELECTED_LAYERS=()
  resolve_layers "$LAYERS_DIR" SELECTED_LAYERS "${requested[@]}"
  add_overlay_layers

  # The profile follows the highest base layer the selection pulled in.
  local highest=$PROFILE
  for base_layer in "${BASE_LAYERS[@]}"; do
    array_contains SELECTED_LAYERS "$base_layer" && highest=$base_layer
  done
  [[ "$highest" != "$PROFILE" ]] || return 0
  if [[ "$highest" == desktop ]] && (( ${#WMS[@]} > 0 )); then
    info "Los WMs requieren el perfil desktop; se aplica desktop en lugar de $PROFILE"
  else
    info "Las capas elegidas requieren la capa $highest; se aplica $highest en lugar de $PROFILE"
  fi
  PROFILE=$highest
}

# Appends every overlay layer whose requires are all selected, repeating until
# no more apply, so an overlay layer may require another one.
add_overlay_layers() {
  local name dependency added=1 ready
  local -A conf=()
  local -a dependencies=()

  while (( added == 1 )); do
    added=0
    for name in "${OVERLAY_LAYERS[@]}"; do
      ! array_contains SELECTED_LAYERS "$name" || continue
      read_layer_conf "$LAYER_OVERLAY_ROOT/$name" conf
      read -r -a dependencies <<< "${conf[requires]:-}"
      ready=1
      for dependency in "${dependencies[@]}"; do
        array_contains SELECTED_LAYERS "$dependency" || { ready=0; break; }
      done
      (( ready == 1 )) || continue
      SELECTED_LAYERS+=("$name")
      added=1
    done
  done
}

# Prints the position of base layer $1 in BASE_LAYERS (core=0, cli=1, ...).
base_layer_rank() {
  local index
  for index in "${!BASE_LAYERS[@]}"; do
    [[ "${BASE_LAYERS[index]}" != "$1" ]] || { printf '%s' "$index"; return 0; }
  done
  die "capa base desconocida: $1"
}

# Prints the profile a selected layer runs with.
layer_profile() {
  case "$1" in
    wm/*) printf '%s' "${WM_PROFILES[${1#wm/}]:-$WM_PROFILE}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Prints the composite doctor label of a selected layer.
layer_label() {
  case "$1" in
    wm/*) printf 'Window Manager (%s)' "${1#wm/}" ;;
    *)
      if array_contains BASE_LAYERS "$1"; then
        printf 'Base (%s)' "$1"
      elif array_contains OVERLAY_LAYERS "$1"; then
        printf 'Overlay (%s)' "$1"
      else
        printf 'Optional (%s)' "$1"
      fi
      ;;
  esac
}

# Prints the profile recorded layer $1 (under root $2) was applied with: a
# WM layer's own receipt, or the layer name like layer_profile.
recorded_layer_profile() {
  local -A conf=() saved=()
  local wm_profile

  case "$1" in
    wm/*)
      read_layer_conf "$2/$1" conf
      wm_profile=${WM_PROFILES[${1#wm/}]:-$WM_PROFILE}
      if read_receipt "${conf[receipt]:-${1//\//-}}" saved && [[ "${saved[PROFILE]:-}" == core || "${saved[PROFILE]:-}" == desktop ]]; then
        wm_profile=${saved[PROFILE]}
      fi
      printf '%s' "$wm_profile"
      ;;
    *) printf '%s' "$1" ;;
  esac
}

# Appends to the array named by $2 every layer of overlay root $1 whose
# requires are all in it, repeating like add_overlay_layers; names that
# collide with a public layer are skipped.
add_recorded_overlay_layers() {
  local root=$1 name dependency added=1 ready layer_dir
  local -n recorded_ref=$2
  local -A conf=()
  local -a names=() dependencies=()

  for layer_dir in "$root"/*/; do
    name=${layer_dir%/}
    name=${name##*/}
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ && ! -e "$LAYERS_DIR/$name" && -f "$root/$name/layer.conf" ]] || continue
    names+=("$name")
  done
  while (( added == 1 )); do
    added=0
    for name in "${names[@]}"; do
      ! array_contains "$2" "$name" || continue
      read_layer_conf "$root/$name" conf
      read -r -a dependencies <<< "${conf[requires]:-}"
      ready=1
      for dependency in "${dependencies[@]}"; do
        array_contains "$2" "$dependency" || { ready=0; break; }
      done
      (( ready == 1 )) || continue
      recorded_ref+=("$name")
      added=1
    done
  done
}

# Compares the selection receipt with the layers this bootstrap or sync
# resolved and fills the RETIRE_* units: every recorded layer that is no
# longer selected (or comes from another overlay) is unlinked whole, and a
# kept layer loses the Stow packages of its dropped features. Only links into
# the layer's own checkout are ever removed (stow --delete).
compute_retired_selection() {
  local -A recorded=() conf=() layer_roots=()
  local -a requested=() recorded_layers=() recorded_features=() entries=() declared=()
  local -a layer_features=() dropped_features=() kept_packages=() retired_packages=()
  local entry layer root index feature recorded_overlay="" overlay_root=""

  RETIRE_ROOTS=() RETIRE_LAYERS=() RETIRE_PROFILES=() RETIRE_FEATURES=() RETIRE_PACKAGE_LISTS=()
  RETIRE_NAMES=()
  if (( STOW_ENABLED == 1 )) && [[ "$COMMAND" == bootstrap || "$COMMAND" == sync ]] && read_receipt dotfiles recorded; then
    # The recorded selection, keeping only what still exists.
    case "${recorded[PROFILE]:-}" in
      core|cli|desktop) requested+=("${recorded[PROFILE]}") ;;
    esac
    read -r -a entries <<< "${recorded[LAYERS]:-}"
    for entry in "${entries[@]}"; do
      ! array_contains SUPPORTED_LAYERS "$entry" || requested+=("$entry")
    done
    read -r -a entries <<< "${recorded[WMS]:-}"
    for entry in "${entries[@]}"; do
      [[ ! "$entry" =~ $WM_NAME_PATTERN || ! -f "$LAYERS_DIR/wm/$entry/layer.conf" ]] || requested+=("wm/$entry")
    done
    (( ${#requested[@]} == 0 )) || resolve_layers "$LAYERS_DIR" recorded_layers "${requested[@]}"
    for layer in "${recorded_layers[@]}"; do
      layer_roots["$layer"]=$LAYERS_DIR
    done

    # The recorded overlay's layers come from its own checkout.
    if [[ -n "${recorded[OVERLAY]:-}" ]]; then
      recorded_overlay=$(realpath -m -- "${recorded[OVERLAY]}")
      if [[ -d "$recorded_overlay/layers" ]]; then
        overlay_root="$recorded_overlay/layers"
        index=${#recorded_layers[@]}
        add_recorded_overlay_layers "$overlay_root" recorded_layers
        for layer in "${recorded_layers[@]:index}"; do
          layer_roots["$layer"]=$overlay_root
        done
      else
        warn "$(_t "the layers of the recorded overlay cannot be retired: $recorded_overlay/layers does not exist" "no se pueden retirar las capas del overlay guardado: no existe $recorded_overlay/layers")"
      fi
    fi
    read -r -a recorded_features <<< "${recorded[FEATURES]:-}"

    # Reverse order, like unlink: a layer goes before what it requires.
    for (( index = ${#recorded_layers[@]} - 1; index >= 0; index-- )); do
      layer=${recorded_layers[index]}
      root=${layer_roots[$layer]}
      read_layer_conf "$root/$layer" conf
      read -r -a declared <<< "${conf[features]:-}"
      layer_features=()
      for feature in "${recorded_features[@]}"; do
        array_contains declared "$feature" && append_unique layer_features "$feature"
      done
      for feature in "${layer_features[@]}"; do
        array_contains FEATURES "$feature" || append_unique dropped_features "$feature"
      done

      if array_contains SELECTED_LAYERS "$layer" && [[ "$(layer_root "$LAYERS_DIR" "$layer")" == "$root" ]]; then
        # Kept: only the Stow packages of its dropped features go.
        # kept_packages is read through array_contains by name.
        # shellcheck disable=SC2034
        retired_packages=() kept_packages=()
        read_layer_stow_packages "$root/$layer" "$(layer_profile "$layer")" kept_packages
        for feature in "${declared[@]}"; do
          [[ -f "$root/$layer/packages/stow/$feature.txt" ]] || continue
          read_manifest "$root/$layer/packages/stow/$feature.txt" entries
          for entry in "${entries[@]}"; do
            if array_contains FEATURES "$feature"; then
              append_unique kept_packages "$entry"
            elif array_contains layer_features "$feature"; then
              append_unique retired_packages "$entry"
            fi
          done
        done
        entries=()
        for entry in "${retired_packages[@]}"; do
          array_contains kept_packages "$entry" || entries+=("$entry")
        done
        (( ${#entries[@]} > 0 )) || continue
        RETIRE_PACKAGE_LISTS+=("${entries[*]}")
      else
        RETIRE_PACKAGE_LISTS+=("")
        RETIRE_NAMES+=("${layer#wm/}")
      fi
      RETIRE_ROOTS+=("$root")
      RETIRE_LAYERS+=("$layer")
      RETIRE_PROFILES+=("$(recorded_layer_profile "$layer" "$root")")
      RETIRE_FEATURES+=("${layer_features[*]}")
    done
    RETIRE_NAMES+=("${dropped_features[@]}")
  fi

  # Components the wizard dropped are not re-applied; they are links, so a
  # --packages-only run keeps them.
  (( STOW_ENABLED == 1 )) || RETIRED_COMPONENTS=()
  (( ${#RETIRED_COMPONENTS[@]} > 0 )) || return 0
  RETIRE_NAMES+=("${RETIRED_COMPONENTS[@]}")
  entries=()
  for entry in "${RECORDED_COMPONENTS[@]}"; do
    array_contains RETIRED_COMPONENTS "$entry" || entries+=("$entry")
  done
  RECORDED_COMPONENTS=("${entries[@]}")
}

# Unlinks only Stow packages $3 of layer $2 under root $1 (apply mode $4):
# the dropped features of a layer that stays selected, so the layer keeps its
# receipt. Same stow --delete simulation, removal and check as unlink.
retire_layer_packages() {
  local STOW_DIR="$1/$2/home"
  local -a STOW_PACKAGES=()

  read -r -a STOW_PACKAGES <<< "$3"
  info "Retiro de las features descartadas de la capa $2"
  print_array "Paquetes Stow" STOW_PACKAGES
  [[ -f "$STOW_DIR/.stow" ]] || { error "falta el marcador $STOW_DIR/.stow"; return 1; }
  command_exists stow || { error "GNU Stow es necesario para retirar enlaces"; return 1; }
  run_stow delete 1 || return 1
  (( $4 == 1 )) || return 0
  info "Retirando enlaces GNU Stow; no se eliminarán paquetes ni archivos ajenos"
  run_stow delete 0 || return 1
  validate_links_unlinked
}

# Retires the RETIRE_* units and RETIRED_COMPONENTS with apply mode $1: a
# whole layer through its normal unlink (links only, no packages), dropped
# features through retire_layer_packages.
retire_dropped_selection() {
  local apply_mode=$1 index
  local SYSTEM_ENABLED=0
  local -a FEATURES=()

  for index in "${!RETIRE_LAYERS[@]}"; do
    if [[ -n "${RETIRE_PACKAGE_LISTS[index]}" ]]; then
      retire_layer_packages "${RETIRE_ROOTS[index]}" "${RETIRE_LAYERS[index]}" \
        "${RETIRE_PACKAGE_LISTS[index]}" "$apply_mode"
    else
      read -r -a FEATURES <<< "${RETIRE_FEATURES[index]}"
      run_layer "${RETIRE_ROOTS[index]}" "${RETIRE_LAYERS[index]}" unlink "${RETIRE_PROFILES[index]}" "$apply_mode"
    fi || die "falló el retiro de la capa ${RETIRE_LAYERS[index]}"
  done
  (( ${#RETIRED_COMPONENTS[@]} == 0 )) || unlink_components "$apply_mode" RETIRED_COMPONENTS
}

# Common start of bootstrap, doctor and unlink: validates the request,
# resolves the layers and prints the selection plan.
prepare_selection() {
  local execution_mode current_layer

  prepare_overlay
  validate_features
  command_exists realpath || die "falta el comando requerido: realpath"
  TARGET_DIR=$(realpath -m -- "$TARGET_DIR")
  resolve_selected_layers

  if [[ "$COMMAND" == "doctor" ]]; then
    execution_mode="read-only"
  elif [[ "$APPLY" == 1 ]]; then
    execution_mode="apply"
  else
    execution_mode="dry-run"
  fi

  info "Plan de la selección"
  printf '  %-24s %s\n' 'Comando:' "$COMMAND"
  printf '  %-24s %s\n' 'Modo:' "$execution_mode"
  printf '  %-24s %s\n' 'Perfil:' "$PROFILE"
  print_array "Features" FEATURES
  (( ${#OPTIONAL_LAYERS[@]} == 0 )) || print_array "Capas opcionales" OPTIONAL_LAYERS
  for current_layer in "${SELECTED_LAYERS[@]}"; do
    printf '  %-24s %s\n' "Capa $current_layer:" "perfil $(layer_profile "$current_layer")"
  done
  printf '  %-24s %s\n' 'Target:' "$TARGET_DIR"

  # Components are links: --packages-only and doctor --base-only skip them.
  RECORDED_COMPONENTS=()
  if (( STOW_ENABLED == 1 && BASE_ONLY == 0 )); then
    recorded_components RECORDED_COMPONENTS
  fi
  compute_retired_selection
  (( ${#RECORDED_COMPONENTS[@]} == 0 )) || print_array "Componentes" RECORDED_COMPONENTS

  if [[ -n "$OVERLAY_PATH" ]]; then
    printf '  %-24s %s\n' 'Overlay:' "$OVERLAY_PATH"
  fi
  (( ${#RETIRE_NAMES[@]} == 0 )) || printf '  %-24s %s\n' "$(_t 'Retiring:' 'Se retiran:')" "${RETIRE_NAMES[*]}"
}

# Runs operation $1 with apply mode $2 on every selected layer, in reverse
# order when $3 is "reverse". Stops at the first failing layer.
run_selected_layers() {
  local operation=$1 apply_mode=$2 order=${3:-forward}
  local -a layers=("${SELECTED_LAYERS[@]}")
  local index current_layer

  for (( index = 0; index < ${#layers[@]}; index++ )); do
    if [[ "$order" == reverse ]]; then
      current_layer=${layers[${#layers[@]} - 1 - index]}
    else
      current_layer=${layers[index]}
    fi
    if ! run_layer "$(layer_root "$LAYERS_DIR" "$current_layer")" "$current_layer" "$operation" \
      "$(layer_profile "$current_layer")" "$apply_mode"; then
      FAILED_LAYER=$current_layer
      return 1
    fi
  done
}




# Prints the Stow homes (or packages) the RETIRE_* units remove links from,
# separated by ':' (the DOTFILES_REPLACEABLE_ROOTS of the preflight).
retired_link_roots() {
  local index entry home roots=""
  local -a entries=()

  for index in "${!RETIRE_LAYERS[@]}"; do
    home=$(realpath -m -- "${RETIRE_ROOTS[index]}/${RETIRE_LAYERS[index]}/home")
    if [[ -z "${RETIRE_PACKAGE_LISTS[index]}" ]]; then
      roots+="$home:"
    else
      read -r -a entries <<< "${RETIRE_PACKAGE_LISTS[index]}"
      for entry in "${entries[@]}"; do
        roots+="$home/$entry:"
      done
    fi
  done
  printf '%s' "${roots%:}"
}

# Preflight of every selected layer; the links being retired first count as
# replaceable, so a layer may take over a path a retired one linked.
preflight_selected_layers() {
  local -x DOTFILES_REPLACEABLE_ROOTS
  DOTFILES_REPLACEABLE_ROOTS=$(retired_link_roots)
  run_selected_layers bootstrap 0
}

# The changes of a bootstrap or sync, in order.
apply_selection() {
  retire_dropped_selection "$APPLY"
  run_selected_layers bootstrap "$APPLY" || die "falló el bootstrap de la capa $FAILED_LAYER"
  if (( APPLY == 1 )); then
    # Recorded as soon as the layers are on disk, so a failing optional
    # component below never leaves applied layers without a selection.
    save_selection_receipt
    (( STOW_ENABLED == 0 )) || link_cli_command
  fi
  apply_components "$APPLY" RECORDED_COMPONENTS
}

# Applies a selection that retires something inside a transaction (see
# lib/switch.sh): when any step fails, the retired links come back and
# whatever the run linked goes, so the target is left as it was.
apply_selection_transaction() {
  local index layer name dir token status=0

  txn_begin bootstrap
  for index in "${!RETIRE_LAYERS[@]}"; do
    txn_track_packages "${RETIRE_ROOTS[index]}/${RETIRE_LAYERS[index]}/home"
  done
  for layer in "${SELECTED_LAYERS[@]}"; do
    txn_track_packages "$(layer_root "$LAYERS_DIR" "$layer")/$layer/home"
  done
  txn_track_engine_outputs
  for name in "${RECORDED_COMPONENTS[@]}" "${RETIRED_COMPONENTS[@]}"; do
    dir=$(component_dir "$name")
    txn_track_tree "${dir#"$TARGET_DIR"/}"
    for token in ${COMPONENT_LINKS[$name]:-}; do
      txn_track "${token#*=}"
    done
  done
  txn_snapshot kind=bootstrap
  info "Retiro transaccional: si algo falla se restauran los enlaces retirados"

  set +e
  ( set -e; apply_selection )
  status=$?
  set -e
  if (( status != 0 )); then
    error "el bootstrap falló después de retirar la selección descartada; restaurando el estado anterior"
    txn_rollback "$TXN_DIR" discard || \
      die "la reversión quedó incompleta; reintente con '$PROGRAM_NAME switch --rollback --apply'"
    die "falló el bootstrap; se restauraron los enlaces retirados y el target quedó como antes"
  fi
  txn_commit
}

bootstrap_with_optional_components() {
  prepare_selection

  if (( APPLY == 1 )); then
    info "Preflight de todas las capas antes de modificar nada"
    retire_dropped_selection 0
    preflight_selected_layers || \
      die "falló el preflight de la capa $FAILED_LAYER; no se modificó la base"
  fi

  if (( APPLY == 1 )) && (( ${#RETIRE_LAYERS[@]} > 0 || ${#RETIRED_COMPONENTS[@]} > 0 )); then
    apply_selection_transaction
  else
    apply_selection
  fi

  if (( APPLY == 1 )) && (( ${SYSTEM_INSTALL:-0} == 1 )) && [[ -n "${SYSTEM_PATH:-}" && -f "$SYSTEM_PATH/install.sh" ]]; then
    local -a sys_flags=()
    case "${SYSTEM_MODE:-all}" in
      ly)      sys_flags=("--ly") ;;
      limine)  sys_flags=("--limine") ;;
      dns)     sys_flags=("--dns") ;;
      ly-dns)  sys_flags=("--ly" "--dns") ;;
      *)       sys_flags=("--all") ;;
    esac
    if [[ "${SYSTEM_MODE:-all}" != "ly" && "${SYSTEM_MODE:-all}" != "limine" && -n "${SYSTEM_DNS_PROVIDER:-}" ]]; then
      sys_flags+=("--provider" "$SYSTEM_DNS_PROVIDER")
    fi
    info "Siguiente paso recomendado (Capa del Sistema):"
    info "  sudo $SYSTEM_PATH/install.sh ${sys_flags[*]} --install"
  fi
}

doctor_with_optional_components() {
  local result=0 current_layer
  local -a report_items=()

  prepare_selection
  for current_layer in "${SELECTED_LAYERS[@]}"; do
    if run_layer "$(layer_root "$LAYERS_DIR" "$current_layer")" "$current_layer" doctor \
      "$(layer_profile "$current_layer")" 0; then
      report_items+=("  ✓ $(layer_label "$current_layer"): OK")
    else
      report_items+=("  ✗ $(layer_label "$current_layer"): FAIL")
      error "Doctor: falló la validación de la capa $current_layer"
      result=1
    fi
  done
  if (( STOW_ENABLED == 1 )); then
    validate_cli_command || result=1
  fi

  local name
  for name in "${RECORDED_COMPONENTS[@]}"; do
    if doctor_component "$name"; then
      report_items+=("  ✓ Component ($name): OK")
    else
      report_items+=("  ✗ Component ($name): FAIL")
      result=1
    fi
  done

  printf '\n%b%s%b\n' "${C_BOLD}${C_MAUVE}" "$(_t "=== Composite Doctor Summary ===" "=== Resumen del Doctor Compuesto ===")" "$C_RESET"
  local item
  for item in "${report_items[@]}"; do
    if [[ "$item" == *"OK"* ]]; then
      printf '%b%s%b\n' "$C_GREEN" "$item" "$C_RESET"
    else
      printf '%b%s%b\n' "$C_RED" "$item" "$C_RESET"
    fi
  done
  printf '\n'

  if (( result == 0 )); then
    success "$(_t "All ${#report_items[@]} audited component(s) passed doctor checks." "Los ${#report_items[@]} componente(s) auditados pasaron el chequeo de doctor exitosamente.")"
  else
    error "$(_t "Doctor detected issues across audited components." "Doctor detectó problemas en los componentes auditados.")"
  fi
  return "$result"
}

unlink_with_optional_components() {
  prepare_selection

  if (( APPLY == 1 )); then
    info "Preflight de unlink de todas las capas antes de modificar nada"
    run_selected_layers unlink 0 reverse || \
      die "falló el preflight de unlink de la capa $FAILED_LAYER; no se modificó la base"
  fi

  run_selected_layers unlink "$APPLY" reverse || die "falló el unlink de la capa $FAILED_LAYER"
  (( APPLY == 0 )) || unlink_cli_command
  unlink_components "$APPLY" RECORDED_COMPONENTS
  # Only once every component is gone, so a failed unlink can be retried
  # with the same saved selection.
  (( APPLY == 0 )) || rm -f -- "$(receipt_path dotfiles)"
}

# Records what this machine selected so sync/update re-apply it without flags.
save_selection_receipt() {
  write_receipt dotfiles PROFILE="$PROFILE" FEATURES="${FEATURES[*]}" LAYERS="${OPTIONAL_LAYERS[*]}" \
    WMS="${WMS[*]}" OVERLAY="$OVERLAY_PATH" BACKEND="${BACKEND:-}"
}

# Restores the recorded selection for whatever the command line left unset.
load_selection_receipt() {
  local -A selection=()
  local entry
  local -a entries=() restored=()

  read_receipt dotfiles selection || return 0
  if (( PROFILE_EXPLICIT == 0 )); then
    case "${selection[PROFILE]:-}" in
      core|cli|desktop)
        PROFILE=${selection[PROFILE]}
        ;;
      *)
        # Never install more than this machine recorded.
        warn "perfil inválido en el recibo de selección: ${selection[PROFILE]:-vacío}; se usa core"
        PROFILE=core
        ;;
    esac
    restored+=("perfil $PROFILE")
  fi
  if (( OVERLAY_EXPLICIT == 0 && NO_OVERLAY == 0 )) && [[ -n "${selection[OVERLAY]:-}" ]]; then
    OVERLAY_PATH=${selection[OVERLAY]}
    restored+=("overlay $OVERLAY_PATH")
  fi
  # The overlay declares features of its own, so it is validated first.
  prepare_overlay
  if (( ${#FEATURES[@]} == 0 )); then
    read -r -a entries <<< "${selection[FEATURES]:-}"
    for entry in "${entries[@]}"; do
      if array_contains SUPPORTED_FEATURES "$entry"; then
        append_unique FEATURES "$entry"
      else
        warn "se ignora una feature inválida en el recibo de selección: $entry"
      fi
    done
    (( ${#FEATURES[@]} == 0 )) || restored+=("features ${FEATURES[*]}")
  fi
  if (( ${#OPTIONAL_LAYERS[@]} == 0 )); then
    read -r -a entries <<< "${selection[LAYERS]:-}"
    for entry in "${entries[@]}"; do
      if array_contains SUPPORTED_LAYERS "$entry"; then
        append_unique OPTIONAL_LAYERS "$entry"
      else
        warn "se ignora una capa inválida en el recibo de selección: $entry"
      fi
    done
    (( ${#OPTIONAL_LAYERS[@]} == 0 )) || restored+=("capas ${OPTIONAL_LAYERS[*]}")
  fi
  if (( ${#WMS[@]} == 0 )); then
    read -r -a entries <<< "${selection[WMS]:-}"
    for entry in "${entries[@]}"; do
      if [[ "$entry" =~ $WM_NAME_PATTERN && -f "$LAYERS_DIR/wm/$entry/layer.conf" ]]; then
        append_unique WMS "$entry"
      else
        warn "se ignora un WM inválido en el recibo de selección: $entry"
      fi
    done
    (( ${#WMS[@]} == 0 )) || restored+=("WMs ${WMS[*]}")
  fi
  restore_saved_backend "${selection[BACKEND]:-}"
  if (( ${#restored[@]} > 0 )); then
    local summary
    printf -v summary '%s, ' "${restored[@]}"
    info "Selección restaurada del recibo: ${summary%, }"
  fi
}

sync_environment() {
  info "Iniciando re-sincronización local del entorno..."
  load_selection_receipt

  if (( ALL_COMPONENTS == 1 )); then
    detect_all_environment
  else
    detect_active_environment
  fi

  resolve_wm_layers

  APPLY=1
  bootstrap_with_optional_components
  success "$(_t "Local resynchronization completed successfully." "Re-sincronización local completada exitosamente.")"
}

# The system layer is never applied by update: when the pulled range changed
# it and this machine applied it before, only say how to re-apply it.
notify_system_layer_update() {
  local range=$1
  local -A saved=()

  [[ -n "$range" ]] || return 0
  read_receipt system saved || return 0
  git -C "$REPO_ROOT" diff --quiet "$range" -- layers/system && return 0
  local args=${saved[SYSTEM_ARGS]:-}
  # Custom DoT endpoints are never stored: ask for them again.
  [[ " $args " != *" --custom "* ]] || args=${args/--custom/--custom <endpoints>}
  warn "$(_t "The system layer changed; update does not apply it. Re-apply it with" "La capa system cambió; update no la aplica. Vuelva a aplicarla con"): dotfiles system setup $args"
}

update_from_remote() {
  info "$(_t "Checking local repositories in $TARGET_DIR/.dotfiles/..." "Comprobando repositorios locales en $TARGET_DIR/.dotfiles/...")"
  command_exists git || die "$(_t "git is required to update from remote repositories" "git es necesario para actualizar desde repositorios remotos")"

  local -a repos_to_update=()
  repos_to_update+=("$REPO_ROOT")

  # The overlay of the command line or of the saved selection is pulled too.
  # Components are not pulled: the sync below moves them to their pinned ref.
  local overlay=$OVERLAY_PATH
  local -A saved_selection=()
  if [[ -z "$overlay" ]] && (( NO_OVERLAY == 0 )) && read_receipt dotfiles saved_selection; then
    overlay=${saved_selection[OVERLAY]:-}
  fi
  if [[ -n "$overlay" && -d "$overlay/.git" ]]; then
    append_unique repos_to_update "$(realpath -m -- "$overlay")"
  fi

  local -a updated_repos=()
  local repo system_range=""
  for repo in "${repos_to_update[@]}"; do
    local repo_name=${repo##*/}
    info "$(_t "Verifying Git status in" "Verificando estado de Git en") $repo_name ($repo)..."
    local git_status
    git_status=$(git -C "$repo" status --porcelain 2>/dev/null || true)
    if [[ -n "$git_status" ]]; then
      warn "$(_t "Repository $repo_name has uncommitted local changes; skipping git pull to protect your work" "El repositorio $repo_name tiene cambios locales sin confirmar; omitiendo git pull para proteger su trabajo")"
    else
      local head_before head_after pull_output
      head_before=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
      if ! pull_output=$(GIT_SSH_COMMAND="ssh -o BatchMode=yes" GIT_TERMINAL_PROMPT=0 git -C "$repo" pull --ff-only 2>&1); then
        warn "$(_t "Could not fast-forward $repo_name; skipping" "No se pudo realizar fast-forward en $repo_name; omitiendo")"
        [[ -n "$pull_output" ]] && printf '%s\n' "$pull_output"
      else
        head_after=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
        if [[ -n "$head_before" && -n "$head_after" && "$head_before" != "$head_after" ]]; then
          info "$repo_name: $(_t "updated" "actualizado") (${head_before:0:7}..${head_after:0:7})"
          updated_repos+=("$repo_name")
          [[ "$repo" != "$REPO_ROOT" ]] || system_range="$head_before..$head_after"
        else
          info "$repo_name: $(_t "already up to date" "ya está al día")"
        fi
      fi
    fi
  done

  if (( ${#updated_repos[@]} == 0 )); then
    success "$(_t "All repositories are already up to date. No synchronization needed." "Todos los repositorios ya están al día. No se requiere sincronización.")"
    return 0
  fi
  notify_system_layer_update "$system_range"

  info "$(_t "Updated repositories:" "Repositorios con novedades:") ${updated_repos[*]}"
  local do_sync=1
  if [[ -t 0 && -t 1 ]] && (( ${FORCE_YES:-0} == 0 )); then
    local question
    question=$(_t \
      "Changes were downloaded in ${#updated_repos[@]} repository(ies). Do you want to resynchronize the environment now?" \
      "Se descargaron cambios en ${#updated_repos[@]} repositorio(s). ¿Deseas re-sincronizar el entorno ahora?")
    if ! prompt_yes_no "$question" "Y"; then
      do_sync=0
    fi
  fi

  if (( do_sync == 1 )); then
    info "$(_t "Applying local resynchronization after remote update..." "Aplicando re-sincronización local tras la actualización remota...")"
    sync_environment
  else
    info "$(_t "Resynchronization skipped by user. You can run '$PROGRAM_NAME sync' whenever you want to apply it." "Re-sincronización omitida por el usuario. Puedes ejecutar '$PROGRAM_NAME sync' cuando desees aplicarla.")"
  fi
}

cmd_doctor() {
  if (( BASE_ONLY == 0 )); then
    if (( ALL_COMPONENTS == 1 )); then
      detect_all_environment
    elif (( COMPONENT_EXPLICIT == 0 )); then
      detect_active_environment
    fi
  fi

  resolve_wm_layers
  doctor_with_optional_components
}

cmd_unlink() {
  unlink_with_optional_components
}

main() {
  parse_args "$@"
  discover_layers

  case "$COMMAND" in
    setup)
      run_interactive_wizard
      ;;
    sync)
      sync_environment
      ;;
    update)
      update_from_remote
      ;;
    bootstrap)
      resolve_wm_layers
      bootstrap_with_optional_components
      ;;
    doctor)
      cmd_doctor
      ;;
    unlink)
      resolve_wm_layers
      cmd_unlink
      ;;
    completion)
      cmd_completion
      ;;
    system)
      cmd_system "${SYSTEM_ARGS[@]}"
      ;;
    add)
      cmd_add "${ADD_ARGS[@]}"
      ;;
    switch)
      cmd_switch "${SWITCH_ARGS[@]}"
      ;;
  esac
}

main "$@"
