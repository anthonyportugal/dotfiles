#compdef dotfiles

_dotfiles() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a commands
  commands=(
    'setup:Asistente interactivo guiado para configurar e instalar por capas'
    'sync:Re-sincroniza enlaces locales y paquetes sin tocar repositorios Git'
    'update:Descarga actualizaciones de GitHub (fast-forward) y re-sincroniza'
    'bootstrap:Resuelve dependencias y enlaces. Sólo modifica con --apply'
    'doctor:Comprueba dependencias, sintaxis y enlaces sin modificar nada'
    'unlink:Retira únicamente los enlaces Stow. Sólo modifica con --apply'
    'completion:Genera scripts de autocompletado para el shell (bash|zsh)'
    'help:Muestra la ayuda'
  )

  local -a common_options
  common_options=(
    '--profile[Perfil acumulativo]:perfil:(core cli desktop)'
    '*--feature[Feature opt-in]:feature:(yazi-extras)'
    '--backend[Backend de paquetes]:backend:(auto shelly paru yay pacman)'
    '--platform[Plataforma detectada u override]:plataforma:(auto cachyos arch)'
    '--target[Home objetivo]:directorio:_files -/'
    '--packages-only[Opera o valida sólo paquetes del sistema]'
    '--stow-only[Opera o valida sólo paquetes Stow]'
    '*--wm[Integra opcionalmente un WM independiente]:wm:(bspwm mangowm)'
    '--wm-path[Checkout externo del repositorio del WM]:directorio:_files -/'
    '--wm-profile[Perfil propio del WM]:perfil:(core desktop)'
    '*--wm-feature[Feature de MangoWM]:feature:(laptop recording)'
    '--wallpapers[Integra la colección de wallpapers (anthonyportugal/walls)]'
    '--wallpapers-path[Checkout externo del repositorio de wallpapers]:directorio:_files -/'
    '--private[Integra la capa privada (anthonyportugal/dotfiles-private)]'
    '--private-path[Checkout externo del repositorio privado]:directorio:_files -/'
    '--private-profile[Perfil de la capa privada]:perfil:(core dev)'
    '*--private-work[Añade un componente laboral a la capa privada]:nombre:'
    '--apply[Aplica bootstrap/unlink; sin él hay dry-run]'
    '(-h --help)'{-h,--help}'[Muestra la ayuda]'
  )

  _arguments -C \
    '1: :->command' \
    '*:: :->args' && return 0

  case "$state" in
    command)
      _describe -t commands 'comando dotfiles' commands
      ;;
    args)
      case "$line[1]" in
        completion)
          _arguments '1:shell:(bash zsh)'
          ;;
        setup|sync|update|bootstrap|doctor|unlink)
          _arguments -s $common_options
          ;;
        help)
          _describe -t commands 'comando' commands
          ;;
      esac
      ;;
  esac
}

_dotfiles "$@"
