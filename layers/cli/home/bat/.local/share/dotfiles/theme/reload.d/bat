#!/usr/bin/env bash
# Rebuilds bat's cache after `dotfiles-theme set`, so the "dotfiles" theme
# (linked into ~/.config/bat/themes) carries the new palette. It never fails
# the theme switch.

if ! command -v bat >/dev/null 2>&1; then
  printf 'bat: bat no está instalado; se omite la caché de temas\n'
  exit 0
fi
bat cache --build >/dev/null 2>&1 || \
  printf 'bat: no se pudo reconstruir la caché de temas\n' >&2
exit 0
