#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Rebuilds the bat theme cache and the themed starship config after linking
# the cli layer.
# Run by bin/dotfiles through run_layer_hook (see lib/layers.sh).

set -Eeuo pipefail

# Read by lib/colors.sh as the log prefix.
# shellcheck disable=SC2034
PROGRAM_NAME=cli
# shellcheck source=../../../lib/colors.sh
source "$DOTFILES_LIB/colors.sh"
# shellcheck source=../../../lib/core.sh
source "$DOTFILES_LIB/core.sh"

apply_bat_cache() {
  command_exists bat || return 0
  target_is_current_home || return 0
  bat cache --build >/dev/null 2>&1 || true
}

# The themed starship config is otherwise only built when a theme renders.
apply_starship_palette() {
  local hook="$HOME/.local/share/dotfiles/theme/render.d/starship"

  target_is_current_home || return 0
  [[ -x "$hook" ]] || return 0
  "$hook" >/dev/null 2>&1 || true
}

apply_bat_cache
apply_starship_palette
