#!/usr/bin/env bash
# Live reload of running Neovim instances after `dotfiles-theme set`: each
# server (Neovim listens on $XDG_RUNTIME_DIR/nvim.<pid>.0 by default) re-applies
# the dotfiles colorscheme when it is the active one; others are left alone.

set -uo pipefail

command -v nvim >/dev/null 2>&1 || exit 0
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

shopt -s nullglob
for server in "$runtime"/nvim.*.0; do
  [[ -S "$server" ]] || continue
  # shellcheck disable=SC2016  # Vimscript, evaluated by Neovim
  timeout 2 nvim --server "$server" --remote-expr \
    'execute("if get(g:, \"colors_name\", \"\") ==# \"dotfiles\" | colorscheme dotfiles | endif")' \
    >/dev/null 2>&1 || true
done
