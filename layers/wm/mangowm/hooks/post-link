#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Renders the initial MangoWM theme under the target's XDG state after linking.
# Run by bin/dotfiles through run_layer_hook (see lib/layers.sh).

set -Eeuo pipefail

# Read by lib/colors.sh as the log prefix.
# shellcheck disable=SC2034
PROGRAM_NAME=mangowm
# shellcheck source=../../../../lib/colors.sh
source "$DOTFILES_LIB/colors.sh"

render_theme_for_target() {
  local renderer="$TARGET_DIR/.local/bin/mango-theme"

  [[ -x "$renderer" ]] || die "el renderer instalado no es ejecutable: $renderer"
  info "Renderizando el tema inicial bajo el XDG state del target"
  HOME="$TARGET_DIR" \
    XDG_STATE_HOME="$TARGET_DIR/.local/state" \
    XDG_CONFIG_HOME="$TARGET_DIR/.config" \
    "$renderer" render >/dev/null
}

render_theme_for_target
