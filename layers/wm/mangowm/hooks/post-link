#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Renders the theme with the shared engine (stowed by the desktop layer this
# layer requires) so the MangoWM templates land under the target's XDG state.
# Run by bin/dotfiles through run_layer_hook (see lib/layers.sh).

set -Eeuo pipefail

# Read by lib/colors.sh as the log prefix.
# shellcheck disable=SC2034
PROGRAM_NAME=mangowm
# shellcheck source=../../../../lib/colors.sh
source "$DOTFILES_LIB/colors.sh"

render_theme_for_target() {
  local engine="$TARGET_DIR/.local/bin/dotfiles-theme"

  [[ -x "$engine" ]] || die "el motor de temas no es ejecutable: $engine"
  info "Renderizando las plantillas de MangoWM bajo el XDG state del target"
  HOME="$TARGET_DIR" \
    XDG_STATE_HOME="$TARGET_DIR/.local/state" \
    XDG_DATA_HOME="$TARGET_DIR/.local/share" \
    XDG_CONFIG_HOME="$TARGET_DIR/.config" \
    "$engine" render >/dev/null
}

render_theme_for_target
