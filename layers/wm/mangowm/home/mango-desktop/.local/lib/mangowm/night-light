#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

temp="${MANGOWM_NIGHT_TEMPERATURE:-3500}"
command_name=${1:-toggle}

status_json() {
  if pgrep -x gammastep >/dev/null 2>&1; then
    printf '{"text":"󰖔","tooltip":"Luz nocturna: Activada (%s K)\\n\\nClic para desactivar","class":"on"}\n' "$temp"
  else
    printf '{"text":"󰖔","tooltip":"Luz nocturna: Desactivada\\n\\nClic para activar","class":"off"}\n'
  fi
}

enable() {
  mangowm_require gammastep
  pkill -x gammastep 2>/dev/null || true
  gammastep -O "$temp" >/dev/null 2>&1 &
  mangowm_notify low 'Luz nocturna activada' "${temp} K"
  pkill -RTMIN+9 waybar 2>/dev/null || true
}

disable() {
  pkill -x gammastep 2>/dev/null || true
  gammastep -x 2>/dev/null || true
  mangowm_notify low 'Luz nocturna desactivada'
  pkill -RTMIN+9 waybar 2>/dev/null || true
}

case "$command_name" in
  on)
    enable
    ;;
  off)
    disable
    ;;
  toggle)
    if pgrep -x gammastep >/dev/null 2>&1; then
      disable
    else
      enable
    fi
    ;;
  status|waybar)
    status_json
    ;;
  restore)
    # No action needed on session start unless desired
    ;;
  *)
    printf 'Uso: %s toggle|on|off|status|restore\n' "${0##*/}" >&2
    exit 2
    ;;
esac
