#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

STATE_DIR="$(mangowm_state_home)/mangowm"
WALLPAPER_STATE="$STATE_DIR/wallpaper"

wallpaper_directories() {
  local dir
  for dir in \
    "${XDG_PICTURES_DIR:-$HOME/Pictures}/Wallpapers" \
    "${XDG_PICTURES_DIR:-$HOME/Pictures}/wallpapers" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/wallpapers"; do
    if [[ -d "$dir" ]]; then
      printf '%s\n' "$dir"
    fi
  done
}

list_wallpapers() {
  local dir
  while IFS= read -r dir; do
    find -L "$dir" -maxdepth 3 -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o \
      -iname '*.webp' -o -iname '*.avif' -o -iname '*.svg' \) 2>/dev/null
  done < <(wallpaper_directories) | sort -u
}

apply_swaybg() {
  local image=${1-}
  local theme_dir
  theme_dir=$(mangowm_theme_dir)

  systemctl --user stop mangowm-swaybg.service >/dev/null 2>&1 || true
  systemctl --user reset-failed mangowm-swaybg.service >/dev/null 2>&1 || true

  if [[ -n "$image" && -r "$image" ]]; then
    systemd-run --user --quiet --collect --unit=mangowm-swaybg -- \
      swaybg -i "$image" -m fill
  else
    systemd-run --user --quiet --collect --unit=mangowm-swaybg -- \
      swaybg -c "$(<"$theme_dir/background")"
  fi
}

set_wallpaper() {
  local target_file=$1
  [[ -r "$target_file" ]] || {
    mangowm_notify critical 'Wallpaper' "No se puede leer la imagen: $target_file"
    return 1
  }

  local canonical_path
  canonical_path=$(realpath -m -- "$target_file")
  mkdir -p -- "$STATE_DIR"
  printf '%s\n' "$canonical_path" > "$WALLPAPER_STATE"
  apply_swaybg "$canonical_path"
  mangowm_notify normal 'Wallpaper' "Fondo actualizado: ${canonical_path##*/}"
}

restore_wallpaper() {
  if [[ -r "$WALLPAPER_STATE" ]]; then
    local current_wallpaper
    current_wallpaper=$(head -n 1 "$WALLPAPER_STATE" 2>/dev/null || true)
    if [[ -n "$current_wallpaper" && -r "$current_wallpaper" ]]; then
      apply_swaybg "$current_wallpaper"
      return 0
    fi
  fi
  apply_swaybg ""
}

clear_wallpaper() {
  rm -f -- "$WALLPAPER_STATE"
  apply_swaybg ""
  mangowm_notify normal 'Wallpaper' 'Fondo restablecido al color del tema'
}

select_wallpaper() {
  mangowm_require fuzzel || return 127

  local files
  mapfile -t files < <(list_wallpapers)

  if (( ${#files[@]} == 0 )); then
    mangowm_notify normal 'Wallpaper' \
      'No se encontraron imágenes en ~/Pictures/Wallpapers'
    return 0
  fi

  local formatted=()
  local file
  for file in "${files[@]}"; do
    formatted+=("${file##*/}|${file}")
  done

  local theme_dir
  theme_dir=$(mangowm_theme_dir)

  local selection
  selection=$(printf '%s\n' "${formatted[@]}" | \
    fuzzel --dmenu --config="$theme_dir/fuzzel.ini" --prompt='Wallpaper ❯ ' | cut -d'|' -f2 || true)

  if [[ -n "$selection" && -r "$selection" ]]; then
    set_wallpaper "$selection"
  fi
}

case "${1:-select}" in
  restore)
    restore_wallpaper
    ;;
  set)
    (( $# >= 2 )) || {
      printf 'Uso: %s set <ruta-de-imagen>\n' "${0##*/}" >&2
      exit 2
    }
    set_wallpaper "$2"
    ;;
  select)
    select_wallpaper
    ;;
  clear)
    clear_wallpaper
    ;;
  list)
    list_wallpapers
    ;;
  *)
    printf 'Uso: %s select|set|restore|clear|list\n' "${0##*/}" >&2
    exit 2
    ;;
esac
