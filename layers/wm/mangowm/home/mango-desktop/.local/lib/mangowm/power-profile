#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

command_name=${1:-next}

mangowm_require powerprofilesctl

get_current() {
  powerprofilesctl get 2>/dev/null || printf 'balanced\n'
}

set_profile() {
  local target=$1
  if powerprofilesctl set "$target" 2>/dev/null; then
    local label icon
    case "$target" in
      power-saver) label="Ahorro de energía"; icon="󰌪" ;;
      balanced)    label="Modo equilibrado"; icon="󰾅" ;;
      performance) label="Alto rendimiento"; icon="󰓅" ;;
      *)           label="$target"; icon="" ;;
    esac
    mangowm_notify low "Perfil de Energía" "$icon $label activo"
    pkill -RTMIN+8 waybar 2>/dev/null || true
  fi
}

waybar_json() {
  local current
  current=$(get_current)
  local icon label class
  case "$current" in
    power-saver)
      icon="󰌪"
      label="Ahorro de energía"
      class="power-saver"
      ;;
    performance)
      icon="󰓅"
      label="Alto rendimiento"
      class="performance"
      ;;
    balanced|*)
      icon="󰾅"
      label="Modo equilibrado"
      class="balanced"
      ;;
  esac
  printf '{"text":"%s","alt":"%s","tooltip":"Perfil de Energía: %s (%s)\\n\\nClic para cambiar modo","class":"%s"}\n' \
    "$icon" "$current" "$label" "$current" "$class"
}

case "$command_name" in
  next|up)
    current=$(get_current)
    case "$current" in
      power-saver) set_profile balanced ;;
      balanced)    set_profile performance ;;
      performance) set_profile power-saver ;;
      *)           set_profile balanced ;;
    esac
    ;;
  prev|down)
    current=$(get_current)
    case "$current" in
      performance) set_profile balanced ;;
      balanced)    set_profile power-saver ;;
      power-saver) set_profile performance ;;
      *)           set_profile power-saver ;;
    esac
    ;;
  select|menu)
    current=$(get_current)
    mangowm_require fuzzel
    theme_dir=$(mangowm_theme_dir)

    tag_saver=""
    tag_balanced=""
    tag_perf=""
    case "$current" in
      power-saver) tag_saver="  [Activo]" ;;
      balanced)    tag_balanced="  [Activo]" ;;
      performance) tag_perf="  [Activo]" ;;
    esac

    options=(
      "󰌪  Ahorro de Energía (power-saver)${tag_saver}"
      "󰾅  Modo Equilibrado (balanced)${tag_balanced}"
      "󰓅  Alto Rendimiento (performance)${tag_perf}"
    )

    selected=$(printf '%s\n' "${options[@]}" | \
      fuzzel --dmenu --config="$theme_dir/fuzzel.ini" \
        --prompt="Perfil de Energía ❯ " --lines=3 --width=42 || true)

    case "$selected" in
      *"power-saver"*) set_profile power-saver ;;
      *"balanced"*)    set_profile balanced ;;
      *"performance"*) set_profile performance ;;
    esac
    ;;
  waybar|status)
    waybar_json
    ;;
  set)
    set_profile "${2:-balanced}"
    ;;
  get)
    get_current
    ;;
  *)
    printf 'Uso: %s next|prev|up|down|select|waybar|set <profile>|get\n' "${0##*/}" >&2
    exit 2
    ;;
esac
