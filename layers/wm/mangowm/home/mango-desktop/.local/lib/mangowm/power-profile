#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

command_name=${1:-next}

mangowm_require powerprofilesctl

get_current() {
  powerprofilesctl get 2>/dev/null || printf 'balanced\n'
}

set_profile() {
  local target=$1
  if powerprofilesctl set "$target" 2>/dev/null; then
    local label icon
    case "$target" in
      power-saver) label="Ahorro de energía"; icon="󰌪" ;;
      balanced)    label="Modo equilibrado"; icon="󰾅" ;;
      performance) label="Alto rendimiento"; icon="󰓅" ;;
      *)           label="$target"; icon="" ;;
    esac
    mangowm_notify low "Perfil de Energía" "$icon $label activo"
  fi
}

case "$command_name" in
  next|up)
    current=$(get_current)
    case "$current" in
      power-saver) set_profile balanced ;;
      balanced)    set_profile performance ;;
      performance) set_profile power-saver ;;
      *)           set_profile balanced ;;
    esac
    ;;
  prev|down)
    current=$(get_current)
    case "$current" in
      performance) set_profile balanced ;;
      balanced)    set_profile power-saver ;;
      power-saver) set_profile performance ;;
      *)           set_profile power-saver ;;
    esac
    ;;
  select|menu)
    current=$(get_current)
    mangowm_require fuzzel

    tag_saver=""
    tag_balanced=""
    tag_perf=""
    case "$current" in
      power-saver) tag_saver="  [Activo]" ;;
      balanced)    tag_balanced="  [Activo]" ;;
      performance) tag_perf="  [Activo]" ;;
    esac

    options=(
      "󰌪  Ahorro de Energía (power-saver)${tag_saver}"
      "󰾅  Modo Equilibrado (balanced)${tag_balanced}"
      "󰓅  Alto Rendimiento (performance)${tag_perf}"
    )

    selected=$(printf '%s\n' "${options[@]}" | \
      fuzzel --dmenu --prompt="Perfil de Energía ❯ " --lines=3 --width=42 || true)

    case "$selected" in
      *"power-saver"*) set_profile power-saver ;;
      *"balanced"*)    set_profile balanced ;;
      *"performance"*) set_profile performance ;;
    esac
    ;;
  set)
    set_profile "${2:-balanced}"
    ;;
  get)
    get_current
    ;;
  *)
    printf 'Uso: %s next|prev|up|down|select|set <profile>|get\n' "${0##*/}" >&2
    exit 2
    ;;
esac
