[
  {
    "name": "full",
    "output": ["!eDP-1", "!eDP-2", "*"],
    "include": ["~/.config/waybar/modules.json"],
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 2,
    "reload_style_on_change": true,
    "modules-left": ["custom/launcher", "mango/layout", "mango/workspaces", "mpris"],
    "modules-center": ["clock", "custom/recording"],
    "modules-right": [
      "custom/nightlight",
      "custom/idle",
      "custom/updates",
      "group/quick",
      "wireplumber",
      "network",
      "bluetooth",
      "custom/keyboard",
      "battery",
      "custom/power"
    ]
  },
  {
    "name": "compact",
    "output": ["eDP-1", "eDP-2"],
    "include": ["~/.config/waybar/modules.json"],
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 2,
    "reload_style_on_change": true,
    "modules-left": ["custom/launcher", "mango/layout", "mango/workspaces", "mpris#compact"],
    "modules-center": ["clock", "custom/recording"],
    "modules-right": [
      "custom/nightlight",
      "custom/idle",
      "custom/updates",
      "group/quick",
      "wireplumber",
      "backlight",
      "network#compact",
      "bluetooth#compact",
      "custom/keyboard",
      "battery",
      "custom/power"
    ]
  }
]
