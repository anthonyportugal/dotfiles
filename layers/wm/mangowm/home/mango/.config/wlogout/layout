{
  "label": "lock",
  "action": "$HOME/.local/lib/mangowm/lock",
  "text": "Lock",
  "keybind": "l"
}
{
  "label": "shutdown",
  "action": "systemctl poweroff",
  "text": "Shutdown",
  "keybind": "s"
}
{
  "label": "logout",
  "action": "$HOME/.local/lib/mangowm/logout",
  "text": "Logout",
  "keybind": "e"
}
{
  "label": "reboot",
  "action": "systemctl reboot",
  "text": "Reboot",
  "keybind": "r"
}
