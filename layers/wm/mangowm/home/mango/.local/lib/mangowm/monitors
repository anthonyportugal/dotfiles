#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

mangowm_require mmsg

apply_monitor_layout() {
  local force_apply=0
  if [[ "${1-}" == "--force" ]]; then
    force_apply=1
  fi

  local config_file="${XDG_CONFIG_HOME:-$HOME/.config}/mango/config.local.conf"
  mkdir -p "$(dirname "$config_file")"

  # Inspect connected displays and write portable local overrides
  python3 -c '
import json, os, subprocess, sys

config_file = sys.argv[1]
force_apply = sys.argv[2] == "1"

try:
    raw = subprocess.check_output(["mmsg", "get", "all-monitors"], text=True)
    data = json.loads(raw)
except Exception as e:
    sys.exit(0)

monitors = data.get("monitors", [])
if not monitors:
    sys.exit(0)

# Safety check: if user wrote a manual config without the auto-generated marker, preserve it
marker = "# Auto-generated by mangowm monitors helper"
if os.path.exists(config_file) and not force_apply:
    try:
        with open(config_file, "r", encoding="utf-8") as f:
            content = f.read()
        if content.strip() and marker not in content:
            # Preserve manual user configuration
            sys.exit(0)
    except Exception:
        pass

lines = [
    "# Machine-specific display configuration",
    "# Auto-generated by mangowm monitors helper - safe to customize or regenerate",
    ""
]

if len(monitors) == 1:
    mon = monitors[0]
    name = mon.get("name", "Unknown")
    w = mon.get("width", 1920)
    h = mon.get("height", 1080)
    lines.append(f"monitorrule=name:{name},width:{w},height:{h},x:0,y:0,scale:1")
    lines.append("")
    lines.append("# Tags 1-9 assigned to the single display")
    for i in range(1, 10):
        lines.append(f"bind=SUPER,{i},view,{i},0")
        lines.append(f"bind=SUPER+SHIFT,{i},tag,{i},0")
elif len(monitors) == 2:
    # 2-monitor topology
    # Prioritize DP or larger resolution on the left (Xiaomi 2K on DP, Samsung 1080p on HDMI)
    edp = next((m for m in monitors if m.get("name", "").startswith("eDP")), None)
    dp = next((m for m in monitors if m.get("name", "").startswith("DP")), None)
    hdmi = next((m for m in monitors if m.get("name", "").startswith("HDMI")), None)

    if dp and hdmi:
        left_mon, right_mon = dp, hdmi
    elif edp and (dp or hdmi):
        ext = dp or hdmi
        left_mon, right_mon = edp, ext
    else:
        # Sort by resolution / width descending
        sorted_mons = sorted(monitors, key=lambda m: (m.get("width", 0), m.get("height", 0)), reverse=True)
        left_mon, right_mon = sorted_mons[0], sorted_mons[1]

    l_name = left_mon["name"]
    l_w, l_h = left_mon.get("width", 1920), left_mon.get("height", 1080)
    r_name = right_mon["name"]
    r_w, r_h = right_mon.get("width", 1920), right_mon.get("height", 1080)

    y_offset = max(0, (l_h - r_h) // 2)

    lines.append(f"# Left monitor: {l_name} ({l_w}x{l_h})")
    lines.append(f"monitorrule=name:{l_name},width:{l_w},height:{l_h},x:0,y:0,scale:1")
    lines.append(f"# Right monitor: {r_name} ({r_w}x{r_h})")
    lines.append(f"monitorrule=name:{r_name},width:{r_w},height:{r_h},x:{l_w},y:{y_offset},scale:1")
    lines.append("")
    lines.append("# Workspaces partition: Left (1-5), Right (6-9)")
    for i in range(1, 6):
        lines.append(f"bind=SUPER,{i},viewcrossmon,{i},{l_name}")
        lines.append(f"bind=SUPER+SHIFT,{i},tagcrossmon,{i},{l_name}")
    for i in range(6, 10):
        lines.append(f"bind=SUPER,{i},viewcrossmon,{i},{r_name}")
        lines.append(f"bind=SUPER+SHIFT,{i},tagcrossmon,{i},{r_name}")
else:
    # 3+ monitors: arrange horizontally
    sorted_mons = sorted(monitors, key=lambda m: m.get("x", 0))
    cur_x = 0
    lines.append(f"# Multi-monitor configuration ({len(sorted_mons)} displays)")
    for m in sorted_mons:
        m_name = m.get("name", "")
        m_w = m.get("width", 1920)
        m_h = m.get("height", 1080)
        lines.append(f"monitorrule=name:{m_name},width:{m_w},height:{m_h},x:{cur_x},y:0,scale:1")
        cur_x += m_w

    lines.append("")
    lines.append("# Distributed workspaces across displays")
    tags_per_mon = max(1, 9 // len(sorted_mons))
    for idx, m in enumerate(sorted_mons):
        start_tag = idx * tags_per_mon + 1
        end_tag = 9 if idx == len(sorted_mons) - 1 else (idx + 1) * tags_per_mon
        m_name = m.get("name", "")
        for tag in range(start_tag, end_tag + 1):
            lines.append(f"bind=SUPER,{tag},viewcrossmon,{tag},{m_name}")
            lines.append(f"bind=SUPER+SHIFT,{tag},tagcrossmon,{tag},{m_name}")

lines.append("")
lines.append("# Monitor navigation bindings")
lines.append("bind=SUPER,comma,focusmon,left")
lines.append("bind=SUPER,period,focusmon,right")
lines.append("bind=SUPER+SHIFT,comma,tagmon,left")
lines.append("bind=SUPER+SHIFT,period,tagmon,right")
lines.append("")

with open(config_file, "w", encoding="utf-8") as f:
    f.write("\n".join(lines))
' "$config_file" "$force_apply"

  # Reload mango compositor configuration
  mmsg dispatch reload_config >/dev/null 2>&1 || true

  # Refresh wallpaper across all monitors
  if [[ -x "$HOME/.local/lib/mangowm/wallpaper" ]]; then
    "$HOME/.local/lib/mangowm/wallpaper" restore >/dev/null 2>&1 || true
  fi

  # Notify user
  local count
  count=$(python3 -c '
import json, subprocess
try:
    d = json.loads(subprocess.check_output(["mmsg", "get", "all-monitors"]))
    print(len(d.get("monitors", [])))
except Exception:
    print(1)
' 2>/dev/null || echo 1)

  if (( count > 1 )); then
    mangowm_notify normal "Monitores configurados" "Disposición dual activa: Pantalla izquierda (1-5), derecha (6-9)"
  else
    mangowm_notify normal "Monitor configurado" "Disposición única activa: 9 escritorios en pantalla"
  fi
}

watch_monitors() {
  local script_path
  script_path=$(readlink -f "$0")

  python3 -c '
import json, subprocess, sys, time

script_path = sys.argv[1]
proc = subprocess.Popen(["mmsg", "watch", "all-monitors"], stdout=subprocess.PIPE, text=True)

last_state = None

for raw_line in proc.stdout:
    line = raw_line.strip()
    if not line:
        continue
    try:
        data = json.loads(line)
        monitors = data.get("monitors", [])
        state = ";".join(sorted("%s:%sx%s" % (m.get("name", ""), m.get("width", 0), m.get("height", 0)) for m in monitors))
        if state != last_state:
            if last_state is not None:
                # Give compositor 200ms to stabilize DRM output state before reapplying
                time.sleep(0.2)
                subprocess.run([script_path, "apply"], check=False)
            last_state = state
    except Exception:
        continue
' "$script_path"
}

status_monitors() {
  python3 -c '
import json, subprocess
try:
    raw = subprocess.check_output(["mmsg", "get", "all-monitors"], text=True)
    d = json.loads(raw)
    monitors = d.get("monitors", [])
    print(f"Monitores detectados: {len(monitors)}")
    for m in monitors:
        name = m.get("name", "Unknown")
        w = m.get("width", 0)
        h = m.get("height", 0)
        x = m.get("x", 0)
        y = m.get("y", 0)
        act = " [Foco]" if m.get("active") else ""
        print(f"  • {name}: {w}x{h} en ({x},{y}){act}")
except Exception as e:
    print("Error consultando monitores:", e)
'
}

case "${1-}" in
  apply)
    shift
    apply_monitor_layout "${@-}"
    ;;
  watch)
    watch_monitors
    ;;
  status)
    status_monitors
    ;;
  *)
    printf 'Uso: %s apply [--force]|watch|status\n' "${0##*/}" >&2
    exit 2
    ;;
esac
