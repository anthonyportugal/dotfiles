#!/usr/bin/env bash
# Power menu: wlogout as a 2x2 cluster centred on the focused monitor. A
# second press closes it. The layer-shell surface goes to the focused output
# on its own; --no-span with -P left it invisible on mango 0.18.

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

if pkill -u "$UID" -x wlogout >/dev/null 2>&1; then
  exit 0
fi

mangowm_require wlogout
theme_dir=$(mangowm_theme_dir)

# Size of the active monitor; 1920x1080 when mango or jq cannot tell.
mon_w=1920
mon_h=1080
if command -v mmsg >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  read -r w h < <(mmsg get all-monitors 2>/dev/null | jq -r \
    '[.monitors[] | select(.active)][0] // .monitors[0] | "\(.width) \(.height)"' 2>/dev/null) || true
  [[ "${w-}" =~ ^[0-9]+$ && "${h-}" =~ ^[0-9]+$ ]] && { mon_w=$w; mon_h=$h; }
fi

# Fixed 2x2 cluster, about 190x190 px per button.
target_w=380
target_h=380
margin_x=$(( (mon_w - target_w) / 2 ))
margin_y=$(( (mon_h - target_h) / 2 ))
(( margin_x > 0 )) || margin_x=10
(( margin_y > 0 )) || margin_y=10

exec wlogout --protocol layer-shell \
  -b 2 \
  -c 0 -r 0 \
  -m 0 \
  -L "$margin_x" -R "$margin_x" \
  -T "$margin_y" -B "$margin_y" \
  --layout "${XDG_CONFIG_HOME:-$HOME/.config}/wlogout/layout" \
  --css "$theme_dir/wlogout.css" "$@"
