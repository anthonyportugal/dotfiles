#!/usr/bin/env bash

mangowm_state_home() {
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

mangowm_runtime_dir() {
  local runtime_root=${XDG_RUNTIME_DIR:-"$(mangowm_state_home)/runtime"}
  local runtime_dir="$runtime_root/mangowm"

  mkdir -p -- "$runtime_dir"
  chmod 0700 -- "$runtime_dir"
  printf '%s\n' "$runtime_dir"
}

# Active theme root of the shared engine (desktop layer): shared outputs such
# as background live here, MangoWM outputs below mangowm/.
mangowm_theme_root() {
  local engine="$HOME/.local/bin/dotfiles-theme"
  local current

  current=$("$engine" path) || {
    printf 'mangowm: no se pudo materializar el tema activo\n' >&2
    return 1
  }
  # A theme rendered before the MangoWM templates were installed lacks them.
  if [[ ! -d "$current/mangowm" ]]; then
    "$engine" render >/dev/null || true
  fi
  [[ -d "$current/mangowm" ]] || {
    printf 'mangowm: el tema activo no incluye las plantillas de MangoWM\n' >&2
    return 1
  }
  printf '%s\n' "$current"
}

mangowm_theme_dir() {
  local root

  root=$(mangowm_theme_root) || return 1
  printf '%s\n' "$root/mangowm"
}

mangowm_notify() {
  local urgency=$1
  local summary=$2
  local body=${3-}

  if command -v notify-send >/dev/null 2>&1; then
    notify-send --urgency="$urgency" --app-name=MangoWM "$summary" "$body"
  else
    printf '%s: %s\n' "$summary" "$body" >&2
  fi
}

# mangowm_notify_send <channel> <urgency> <summary> [body] [notify-send args...]
# One notification per channel: each call replaces the previous one instead of
# stacking (mako ignores the x-canonical-private-synchronous hint, but honours
# --replace-id). The last id lives in the runtime dir. Fails when no
# notification was shown, for callers that must retry (the battery alert).
mangowm_notify_send() {
  local channel=$1 urgency=$2 summary=$3 body=${4-}
  local id_file id='' new_id

  shift $(( $# < 4 ? $# : 4 ))
  if ! command -v notify-send >/dev/null 2>&1; then
    printf '%s: %s\n' "$summary" "$body" >&2
    return 1
  fi
  id_file="$(mangowm_runtime_dir)/notify.$channel"
  [[ -r "$id_file" ]] && id=$(<"$id_file")
  [[ "$id" =~ ^[0-9]+$ ]] || id=''
  new_id=$(notify-send --print-id ${id:+"--replace-id=$id"} --urgency="$urgency" \
    --app-name=MangoWM "$@" "$summary" "$body" 2>/dev/null) || return 1
  [[ "$new_id" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$new_id" > "$id_file"
}

# mangowm_notify_replace: mangowm_notify_send for feedback that may be lost
# (volume, toggles, progress); it never fails its caller.
mangowm_notify_replace() {
  mangowm_notify_send "$@" || true
}

# mangowm_osd <channel> <summary> <percent> [muted]: the volume/brightness
# overlay, a short notification with a progress bar styled by mako's
# osd (or osd-muted) category.
mangowm_osd() {
  local channel=$1 summary=$2 value=$3 category=osd

  [[ "$value" =~ ^[0-9]+$ ]] || value=0
  (( value > 100 )) && value=100
  [[ -n "${4-}" ]] && category=osd-muted
  mangowm_notify_replace "$channel" low "$summary" '' \
    --category="$category" --hint="int:value:$value"
}

mangowm_require() {
  command -v "$1" >/dev/null 2>&1 || {
    mangowm_notify critical 'Componente no disponible' "Instala el comando: $1"
    return 127
  }
}

# Fuzzel menus size themselves to their entries: the widest entry sets the
# width, between a floor and a cap. An entry longer than the cap is shortened
# in the middle, keeping its end (a file name, the last path components), and
# $HOME is shown as ~. The menu always returns the original entry. Lengths
# count characters under the session's UTF-8 locale.
MANGOWM_MENU_MIN_WIDTH=30
MANGOWM_MENU_MAX_WIDTH=90
# Room for icons drawn wider than one character and the selection margin.
MANGOWM_MENU_PADDING=4

# mangowm_menu_label <variable> <text> <max>: stores the displayed text.
mangowm_menu_label() {
  local -n _mangowm_label=$1
  local text=$2 max=$3 head tail

  [[ -n "${HOME-}" ]] && text=${text//"$HOME/"/"~/"}
  if (( ${#text} > max )); then
    head=$(( (max - 1) / 3 ))
    tail=$(( max - 1 - head ))
    text="${text:0:head}…${text:${#text}-tail}"
  fi
  _mangowm_label=$text
}

# Prints the rows of mangowm_menu from its labels and icons arrays; with no
# entries, one empty row as before icons existed.
mangowm_menu_rows() {
  local i

  (( ${#labels[@]} > 0 )) || { printf '\n'; return 0; }
  for i in "${!labels[@]}"; do
    if [[ -n "${icons[i]}" ]]; then
      printf '%s\0icon\x1f%s\n' "${labels[i]}" "${icons[i]}"
    else
      printf '%s\n' "${labels[i]}"
    fi
  done
}

# mangowm_menu <prompt> [fuzzel arguments...] < entries
# One entry per line; "label<TAB>value" shows the label and returns the value,
# which may itself hold tabs. A label may end in "<US>icon" (the 0x1f unit
# separator, then an icon name or absolute path), drawn by fuzzel next to the
# entry. Prints nothing when the menu is dismissed.
mangowm_menu() {
  local prompt=$1
  shift
  local theme_dir entry label max_label width widest index icon
  local labels=() values=() icons=()

  theme_dir=$(mangowm_theme_dir) || {
    mangowm_notify critical 'Menú no disponible' \
      'No se pudo cargar el tema activo; ejecute dotfiles-theme render'
    return 1
  }
  max_label=$(( MANGOWM_MENU_MAX_WIDTH - MANGOWM_MENU_PADDING ))
  mangowm_menu_label prompt "$prompt" "$max_label"
  widest=0

  while IFS= read -r entry || [[ -n "$entry" ]]; do
    label=$entry
    [[ "$entry" == *$'\t'* ]] && label=${entry%%$'\t'*}
    icon=''
    if [[ "$label" == *$'\x1f'* ]]; then
      icon=${label#*$'\x1f'}
      label=${label%%$'\x1f'*}
    fi
    if [[ "$entry" == *$'\t'* ]]; then
      values+=("${entry#*$'\t'}")
    else
      values+=("$label")
    fi
    icons+=("$icon")
    mangowm_menu_label label "$label" "$max_label"
    (( ${#label} > widest )) && widest=${#label}
    labels+=("$label")
  done

  width=$(( widest + MANGOWM_MENU_PADDING ))
  (( width < MANGOWM_MENU_MIN_WIDTH )) && width=$MANGOWM_MENU_MIN_WIDTH
  (( width > MANGOWM_MENU_MAX_WIDTH )) && width=$MANGOWM_MENU_MAX_WIDTH

  # fuzzel prints the index of the chosen label, so labels need no encoding
  # and duplicated labels still return their own value.
  index=$(mangowm_menu_rows | fuzzel --dmenu --index \
    --config="$theme_dir/fuzzel.ini" --prompt="$prompt" --width="$width" "$@") || return $?
  [[ "$index" =~ ^[0-9]+$ ]] && (( index < ${#values[@]} )) || return 0
  printf '%s\n' "${values[index]}"
}

mangowm_is_media_active() {
  if command -v playerctl >/dev/null 2>&1 && [[ "$(playerctl status 2>/dev/null || true)" == "Playing" ]]; then
    return 0
  fi
  if command -v pactl >/dev/null 2>&1 && pactl list sink-inputs 2>/dev/null | grep -q 'State: RUNNING'; then
    return 0
  fi
  return 1
}
