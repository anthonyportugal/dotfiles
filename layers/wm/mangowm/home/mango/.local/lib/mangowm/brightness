#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

mangowm_require brightnessctl
case "${1-}" in
  up)
    brightnessctl --class=backlight set +5%
    ;;
  down)
    brightnessctl --class=backlight set 5%-
    ;;
  *)
    printf 'Uso: %s up|down\n' "${0##*/}" >&2
    exit 2
    ;;
esac

pct=$(brightnessctl -m 2>/dev/null | awk -F, 'NF>=4 {print $4; exit}' || true)
mangowm_notify normal "Brillo" "󰃠 ${pct}"
