#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

command_name=${1:-watch}

get_raw_layout() {
  local layout=""
  if command -v mmsg >/dev/null 2>&1; then
    layout=$(mmsg get keyboardlayout 2>/dev/null || true)
  fi
  if [[ -z "$layout" ]]; then
    layout="us"
  fi
  printf '%s\n' "$layout"
}

switch_layout() {
  if command -v mmsg >/dev/null 2>&1; then
    mmsg dispatch switch_keyboard_layout 2>/dev/null || true
  fi
  mangowm_notify low "Teclado" "Distribución cambiada"
}

# Number of layouts mango is configured with: the last xkb_rules_layout in
# config.conf, conf.d and config.local.conf (the order mango reads them).
# Prints 0 when no file sets it: the layouts come from elsewhere, so the
# indicator stays visible.
configured_layouts() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/mango" file line value=""
  local files=("$dir/config.conf" "$dir"/conf.d/*.conf "$dir/config.local.conf")

  for file in "${files[@]}"; do
    [[ -r "$file" ]] || continue
    while IFS= read -r line; do
      [[ "$line" =~ ^[[:space:]]*xkb_rules_layout[[:space:]]*=[[:space:]]*([^#[:space:]]*) ]] && \
        value=${BASH_REMATCH[1]}
    done < "$file"
  done
  [[ -n "$value" ]] || { printf '0\n'; return 0; }
  local commas=${value//[^,]/}
  printf '%s\n' $(( ${#commas} + 1 ))
}

print_json() {
  local raw="${1:-}"

  # With a single layout there is nothing to switch, so the bar hides it.
  if (( $(configured_layouts) == 1 )); then
    printf '{"text":"","class":"single"}\n'
    return 0
  fi
  local val="$raw"

  if [[ "$raw" =~ \"layout\":[[:space:]]*\"([^\"]+)\" ]]; then
    val="${BASH_REMATCH[1]}"
  elif [[ "$raw" =~ \"layout\":[[:space:]]*([^,}]+) ]]; then
    val="${BASH_REMATCH[1]}"
    val="${val//\"/}"
  fi
  val="$(printf '%s' "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

  local short="US"
  local desc="English (US)"
  local css_class="us"

  case "${val,,}" in
    *latin*|latam)
      short="ES"
      desc="Español (Latinoamérica)"
      css_class="latam"
      ;;
    *spanish*|es)
      short="ES"
      desc="Español"
      css_class="es"
      ;;
    *english*|us|"")
      short="US"
      desc="English (US)"
      css_class="us"
      ;;
    *)
      short="$(printf '%.2s' "$val" | tr '[:lower:]' '[:upper:]')"
      desc="$val"
      css_class="${val,,}"
      ;;
  esac

  printf '{"text":"%s","tooltip":"Distribución de teclado: %s\\n\\nClic para alternar","class":"%s"}\n' \
    "$short" "$desc" "$css_class"
}

get_short_layout() {
  local raw
  raw=$(get_raw_layout)
  local val="$raw"

  if [[ "$raw" =~ \"layout\":[[:space:]]*\"([^\"]+)\" ]]; then
    val="${BASH_REMATCH[1]}"
  elif [[ "$raw" =~ \"layout\":[[:space:]]*([^,}]+) ]]; then
    val="${BASH_REMATCH[1]}"
    val="${val//\"/}"
  fi
  val="$(printf '%s' "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

  case "${val,,}" in
    *latin*|latam)
      printf 'ES\n'
      ;;
    *spanish*|es)
      printf 'ES\n'
      ;;
    *english*|us|"")
      printf 'US\n'
      ;;
    *)
      printf '%.2s\n' "$val" | tr '[:lower:]' '[:upper:]'
      ;;
  esac
}

watch_events() {
  local current
  current=$(get_raw_layout)
  print_json "$current"

  if command -v mmsg >/dev/null 2>&1; then
    # Subscribe to native Mango compositor event stream.
    # Waybar reads line-by-line with 0% CPU and zero polling latency.
    mmsg watch keyboardlayout 2>/dev/null | while read -r line; do
      [[ -n "$line" ]] || continue
      print_json "$line"
    done
  else
    # Fallback when running outside active compositor
    sleep infinity
  fi
}

case "$command_name" in
  switch|next|toggle)
    switch_layout
    ;;
  watch)
    watch_events
    ;;
  status|waybar)
    print_json "$(get_raw_layout)"
    ;;
  get)
    get_short_layout
    ;;
  *)
    printf 'Uso: %s watch|status|switch|get\n' "${0##*/}" >&2
    exit 2
    ;;
esac
