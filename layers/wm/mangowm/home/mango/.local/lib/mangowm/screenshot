#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

mode=${1:-region}
case "$mode" in
  region|fullscreen|output|all|clipboard|annotate)
    ;;
  *)
    printf 'Uso: %s region|fullscreen|output|all|clipboard|annotate\n' "${0##*/}" >&2
    exit 2
    ;;
esac

mangowm_require grim
if [[ "$mode" != fullscreen && "$mode" != output && "$mode" != all ]]; then
  mangowm_require slurp
  if ! geometry=$(slurp); then
    exit 0
  fi
  [[ -n "$geometry" ]] || exit 0
fi

if [[ "$mode" == clipboard ]]; then
  mangowm_require wl-copy
  grim -g "$geometry" -t png - | wl-copy --type image/png
  mangowm_notify low 'Captura copiada' 'La región está disponible en el portapapeles.'
  exit 0
fi

if command -v xdg-user-dir >/dev/null 2>&1; then
  pictures_dir=$(xdg-user-dir PICTURES)
else
  pictures_dir="$HOME/Pictures"
fi
[[ -n "$pictures_dir" ]] || pictures_dir="$HOME/Pictures"
destination_dir="$pictures_dir/Screenshots"
mkdir -p -- "$destination_dir"
destination="$destination_dir/$(date +'%Y-%m-%d_%H-%M-%S_%N').png"

if [[ "$mode" == fullscreen || "$mode" == output ]]; then
  output_args=()
  active_output=""
  if command -v mmsg >/dev/null 2>&1; then
    active_output=$(mmsg get cursorpos 2>/dev/null | jq -r '.monitor // empty' 2>/dev/null || true)
    if [[ -z "$active_output" ]]; then
      active_output=$(mmsg get focusing-client 2>/dev/null | jq -r '.monitor // empty' 2>/dev/null || true)
    fi
  fi
  if [[ -n "$active_output" ]]; then
    output_args=(-o "$active_output")
  fi

  grim "${output_args[@]}" -t png "$destination"
  if command -v wl-copy >/dev/null 2>&1; then
    wl-copy --type image/png < "$destination"
  fi
  if [[ -n "$active_output" ]]; then
    mangowm_notify low 'Captura guardada' "Monitor ($active_output) guardado en ${destination##*/} y copiado al portapapeles."
  else
    mangowm_notify low 'Captura guardada' "Pantalla completa guardada en ${destination##*/} y copiada al portapapeles."
  fi
  exit 0
fi

if [[ "$mode" == all ]]; then
  grim -t png "$destination"
  if command -v wl-copy >/dev/null 2>&1; then
    wl-copy --type image/png < "$destination"
  fi
  mangowm_notify low 'Captura guardada' "Todas las pantallas guardadas en ${destination##*/} y copiadas al portapapeles."
  exit 0
fi

mangowm_require satty
theme_dir=$(mangowm_theme_dir)

temp_file=$(mktemp --suffix=.png "${TMPDIR:-/tmp}/satty-capture.XXXXXX")
trap 'rm -f -- "$temp_file"' EXIT

grim -g "$geometry" -t png - > "$temp_file"

XDG_CONFIG_HOME="$theme_dir/xdg-config" satty \
  --filename "$temp_file" \
  --output-filename "$destination" </dev/null
