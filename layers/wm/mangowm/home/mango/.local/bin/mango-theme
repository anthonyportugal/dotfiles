render_wlogout() {
  local icons_dir="$1/icons"
  mkdir -p -- "$icons_dir"

  local fg="${COLORS[foreground]}"
  local bg="${COLORS[background]}"

  write_lines "$icons_dir/lock.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$fg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>'
  write_lines "$icons_dir/lock-dark.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$bg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>'

  write_lines "$icons_dir/logout.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$fg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>'
  write_lines "$icons_dir/logout-dark.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$bg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>'

  write_lines "$icons_dir/suspend.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$fg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>'
  write_lines "$icons_dir/suspend-dark.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$bg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>'

  write_lines "$icons_dir/reboot.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$fg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>'
  write_lines "$icons_dir/reboot-dark.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$bg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>'

  write_lines "$icons_dir/shutdown.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$fg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>'
  write_lines "$icons_dir/shutdown-dark.svg" \
    '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="'"$bg"'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>'

  write_lines "$1/wlogout.css" \
    '/* Generated by mango-theme. Do not edit. */' \
    '* {' \
    '  background-image: none;' \
    '  box-shadow: none;' \
    '}' \
    "window { background-color: alpha(${COLORS[background_deep]}, 0.85); }" \
    'button {' \
    "  color: ${COLORS[foreground]};" \
    "  background-color: ${COLORS[surface]};" \
    '  border: none;' \
    '  border-radius: 0;' \
    '  margin: 0;' \
    '  min-width: 120px;' \
    '  min-height: 82px;' \
    '  font: bold 13px "JetBrainsMono Nerd Font";' \
    '  background-repeat: no-repeat;' \
    '  background-position: center 30%;' \
    '  background-size: 30px 30px;' \
    '  padding-top: 46px;' \
    '  outline-style: none;' \
    '  outline-width: 0;' \
    '  box-shadow: none;' \
    '}' \
    "button:focus, button:hover, button:active {" \
    "  color: ${COLORS[background]};" \
    "  background-color: ${COLORS[accent]};" \
    '  border: none;' \
    '  outline-style: none;' \
    '  outline-width: 0;' \
    '  box-shadow: none;' \
    '}' \
    '#lock {' \
    '  border-radius: 16px 0 0 16px;' \
    '  background-image: image(url("icons/lock.svg"), url("/usr/share/wlogout/icons/lock.png"));' \
    '}' \
    '#lock:focus, #lock:hover, #lock:active {' \
    '  background-image: image(url("icons/lock-dark.svg"), url("/usr/share/wlogout/icons/lock.png"));' \
    '}' \
    '#logout { background-image: image(url("icons/logout.svg"), url("/usr/share/wlogout/icons/logout.png")); }' \
    '#logout:focus, #logout:hover, #logout:active { background-image: image(url("icons/logout-dark.svg"), url("/usr/share/wlogout/icons/logout.png")); }' \
    '#suspend { background-image: image(url("icons/suspend.svg"), url("/usr/share/wlogout/icons/suspend.png")); }' \
    '#suspend:focus, #suspend:hover, #suspend:active { background-image: image(url("icons/suspend-dark.svg"), url("/usr/share/wlogout/icons/suspend.png")); }' \
    '#reboot { background-image: image(url("icons/reboot.svg"), url("/usr/share/wlogout/icons/reboot.png")); }' \
    '#reboot:focus, #reboot:hover, #reboot:active { background-image: image(url("icons/reboot-dark.svg"), url("/usr/share/wlogout/icons/reboot.png")); }' \
    '#shutdown {' \
    '  border-radius: 0 16px 16px 0;' \
    '  background-image: image(url("icons/shutdown.svg"), url("/usr/share/wlogout/icons/shutdown.png"));' \
    '}' \
    '#shutdown:focus, #shutdown:hover, #shutdown:active {' \
    '  background-image: image(url("icons/shutdown-dark.svg"), url("/usr/share/wlogout/icons/shutdown.png"));' \
    '}'
}

render_satty() {
  mkdir -p -- "$1/xdg-config/satty"
  write_lines "$1/xdg-config/satty/config.toml" \
    '# Generated by mango-theme. Do not edit.' \
    '[general]' \
    'fullscreen = "current-screen"' \
    'floating-hack = true' \
    'no-window-decoration = true' \
    'title = "Satty"' \
    'app-id = "org.satty.satty"' \
    'initial-tool = "brush"' \
    'default-hide-toolbars = false' \
    'focus-toggles-toolbars = false' \
    'default-fill-shapes = false' \
    'copy-command = "wl-copy"' \
    'auto-copy = false' \
    'save-after-copy = false' \
    'early-exit = ["copy", "save", "save-as"]' \
    'actions-on-enter = ["save-to-clipboard", "save-to-file", "exit"]' \
    'actions-on-escape = ["exit"]' \
    'actions-on-right-click = []' \
    'right-click-copy = false' \
    'corner-roundness = 8' \
    'disable-notifications = false' \
    '' \
    '[color-palette]' \
    'palette = [' \
    "    \"${COLORS[accent]}ff\"," \
    "    \"${COLORS[urgent]}ff\"," \
    "    \"${COLORS[yellow]}ff\"," \
    "    \"${COLORS[green]}ff\"," \
    "    \"${COLORS[blue]}ff\"," \
    "    \"${COLORS[text]}ff\"," \
    ']'
}

render_all() {
  local destination=$1

  mkdir -p -- "$destination"
  render_mango "$destination"
  render_foot "$destination"
  render_fuzzel "$destination"
  render_mako "$destination"
  render_swaylock "$destination"
  render_waybar "$destination"
  render_wlogout "$destination"
  render_satty "$destination"
  write_lines "$destination/background" "${COLORS[background]}"
  write_lines "$destination/metadata" \
    'schema=1' \
    "id=${COLORS[id]}" \
    "family=${COLORS[family]}" \
    "flavour=${COLORS[flavour]}" \
    "accent_name=${COLORS[accent_name]}"
}

validate_outputs() {
  local destination=$1
  local required

  for required in mango.conf foot.ini fuzzel.ini mako.conf swaylock.conf \
    waybar.css wlogout.css xdg-config/satty/config.toml background metadata; do
    [[ -s "$destination/$required" ]] || fail "output de tema vacío o ausente: $required"
  done
  grep -Fxq 'ignore-empty-password' "$destination/swaylock.conf" || \
    fail 'Swaylock no rechaza passwords vacíos'
  grep -Fq "${COLORS[accent]}" "$destination/waybar.css" || \
    fail 'Waybar no recibió el acento del tema'
  grep -Fxq "id=${COLORS[id]}" "$destination/metadata" || \
    fail 'metadata de tema inconsistente'
}

promote() {
  local revision=$1
  local next_link="$THEME_ROOT/.current.$$"

  ln -s -- "$revision" "$next_link"
  mv -Tf -- "$next_link" "$THEME_ROOT/current"
}

render_theme() {
  local digest revision

  mkdir -p -- "$THEME_ROOT"
  command -v flock >/dev/null 2>&1 || fail 'flock es necesario para renderizar temas'
  exec 9>"$THEME_ROOT/render.guard"
  flock 9
  digest=$(sha256sum -- "$PALETTE" "$SCRIPT_PATH" | sha256sum)
  digest=${digest%% *}
  revision="${COLORS[id]}-${digest:0:12}"

  if [[ ! -d "$THEME_ROOT/$revision" ]]; then
    RENDER_TEMP=$(mktemp -d "$THEME_ROOT/.render.XXXXXX")
    render_all "$RENDER_TEMP"
    validate_outputs "$RENDER_TEMP"
    chmod -R u=rwX,go=rX -- "$RENDER_TEMP"
    mv -- "$RENDER_TEMP" "$THEME_ROOT/$revision"
    RENDER_TEMP=''
  else
    validate_outputs "$THEME_ROOT/$revision"
  fi

  promote "$revision"
  printf '%s\n' "$THEME_ROOT/$revision"
}

main() {
  local command=${1:-render}

  (( $# <= 1 )) || {
    usage >&2
    exit 2
  }
  read_palette
  case "$command" in
    render)
      render_theme
      ;;
    validate)
      printf 'OK: %s\n' "$PALETTE"
      ;;
    path)
      [[ -d "$THEME_ROOT/current" ]] || fail 'el tema todavía no fue renderizado'
      printf '%s\n' "$THEME_ROOT/current"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
