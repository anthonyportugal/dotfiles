#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_PATH=$(realpath -m -- "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/../../../.." && pwd -P)
THEME_ID=${MANGOWM_THEME:-catppuccin-mocha-pink}
PALETTE="$REPO_ROOT/themes/$THEME_ID/palette.conf"
STATE_HOME=${XDG_STATE_HOME:-"$HOME/.local/state"}
THEME_ROOT="$STATE_HOME/mangowm/theme"
RENDER_TEMP=''

declare -A COLORS=()
declare -A EXPECTED=()

fail() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

cleanup_render() {
  if [[ -n "$RENDER_TEMP" && "$RENDER_TEMP" == "$THEME_ROOT"/.render.* && \
        -d "$RENDER_TEMP" ]]; then
    find "$RENDER_TEMP" -mindepth 1 -delete
    find "$RENDER_TEMP" -depth -type d -empty -delete
  fi
}
trap cleanup_render EXIT

usage() {
  printf 'Uso: %s render|validate|path\n' "$PROGRAM_NAME"
}

declare_schema() {
  local key

  for key in \
    schema id family flavour accent_name \
    rosewater flamingo pink mauve red maroon peach yellow green teal sky \
    sapphire blue lavender text subtext1 subtext0 overlay2 overlay1 overlay0 \
    surface2 surface1 surface0 base mantle crust background background_alt \
    background_deep surface surface_hover foreground foreground_muted accent \
    urgent warning success; do
    EXPECTED["$key"]=1
  done
}

read_palette() {
  local line key value

  [[ -r "$PALETTE" ]] || fail "no se puede leer la paleta: $PALETTE"
  declare_schema
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" && "$line" != \#* ]] || continue
    [[ "$line" == *=* ]] || fail "línea inválida en la paleta: $line"
    key=${line%%=*}
    value=${line#*=}
    [[ -v "EXPECTED[$key]" ]] || fail "clave desconocida en la paleta: $key"
    [[ ! -v "COLORS[$key]" ]] || fail "clave duplicada en la paleta: $key"
    COLORS["$key"]=$value
  done < "$PALETTE"

  for key in "${!EXPECTED[@]}"; do
    [[ -v "COLORS[$key]" ]] || fail "falta la clave de paleta: $key"
  done

  [[ "${COLORS[schema]}" == 1 ]] || fail 'schema de paleta no soportado'
  [[ "${COLORS[id]}" =~ ^[a-z0-9]+([._-][a-z0-9]+)*$ ]] || \
    fail 'id de paleta inseguro'
  [[ "${COLORS[id]}" == "$THEME_ID" ]] || fail 'el id no coincide con el tema solicitado'
  [[ "${COLORS[family]}" =~ ^[a-z0-9-]+$ ]] || fail 'familia inválida'
  [[ "${COLORS[flavour]}" =~ ^[a-z0-9-]+$ ]] || fail 'flavour inválido'
  [[ "${COLORS[accent_name]}" =~ ^[a-z0-9-]+$ ]] || fail 'accent_name inválido'

  for key in "${!COLORS[@]}"; do
    case "$key" in
      schema|id|family|flavour|accent_name)
        ;;
      *)
        [[ "${COLORS[$key]}" =~ ^#[0-9a-f]{6}$ ]] || \
          fail "color inválido para $key"
        ;;
    esac
  done
}

rgb() {
  printf '%s' "${COLORS[$1]#\#}"
}

write_lines() {
  local destination=$1
  shift
  printf '%s\n' "$@" > "$destination"
}

render_mango() {
  write_lines "$1/mango.conf" \
    '# Generated by mango-theme. Do not edit.' \
    "bordercolor=0x$(rgb surface2)ff" \
    "focuscolor=0x$(rgb accent)ff" \
    "urgentcolor=0x$(rgb urgent)ff" \
    "scratchpadcolor=0x$(rgb blue)ff" \
    "globalcolor=0x$(rgb mauve)ff"
}

render_foot() {
  write_lines "$1/foot.ini" \
    '# Generated by mango-theme. Do not edit.' \
    '[main]' \
    'font=JetBrainsMono Nerd Font:size=10' \
    'pad=10x8' \
    'term=xterm-256color' \
    '' \
    '[scrollback]' \
    'lines=10000' \
    'multiplier=3.0' \
    '' \
    '[colors-dark]' \
    'alpha=1.0' \
    "background=$(rgb base)" \
    "foreground=$(rgb text)" \
    "cursor=$(rgb base) $(rgb accent)" \
    "regular0=$(rgb surface1)" \
    "regular1=$(rgb red)" \
    "regular2=$(rgb green)" \
    "regular3=$(rgb yellow)" \
    "regular4=$(rgb blue)" \
    "regular5=$(rgb pink)" \
    "regular6=$(rgb teal)" \
    "regular7=$(rgb subtext1)" \
    "bright0=$(rgb surface2)" \
    "bright1=$(rgb red)" \
    "bright2=$(rgb green)" \
    "bright3=$(rgb yellow)" \
    "bright4=$(rgb blue)" \
    "bright5=$(rgb pink)" \
    "bright6=$(rgb teal)" \
    "bright7=$(rgb text)" \
    "selection-foreground=$(rgb text)" \
    "selection-background=$(rgb surface2)"
}

render_fuzzel() {
  write_lines "$1/fuzzel.ini" \
    '# Generated by mango-theme. Do not edit.' \
    '[main]' \
    'font=JetBrainsMono Nerd Font:size=11' \
    'terminal=foot' \
    'prompt=❯ ' \
    'layer=overlay' \
    'lines=10' \
    'width=45' \
    'horizontal-pad=16' \
    'vertical-pad=10' \
    '' \
    '[border]' \
    'width=2' \
    'radius=10' \
    '' \
    '[colors]' \
    "background=$(rgb base)f2" \
    "text=$(rgb text)ff" \
    "prompt=$(rgb accent)ff" \
    "placeholder=$(rgb overlay0)ff" \
    "input=$(rgb text)ff" \
    "match=$(rgb pink)ff" \
    "selection=$(rgb surface1)ff" \
    "selection-text=$(rgb text)ff" \
    "selection-match=$(rgb pink)ff" \
    "counter=$(rgb overlay1)ff" \
    "border=$(rgb accent)ff"
}

render_mako() {
  write_lines "$1/mako.conf" \
    '# Generated by mango-theme. Do not edit.' \
    'font=JetBrainsMono Nerd Font 10' \
    "background-color=${COLORS[base]}f2" \
    "text-color=${COLORS[text]}" \
    "border-color=${COLORS[accent]}" \
    "progress-color=over ${COLORS[surface1]}" \
    'border-size=2' \
    'border-radius=10' \
    'padding=12' \
    'margin=10' \
    'width=360' \
    'height=120' \
    'max-visible=5' \
    'default-timeout=5000' \
    'icons=1' \
    '' \
    '[urgency=critical]' \
    "border-color=${COLORS[urgent]}" \
    'default-timeout=0'
}

render_swaylock() {
  write_lines "$1/swaylock.conf" \
    '# Generated by mango-theme. Do not edit.' \
    'clock' \
    'timestr=%H:%M' \
    'datestr=%a, %d %b %Y' \
    'show-failed-attempts' \
    'ignore-empty-password' \
    'indicator-idle-visible' \
    'font=JetBrainsMono Nerd Font' \
    'indicator-radius=120' \
    'indicator-thickness=10' \
    "color=$(rgb base)" \
    "bs-hl-color=$(rgb rosewater)" \
    "caps-lock-bs-hl-color=$(rgb rosewater)" \
    "caps-lock-key-hl-color=$(rgb green)" \
    "inside-color=$(rgb base)" \
    "inside-clear-color=$(rgb base)" \
    "inside-caps-lock-color=$(rgb base)" \
    "inside-ver-color=$(rgb base)" \
    "inside-wrong-color=$(rgb base)" \
    "key-hl-color=$(rgb accent)" \
    'layout-bg-color=00000000' \
    'layout-border-color=00000000' \
    "layout-text-color=$(rgb text)" \
    'line-color=00000000' \
    'line-clear-color=00000000' \
    'line-caps-lock-color=00000000' \
    'line-ver-color=00000000' \
    'line-wrong-color=00000000' \
    "ring-color=$(rgb surface0)" \
    "ring-clear-color=$(rgb rosewater)" \
    "ring-caps-lock-color=$(rgb peach)" \
    "ring-ver-color=$(rgb blue)" \
    "ring-wrong-color=$(rgb maroon)" \
    'separator-color=00000000' \
    "text-color=$(rgb text)" \
    "text-clear-color=$(rgb rosewater)" \
    "text-caps-lock-color=$(rgb peach)" \
    "text-ver-color=$(rgb blue)" \
    "text-wrong-color=$(rgb maroon)"
}

render_waybar() {
  write_lines "$1/waybar.css" \
    '/* Generated by mango-theme. Do not edit. */' \
    "@define-color background ${COLORS[background]};" \
    "@define-color background_alt ${COLORS[background_alt]};" \
    "@define-color surface ${COLORS[surface]};" \
    "@define-color surface_hover ${COLORS[surface_hover]};" \
    "@define-color foreground ${COLORS[foreground]};" \
    "@define-color muted ${COLORS[foreground_muted]};" \
    "@define-color accent ${COLORS[accent]};" \
    "@define-color urgent ${COLORS[urgent]};" \
    '* {' \
    '  border: none;' \
    '  border-radius: 0;' \
    '  min-height: 0;' \
    '  font-family: "JetBrainsMono Nerd Font", monospace;' \
    '  font-size: 12px;' \
    '}' \
    'window#waybar {' \
    '  background: alpha(@background, 0.94);' \
    '  color: @foreground;' \
    '}' \
    '#tags button, #workspaces button, #window, #clock, #mpris,' \
    '#wireplumber, #network, #battery, #tray, #idle_inhibitor, #custom-power {' \
    '  padding: 0 10px;' \
    '  margin: 4px 2px;' \
    '  border-radius: 8px;' \
    '  background: @surface;' \
    '}' \
    '#tags button, #workspaces button { color: @muted; }' \
    '#tags button.occupied, #workspaces button.occupied, #workspaces button.visible {' \
    '  color: @foreground;' \
    '  background: alpha(@accent, 0.18);' \
    '  border-bottom: 2px solid @accent;' \
    '}' \
    '#tags button.focused, #tags button.active, #tags button.selected,' \
    '#workspaces button.focused, #workspaces button.active, #workspaces button.selected {' \
    '  color: @background;' \
    '  background: @accent;' \
    '}' \
    '#tags button.urgent, #workspaces button.urgent, #battery.critical {' \
    '  color: @background;' \
    '  background: @urgent;' \
    '}' \
    '#tags button:hover, #workspaces button:hover { background: @surface_hover; color: @foreground; }' \
    '#custom-power { color: @accent; }'
}

render_wlogout() {
  write_lines "$1/wlogout.css" \
    '/* Generated by mango-theme. Do not edit. */' \
    '* {' \
    '  background-image: none;' \
    '  box-shadow: none;' \
    '}' \
    "window { background-color: alpha(${COLORS[background_deep]}, 0.90); }" \
    'button {' \
    "  color: ${COLORS[foreground]};" \
    "  background-color: ${COLORS[surface]};" \
    "  border: 2px solid ${COLORS[surface_hover]};" \
    '  border-radius: 16px;' \
    '  margin: 12px;' \
    '  font: 18px "JetBrainsMono Nerd Font";' \
    '  background-repeat: no-repeat;' \
    '  background-position: center;' \
    '  background-size: 28%;' \
    '  outline-style: none;' \
    '  outline-width: 0;' \
    '  box-shadow: none;' \
    '}' \
    "button:focus, button:hover, button:active {" \
    "  background-color: ${COLORS[surface_hover]};" \
    "  border: 2px solid ${COLORS[accent]};" \
    '  outline-style: none;' \
    '  outline-width: 0;' \
    '  box-shadow: none;' \
    '}' \
    '#lock { background-image: image(url("/usr/share/wlogout/icons/lock.png"), url("/usr/share/wlogout/assets/lock.svg"), url("/usr/local/share/wlogout/icons/lock.png")); }' \
    '#logout { background-image: image(url("/usr/share/wlogout/icons/logout.png"), url("/usr/share/wlogout/assets/logout.svg"), url("/usr/local/share/wlogout/icons/logout.png")); }' \
    '#suspend { background-image: image(url("/usr/share/wlogout/icons/suspend.png"), url("/usr/share/wlogout/assets/suspend.svg"), url("/usr/local/share/wlogout/icons/suspend.png")); }' \
    '#reboot { background-image: image(url("/usr/share/wlogout/icons/reboot.png"), url("/usr/share/wlogout/assets/reboot.svg"), url("/usr/local/share/wlogout/icons/reboot.png")); }' \
    '#shutdown { background-image: image(url("/usr/share/wlogout/icons/shutdown.png"), url("/usr/share/wlogout/assets/shutdown.svg"), url("/usr/local/share/wlogout/icons/shutdown.png")); }'
}

render_satty() {
  mkdir -p -- "$1/xdg-config/satty"
  write_lines "$1/xdg-config/satty/config.toml" \
    '# Generated by mango-theme. Do not edit.' \
    '[general]' \
    'fullscreen = false' \
    'early-exit = true' \
    'initial-tool = "brush"' \
    'copy-command = "wl-copy"' \
    'actions-on-enter = ["save-to-clipboard", "save-to-file"]' \
    'actions-on-escape = ["exit"]' \
    "custom-colors = [\"${COLORS[accent]}\", \"${COLORS[urgent]}\", \"${COLORS[yellow]}\", \"${COLORS[green]}\", \"${COLORS[blue]}\", \"${COLORS[text]}\"]"
}

render_all() {
  local destination=$1

  mkdir -p -- "$destination"
  render_mango "$destination"
  render_foot "$destination"
  render_fuzzel "$destination"
  render_mako "$destination"
  render_swaylock "$destination"
  render_waybar "$destination"
  render_wlogout "$destination"
  render_satty "$destination"
  write_lines "$destination/background" "${COLORS[background]}"
  write_lines "$destination/metadata" \
    'schema=1' \
    "id=${COLORS[id]}" \
    "family=${COLORS[family]}" \
    "flavour=${COLORS[flavour]}" \
    "accent_name=${COLORS[accent_name]}"
}

validate_outputs() {
  local destination=$1
  local required

  for required in mango.conf foot.ini fuzzel.ini mako.conf swaylock.conf \
    waybar.css wlogout.css xdg-config/satty/config.toml background metadata; do
    [[ -s "$destination/$required" ]] || fail "output de tema vacío o ausente: $required"
  done
  grep -Fxq 'ignore-empty-password' "$destination/swaylock.conf" || \
    fail 'Swaylock no rechaza passwords vacíos'
  grep -Fq "${COLORS[accent]}" "$destination/waybar.css" || \
    fail 'Waybar no recibió el acento del tema'
  grep -Fxq "id=${COLORS[id]}" "$destination/metadata" || \
    fail 'metadata de tema inconsistente'
}

promote() {
  local revision=$1
  local next_link="$THEME_ROOT/.current.$$"

  ln -s -- "$revision" "$next_link"
  mv -Tf -- "$next_link" "$THEME_ROOT/current"
}

render_theme() {
  local digest revision

  mkdir -p -- "$THEME_ROOT"
  command -v flock >/dev/null 2>&1 || fail 'flock es necesario para renderizar temas'
  exec 9>"$THEME_ROOT/render.guard"
  flock 9
  digest=$(sha256sum -- "$PALETTE" "$SCRIPT_PATH" | sha256sum)
  digest=${digest%% *}
  revision="${COLORS[id]}-${digest:0:12}"

  if [[ ! -d "$THEME_ROOT/$revision" ]]; then
    RENDER_TEMP=$(mktemp -d "$THEME_ROOT/.render.XXXXXX")
    render_all "$RENDER_TEMP"
    validate_outputs "$RENDER_TEMP"
    chmod -R u=rwX,go=rX -- "$RENDER_TEMP"
    mv -- "$RENDER_TEMP" "$THEME_ROOT/$revision"
    RENDER_TEMP=''
  else
    validate_outputs "$THEME_ROOT/$revision"
  fi

  promote "$revision"
  printf '%s\n' "$THEME_ROOT/$revision"
}

main() {
  local command=${1:-render}

  (( $# <= 1 )) || {
    usage >&2
    exit 2
  }
  read_palette
  case "$command" in
    render)
      render_theme
      ;;
    validate)
      printf 'OK: %s\n' "$PALETTE"
      ;;
    path)
      [[ -d "$THEME_ROOT/current" ]] || fail 'el tema todavía no fue renderizado'
      printf '%s\n' "$THEME_ROOT/current"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
