#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_PATH=$(realpath -m -- "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/../../../.." && pwd -P)
THEME_ID=${MANGOWM_THEME:-catppuccin-mocha-pink}
PALETTE="$REPO_ROOT/themes/$THEME_ID/palette.conf"
STATE_HOME=${XDG_STATE_HOME:-"$HOME/.local/state"}
THEME_ROOT="$STATE_HOME/mangowm/theme"
RENDER_TEMP=''

declare -A COLORS=()
declare -A EXPECTED=()

fail() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

cleanup_render() {
  if [[ -n "$RENDER_TEMP" && "$RENDER_TEMP" == "$THEME_ROOT"/.render.* && \
        -d "$RENDER_TEMP" ]]; then
    find "$RENDER_TEMP" -mindepth 1 -delete
    find "$RENDER_TEMP" -depth -type d -empty -delete
  fi
}
trap cleanup_render EXIT

usage() {
  printf 'Uso: %s render|validate|path\n' "$PROGRAM_NAME"
}

declare_schema() {
  local key

  for key in \
    schema id family flavour accent_name \
    rosewater flamingo pink mauve red maroon peach yellow green teal sky \
    sapphire blue lavender text subtext1 subtext0 overlay2 overlay1 overlay0 \
    surface2 surface1 surface0 base mantle crust background background_alt \
    background_deep surface surface_hover foreground foreground_muted accent \
    urgent warning success; do
    EXPECTED["$key"]=1
  done
}

read_palette() {
  local line key value

  [[ -r "$PALETTE" ]] || fail "no se puede leer la paleta: $PALETTE"
  declare_schema
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" && "$line" != \#* ]] || continue
    [[ "$line" == *=* ]] || fail "línea inválida en la paleta: $line"
    key=${line%%=*}
    value=${line#*=}
    [[ -v "EXPECTED[$key]" ]] || fail "clave desconocida en la paleta: $key"
    [[ ! -v "COLORS[$key]" ]] || fail "clave duplicada en la paleta: $key"
    COLORS["$key"]=$value
  done < "$PALETTE"

  for key in "${!EXPECTED[@]}"; do
    [[ -v "COLORS[$key]" ]] || fail "falta la clave de paleta: $key"
  done

  [[ "${COLORS[schema]}" == 1 ]] || fail 'schema de paleta no soportado'
  [[ "${COLORS[id]}" =~ ^[a-z0-9]+([._-][a-z0-9]+)*$ ]] || \
    fail 'id de paleta inseguro'
  [[ "${COLORS[id]}" == "$THEME_ID" ]] || fail 'el id no coincide con el tema solicitado'
  [[ "${COLORS[family]}" =~ ^[a-z0-9-]+$ ]] || fail 'familia inválida'
  [[ "${COLORS[flavour]}" =~ ^[a-z0-9-]+$ ]] || fail 'flavour inválido'
  [[ "${COLORS[accent_name]}" =~ ^[a-z0-9-]+$ ]] || fail 'accent_name inválido'

  for key in "${!COLORS[@]}"; do
    case "$key" in
      schema|id|family|flavour|accent_name)
        ;;
      *)
        [[ "${COLORS[$key]}" =~ ^#[0-9a-f]{6}$ ]] || \
          fail "color inválido para $key"
        ;;
    esac
  done
}

rgb() {
  printf '%s' "${COLORS[$1]#\#}"
}

write_lines() {
  local destination=$1
  shift
  printf '%s\n' "$@" > "$destination"
}

render_mango() {
  write_lines "$1/mango.conf" \
    '# Generated by mango-theme. Do not edit.' \
    "bordercolor=0x$(rgb surface2)ff" \
    "focuscolor=0x$(rgb accent)ff" \
    "urgentcolor=0x$(rgb urgent)ff" \
    "scratchpadcolor=0x$(rgb blue)ff" \
    "globalcolor=0x$(rgb mauve)ff"
}

render_foot() {
  write_lines "$1/foot.ini" \
    '# Generated by mango-theme. Do not edit.' \
    '[main]' \
    'font=JetBrainsMono Nerd Font:size=10' \
    'pad=10x8' \
    'term=xterm-256color' \
    '' \
    '[scrollback]' \
    'lines=10000' \
    'multiplier=3.0' \
    '' \
    '[colors-dark]' \
    'alpha=1.0' \
    "background=$(rgb base)" \
    "foreground=$(rgb text)" \
    "cursor=$(rgb base) $(rgb accent)" \
    "regular0=$(rgb surface1)" \
    "regular1=$(rgb red)" \
    "regular2=$(rgb green)" \
    "regular3=$(rgb yellow)" \
    "regular4=$(rgb blue)" \
    "regular5=$(rgb pink)" \
    "regular6=$(rgb teal)" \
    "regular7=$(rgb subtext1)" \
    "bright0=$(rgb surface2)" \
    "bright1=$(rgb red)" \
    "bright2=$(rgb green)" \
    "bright3=$(rgb yellow)" \
    "bright4=$(rgb blue)" \
    "bright5=$(rgb pink)" \
    "bright6=$(rgb teal)" \
    "bright7=$(rgb text)" \
    "selection-foreground=$(rgb text)" \
    "selection-background=$(rgb surface2)"
}

