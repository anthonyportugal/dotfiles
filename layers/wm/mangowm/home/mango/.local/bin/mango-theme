#!/usr/bin/env bash
# MangoWM front end for the shared theme engine (dotfiles-theme, desktop
# layer). `menu` opens the fuzzel picker (family -> flavour -> accent, driven
# by `dotfiles-theme menu`); every other command is forwarded.

set -Eeuo pipefail

SELF=$(realpath -- "${BASH_SOURCE[0]}")
# Both scripts are stowed side by side in ~/.local/bin; prefer that engine.
ENGINE="${BASH_SOURCE[0]%/*}/dotfiles-theme"
[[ -x "$ENGINE" ]] || ENGINE="$HOME/.local/bin/dotfiles-theme"
[[ -x "$ENGINE" ]] || ENGINE=dotfiles-theme

# One level of the engine's picker: entries on stdin, the prompt in $1.
menu_level() {
  local entries count

  # shellcheck source-path=SCRIPTDIR source=../lib/mangowm/common
  source "$HOME/.local/lib/mangowm/common"
  entries=$(cat)
  count=$(grep -c '' <<< "$entries")
  (( count <= 15 )) || count=15
  mangowm_menu "$1" --lines="$count" <<< "$entries"
}

case "${1:-render}" in
  menu)
    exec "$ENGINE" menu "$SELF" menu-level
    ;;
  menu-level)
    (( $# == 2 )) || exit 2
    menu_level "$2"
    ;;
  *)
    (( $# > 0 )) || set -- render
    exec "$ENGINE" "$@"
    ;;
esac
