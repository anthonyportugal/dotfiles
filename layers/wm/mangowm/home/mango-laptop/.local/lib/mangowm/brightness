#!/usr/bin/env bash

set -Eeuo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/mangowm/common"

mangowm_require brightnessctl
case "${1-}" in
  up)
    exec brightnessctl --class=backlight set +5%
    ;;
  down)
    exec brightnessctl --class=backlight set 5%-
    ;;
  *)
    printf 'Uso: %s up|down\n' "${0##*/}" >&2
    exit 2
    ;;
esac
