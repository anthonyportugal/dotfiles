#!/usr/bin/env bash
# Live bspwm reload run by `dotfiles-theme set` after promoting a theme. The
# engine already synced the GNOME accent; this only applies the bspwm part:
# border colors and the cursor from the rendered bspwm.env, then Polybar and
# Dunst restarts.

set -Eeuo pipefail

THEME_DIR=${DOTFILES_THEME_DIR:?DOTFILES_THEME_DIR no está definido}/bspwm
BSPWM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bspwm"

reload_borders() {
  local BSPWM_FOCUSED_BORDER='' BSPWM_ACTIVE_BORDER='' BSPWM_NORMAL_BORDER=''
  local BSPWM_PRESEL_BORDER=''

  command -v bspc >/dev/null 2>&1 || return 0
  [[ -r "$THEME_DIR/bspwm.env" ]] || return 0
  # shellcheck source=/dev/null
  source "$THEME_DIR/bspwm.env"
  bspc config focused_border_color "$BSPWM_FOCUSED_BORDER" 2>/dev/null || true
  bspc config active_border_color "$BSPWM_ACTIVE_BORDER" 2>/dev/null || true
  bspc config normal_border_color "$BSPWM_NORMAL_BORDER" 2>/dev/null || true
  bspc config presel_feedback_color "$BSPWM_PRESEL_BORDER" 2>/dev/null || true
}

# Xcursor resources apply to clients started from now on; xsetroot reloads
# the root window cursor right away.
reload_cursor() {
  local BSPWM_CURSOR_THEME='' BSPWM_CURSOR_SIZE=''

  [[ -r "$THEME_DIR/bspwm.env" ]] || return 0
  # shellcheck source=/dev/null
  source "$THEME_DIR/bspwm.env"
  [[ -n "$BSPWM_CURSOR_THEME" ]] || return 0
  if command -v xrdb >/dev/null 2>&1; then
    printf 'Xcursor.theme: %s\nXcursor.size: %s\n' \
      "$BSPWM_CURSOR_THEME" "${BSPWM_CURSOR_SIZE:-24}" | xrdb -merge 2>/dev/null || true
  fi
  if command -v xsetroot >/dev/null 2>&1; then
    xsetroot -cursor_name left_ptr 2>/dev/null || true
  fi
}

reload_polybar() {
  if [[ -x "$BSPWM_DIR/scripts/launch-polybar" ]] && \
     pgrep -u "$UID" -x polybar >/dev/null 2>&1; then
    "$BSPWM_DIR/scripts/launch-polybar" >/dev/null 2>&1 &
  fi
}

reload_dunst() {
  pgrep -u "$UID" -x dunst >/dev/null 2>&1 || return 0
  pkill -TERM -u "$UID" -x dunst 2>/dev/null || true
  if command -v dunst >/dev/null 2>&1 && [[ -r "$THEME_DIR/dunstrc" ]]; then
    dunst --config "$THEME_DIR/dunstrc" >/dev/null 2>&1 &
  fi
}

reload_borders
reload_cursor
reload_polybar
reload_dunst
