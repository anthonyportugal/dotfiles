#!/usr/bin/env bash

set -Eeuo pipefail

BSPWM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bspwm"
if [[ -r "$BSPWM_DIR/local.env" ]]; then
  # shellcheck source=/dev/null
  source "$BSPWM_DIR/local.env"
fi

temp="${BSPWM_NIGHT_TEMPERATURE:-3500}"
command_name="${1:-toggle}"

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/bspwm-$UID"
mkdir -p "$runtime_dir"
state_file="$runtime_dir/nightlight.state"

is_enabled() {
  [[ -f "$state_file" ]] && [[ "$(<"$state_file")" == "on" ]]
}

notify_polybar() {
  if command -v polybar-msg >/dev/null 2>&1; then
    polybar-msg action "#nightlight.hook.0" 2>/dev/null || true
  fi
}

enable() {
  if ! command -v gammastep >/dev/null 2>&1; then
    if command -v notify-send >/dev/null 2>&1; then
      notify-send "Luz Nocturna" "gammastep no está instalado"
    fi
    printf 'bspwm-nightlight: gammastep no está instalado\n' >&2
    exit 127
  fi
  pkill -9 -x gammastep 2>/dev/null || true
  sleep 0.05
  # -P replaces any previous gamma ramp instead of stacking on top of it.
  gammastep -m randr -P -O "$temp" >/dev/null 2>&1 &

  printf 'on\n' > "$state_file"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -h string:x-dunst-stack-tag:bspwm-nightlight "Luz Nocturna" "Activada (${temp}K)"
  fi
  notify_polybar
}

disable() {
  pkill -x gammastep 2>/dev/null || true
  # A redshift started before the switch to gammastep keeps its gamma ramp.
  pkill -x redshift 2>/dev/null || true
  if command -v gammastep >/dev/null 2>&1; then
    gammastep -m randr -x >/dev/null 2>&1 || true
  fi
  rm -f "$state_file"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -h string:x-dunst-stack-tag:bspwm-nightlight "Luz Nocturna" "Desactivada"
  fi
  notify_polybar
}

status_polybar() {
  if is_enabled; then
    printf '%%{F#F9E2AF}%%{T2}󰖔%%{T-} %sK%%{F-}\n' "$temp"
  else
    printf '%%{F#6C7086}%%{T2}󰖔%%{T-} off%%{F-}\n'
  fi
}

case "$command_name" in
  on)
    enable
    ;;
  off)
    disable
    ;;
  toggle)
    if is_enabled; then
      disable
    else
      enable
    fi
    ;;
  status|polybar)
    status_polybar
    ;;
  restore)
    rm -f "$state_file"
    pkill -x gammastep 2>/dev/null || true
    pkill -x redshift 2>/dev/null || true
    ;;
  *)
    printf 'Uso: %s toggle|on|off|status|restore\n' "${0##*/}" >&2
    exit 2
    ;;
esac
