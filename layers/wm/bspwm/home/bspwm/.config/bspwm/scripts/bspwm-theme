#!/usr/bin/env bash
# bspwm front end for the shared theme engine (dotfiles-theme, desktop layer).
# `menu` opens the Rofi theme picker (family -> flavour -> accent, driven by
# `dotfiles-theme menu`); every other command is forwarded.

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}

fail() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

usage() {
  cat <<HELP
Uso: $PROGRAM_NAME <comando> [argumentos]

Comandos (todos salvo menu los ejecuta dotfiles-theme):
  list [--tsv]      Lista todos los temas (--tsv: familia, flavour, acento...)
  current           Muestra el tema actualmente activo
  set <id>          Compila y aplica un tema (Catppuccin Mocha o Sanctuary)
  menu              Abre el selector de temas con Rofi: familia, flavour y
                    acento con muestras de color; Esc vuelve un nivel
  render [id]       Compila un tema a estado local sin activarlo
  validate [id]     Valida la sintaxis e integridad de una paleta
  path              Muestra la ruta del tema compilado activo
HELP
}

engine() {
  if command -v dotfiles-theme >/dev/null 2>&1; then
    printf '%s\n' dotfiles-theme
  elif [[ -x "$HOME/.local/bin/dotfiles-theme" ]]; then
    printf '%s\n' "$HOME/.local/bin/dotfiles-theme"
  else
    fail "no se encontró dotfiles-theme; enlaza la capa desktop"
  fi
}

# One level of the engine's picker (`dotfiles-theme menu`): entries
# "label<US>icon<TAB>value" on stdin, the prompt in $1. Rofi shows each label
# with its swatch icon and returns the row index; the value goes to stdout.
menu_level() {
  local prompt=$1 entry label index lines
  local rofi_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bspwm/themes/catppuccin/rofi"
  local colors="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/theme/current/bspwm/rofi-colors.rasi"
  local -a values=() labels=() icons=() rofi_args

  command -v rofi >/dev/null 2>&1 || fail "rofi es necesario para abrir el menú interactivo"
  while IFS= read -r entry || [[ -n "$entry" ]]; do
    label=${entry%%$'\t'*}
    values+=("${entry#*$'\t'}")
    labels+=("${label%%$'\x1f'*}")
    if [[ "$label" == *$'\x1f'* ]]; then
      icons+=("${label#*$'\x1f'}")
    else
      icons+=('')
    fi
  done
  lines=${#labels[@]}
  (( lines <= 15 )) || lines=15
  rofi_args=(
    -dmenu
    -i
    -format i
    -p "${prompt%"${prompt##*[! ]}"}"
    -mesg "Esc vuelve al nivel anterior"
    -theme "$rofi_dir/launcher.rasi"
  )
  if [[ -r "$colors" ]]; then
    rofi_args+=(-theme-str "@import \"$colors\"")
  fi
  rofi_args+=(-theme-str "configuration { show-icons: true; } window { width: 420px; } listview { lines: $lines; } element-icon { size: 28px; }")

  index=$(for index in "${!labels[@]}"; do
      printf '%s\0icon\x1f%s\n' "${labels[index]}" "${icons[index]}"
    done | rofi "${rofi_args[@]}") || return 1
  [[ "$index" =~ ^[0-9]+$ ]] && (( index < ${#values[@]} )) || return 1
  printf '%s\n' "${values[index]}"
}

main() {
  local command_name=${1:-help} bin

  case "$command_name" in
    menu)
      bin=$(engine)
      exec "$bin" menu "$(realpath -- "${BASH_SOURCE[0]}")" menu-level
      ;;
    menu-level)
      (( $# == 2 )) || exit 2
      menu_level "$2"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      bin=$(engine)
      exec "$bin" "$@"
      ;;
  esac
}

main "$@"
