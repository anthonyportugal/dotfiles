#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Renders the shared theme after linking bspwm, so its templates reach
# ~/.local/state/dotfiles/theme/current/bspwm even when only bspwm changed.
# Run by bin/dotfiles through run_layer_hook (see lib/layers.sh).

set -Eeuo pipefail

# Read by lib/colors.sh as the log prefix.
# shellcheck disable=SC2034
PROGRAM_NAME=bspwm
# shellcheck source=../../../../lib/colors.sh
source "$DOTFILES_LIB/colors.sh"
# shellcheck source=../../../../lib/core.sh
source "$DOTFILES_LIB/core.sh"

render_theme() {
  local engine="$TARGET_DIR/.local/bin/dotfiles-theme"

  [[ "$PROFILE" == desktop && "$APPLY" == 1 ]] || return 0
  if [[ ! -x "$engine" ]]; then
    warn "no se encontró el motor de temas: $engine"
    return 0
  fi
  if ! HOME="$TARGET_DIR" XDG_STATE_HOME="$TARGET_DIR/.local/state" \
    XDG_DATA_HOME="$TARGET_DIR/.local/share" XDG_CONFIG_HOME="$TARGET_DIR/.config" \
    "$engine" render >/dev/null; then
    die "no se pudo renderizar el tema de bspwm en $TARGET_DIR"
  fi
  info "Tema de bspwm renderizado en $TARGET_DIR/.local/state/dotfiles/theme/current/bspwm"
}

render_theme
