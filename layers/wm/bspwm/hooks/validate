#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Validates the bspwm layer before it is linked, checked or unlinked.
# Run by bin/dotfiles through run_layer_hook (see lib/layers.sh).

set -Eeuo pipefail

# Read by lib/colors.sh as the log prefix.
# shellcheck disable=SC2034
PROGRAM_NAME=bspwm
# shellcheck source=../../../../lib/colors.sh
source "$DOTFILES_LIB/colors.sh"
# shellcheck source=../../../../lib/core.sh
source "$DOTFILES_LIB/core.sh"
# shellcheck source=../../../../lib/layers.sh
source "$DOTFILES_LIB/layers.sh"

STOW_DIR="$LAYER_DIR/home"
# Resolving the packages validates the profile and the manifests; the checks
# below then inspect the single bspwm package directly.
# shellcheck disable=SC2034
declare -a STOW_PACKAGES=()
read_layer_stow_packages "$LAYER_DIR" "$PROFILE" STOW_PACKAGES

validate_stow_scope() {
  local package_root="$STOW_DIR/bspwm"
  local config_parent="$package_root/.config"
  local owned_root="$config_parent/bspwm"
  local theme_root="$package_root/.local/share/dotfiles/theme"
  local source_path unexpected_path=''

  [[ -d "$owned_root" ]] || {
    error "falta el paquete Stow de bspwm: $owned_root"
    return 1
  }
  while IFS= read -r -d '' source_path; do
    case "$source_path" in
      "$config_parent"|"$owned_root"|"$owned_root"/*)
        ;;
      # Theme templates and the reload hook live in the shared engine's
      # namespace, one bspwm entry each.
      "$package_root/.local"|"$package_root/.local/share"|\
      "$package_root/.local/share/dotfiles"|"$theme_root"|\
      "$theme_root/templates"|"$theme_root/templates/bspwm"|\
      "$theme_root/templates/bspwm"/*|"$theme_root/reload.d"|\
      "$theme_root/reload.d/bspwm")
        ;;
      *)
        unexpected_path=$source_path
        break
        ;;
    esac
  done < <(find "$package_root" -mindepth 1 -print0)

  if [[ -n "$unexpected_path" ]]; then
    error "contenido fuera del ownership de bspwm: ${unexpected_path#"$package_root"/}"
    return 1
  fi

  info "Ownership Stow validado: .config/bspwm y las plantillas de tema de bspwm"
  return 0
}

validate_session_sources() {
  local config_root="$STOW_DIR/bspwm/.config/bspwm"
  local config_path
  local result=0
  local checked=0
  local -a config_paths=("$config_root/bspwmrc")

  [[ -d "$config_root/scripts" ]] || {
    error "falta el directorio de scripts de sesión: $config_root/scripts"
    return 1
  }
  while IFS= read -r -d '' config_path; do
    config_paths+=("$config_path")
  done < <(find "$config_root/scripts" -type f -print0)

  for config_path in "${config_paths[@]}"; do
    if ! bash -n "$config_path"; then
      error "sintaxis Bash inválida: $config_path"
      result=1
    fi
    if [[ ! -x "$config_path" ]]; then
      error "el entrypoint de sesión no es ejecutable: $config_path"
      result=1
    fi
    checked=$(( checked + 1 ))
  done

  if command_exists polybar; then
    if ! BSPWM_POLYBAR_CENTER='date tray' \
      BSPWM_POLYBAR_RIGHT='pulseaudio memory filesystem xkeyboard' \
      polybar --config="$config_root/themes/catppuccin/polybar/config.ini" \
        --dump=background main >/dev/null; then
      error "Polybar no pudo analizar su configuración"
      result=1
    fi
  fi

  if command_exists rofi; then
    local rofi_theme
    for rofi_theme in launcher powermenu confirm; do
      if ! rofi -no-config \
        -theme "$config_root/themes/catppuccin/rofi/$rofi_theme.rasi" \
        -dump-theme >/dev/null 2>&1; then
        error "Rofi no pudo analizar el tema $rofi_theme.rasi"
        result=1
      fi
    done
  fi

  (( result == 0 )) && info "Fuentes de sesión validadas ($checked scripts Bash)"
  return "$result"
}

# Renders the bspwm templates with the repository engine into a throwaway
# home and checks the accent reaches every themed component.
validate_theme_templates() {
  local engine="$LAYER_DIR/../../desktop/home/theme/.local/bin/dotfiles-theme"
  local theme_root="$STOW_DIR/bspwm/.local/share/dotfiles/theme"
  local reload_hook="$theme_root/reload.d/bspwm"
  local palette="$LAYER_DIR/../../../themes/palettes/catppuccin-mocha-pink.conf"
  local scratch accent output component result=0

  if [[ ! -x "$reload_hook" ]] || ! bash -n "$reload_hook"; then
    error "el hook de recarga de tema no es un script Bash ejecutable: $reload_hook"
    result=1
  fi
  [[ -x "$engine" ]] || {
    error "no se encontró el motor de temas: $engine"
    return 1
  }
  accent=$(sed -n 's/^accent=//p' "$palette")
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/bspwm-theme-validate.XXXXXX")
  mkdir -p "$scratch/.local/share/dotfiles/theme/templates"
  ln -s "$theme_root/templates/bspwm" "$scratch/.local/share/dotfiles/theme/templates/bspwm"
  if ! env -u DOTFILES_THEME HOME="$scratch" XDG_STATE_HOME="$scratch/.local/state" \
    XDG_DATA_HOME="$scratch/.local/share" XDG_CONFIG_HOME="$scratch/.config" \
    "$engine" render catppuccin-mocha-pink >/dev/null; then
    error "el motor de temas no pudo renderizar las plantillas de bspwm"
    rm -rf -- "$scratch"
    return 1
  fi
  output="$scratch/.local/state/dotfiles/theme/current/bspwm"
  for component in polybar-colors.ini rofi-colors.rasi dunstrc; do
    if ! grep -Fq "$accent" "$output/$component"; then
      error "$component no recibió el acento del tema"
      result=1
    fi
  done
  rm -rf -- "$scratch"
  (( result == 0 )) && info "Plantillas de tema validadas (Polybar, Rofi y Dunst)"
  return "$result"
}

validate_portability() {
  local config_root="$STOW_DIR/bspwm/.config/bspwm"
  local matches

  matches=$(grep -RInE \
    '/etc/skel|/usr/share/archcraft|DP-[0-9]|HDMI-[0-9]|BAT[0-9]|amdgpu_bl[0-9]|enp[0-9]' \
    "$config_root" || true)
  if [[ -n "$matches" ]]; then
    error "se encontraron dependencias Archcraft o nombres de hardware fijos"
    printf '%s\n' "$matches" >&2
    return 1
  fi
  info "Portabilidad validada: sin rutas Archcraft ni hardware conocido codificado"
  return 0
}

# Unlinking only needs ownership; a broken config must not block its removal.
validate_stow_scope || exit 1
[[ "$OPERATION" != unlink ]] || exit 0

result=0
validate_session_sources || result=1
validate_theme_templates || result=1
validate_portability || result=1
exit "$result"
