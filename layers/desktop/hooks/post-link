#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Renders the shared theme, generates mimeapps.list and applies the GTK
# prefer-dark preference after linking the desktop layer.
# Run by bin/dotfiles through run_layer_hook (see lib/layers.sh).

set -Eeuo pipefail

# Read by lib/colors.sh as the log prefix.
# shellcheck disable=SC2034
PROGRAM_NAME=desktop
# shellcheck source=../../../lib/colors.sh
source "$DOTFILES_LIB/colors.sh"
# shellcheck source=../../../lib/core.sh
source "$DOTFILES_LIB/core.sh"
# shellcheck source=mimeapps.sh
source "$LAYER_DIR/hooks/mimeapps.sh"

apply_session_preferences() {
  local preferences="$TARGET_DIR/.local/lib/dotfiles/session-preferences"

  [[ "$PROFILE" == desktop ]] || return 0
  if ! target_is_current_home; then
    info "Preferencias de sesión omitidas: el target no es el home actual"
    return 0
  fi
  if [[ ! -x "$preferences" ]]; then
    warn "no se encontró el entrypoint de preferencias: $preferences"
    return 0
  fi
  if ! "$preferences" apply; then
    warn "no se pudo aplicar prefer-dark durante el bootstrap; MangoWM volverá a intentarlo al iniciar sesión"
    return 0
  fi
  info "Preferencia GTK validada: prefer-dark"
}

# Renders the selected theme into the target with the desktop engine, so GTK
# and Yazi never depend on a window manager having rendered it first.
render_theme() {
  local engine="$TARGET_DIR/.local/bin/dotfiles-theme"

  [[ "$PROFILE" == desktop && "$APPLY" == 1 ]] || return 0
  if [[ ! -x "$engine" ]]; then
    warn "no se encontró el motor de temas: $engine"
    return 0
  fi
  if ! HOME="$TARGET_DIR" XDG_STATE_HOME="$TARGET_DIR/.local/state" \
    XDG_DATA_HOME="$TARGET_DIR/.local/share" XDG_CONFIG_HOME="$TARGET_DIR/.config" \
    "$engine" render >/dev/null; then
    die "no se pudo renderizar el tema en $TARGET_DIR"
  fi
  info "Tema renderizado en $TARGET_DIR/.local/state/dotfiles/theme/current"
}

render_theme
if [[ "$PROFILE" == desktop && "$APPLY" == 1 ]]; then
  apply_mimeapps "$TARGET_DIR" || die "no se pudo generar mimeapps.list en $TARGET_DIR"
fi
apply_session_preferences
