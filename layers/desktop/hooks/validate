#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Validates the desktop layer: Alacritty syntax and, in doctor, prefer-dark
# and drift of the generated mimeapps.list.
# Run by bin/dotfiles through run_layer_hook (see lib/layers.sh).

set -Eeuo pipefail

# Read by lib/colors.sh as the log prefix.
# shellcheck disable=SC2034
PROGRAM_NAME=desktop
# shellcheck source=../../../lib/colors.sh
source "$DOTFILES_LIB/colors.sh"
# shellcheck source=../../../lib/core.sh
source "$DOTFILES_LIB/core.sh"
# shellcheck source=mimeapps.sh
source "$LAYER_DIR/hooks/mimeapps.sh"

STOW_DIR="$LAYER_DIR/home"

validate_alacritty_syntax() {
  local config_path="$STOW_DIR/alacritty/.config/alacritty/alacritty.toml"

  [[ "$PROFILE" == desktop ]] || return 0
  [[ -f "$config_path" ]] || {
    error "falta la configuración de Alacritty: $config_path"
    return 1
  }
  command_exists alacritty || return 0

  if ! alacritty migrate --dry-run --skip-imports \
      --config-file "$config_path" >/dev/null; then
    error "configuración de Alacritty inválida: $config_path"
    return 1
  fi
  info "Configuración de Alacritty validada"
}

validate_session_preferences() {
  local preferences="$TARGET_DIR/.local/lib/dotfiles/session-preferences"

  [[ "$PROFILE" == desktop ]] || return 0
  target_is_current_home || return 0
  [[ -x "$preferences" ]] || {
    error "falta el entrypoint de preferencias: $preferences"
    return 1
  }
  if ! "$preferences" check >/dev/null; then
    error "la preferencia GTK oscura no está aplicada; ejecute '$preferences apply'"
    return 1
  fi
  info "Preferencia GTK validada: prefer-dark"
}

[[ "$OPERATION" != unlink ]] || exit 0

result=0
validate_alacritty_syntax || result=1
if [[ "$OPERATION" == doctor ]]; then
  validate_session_preferences || result=1
  [[ "$PROFILE" != desktop ]] || check_mimeapps
fi
exit "$result"
