#!/usr/bin/env bash
# Single theme engine shared by every window manager. It parses a palette from
# themes/palettes/, renders the shared outputs (GTK, Yazi, terminals, CLI
# tools, background, metadata) plus every installed WM template directory,
# and atomically promotes the result to $XDG_STATE_HOME/dotfiles/theme/current.

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_PATH=$(realpath -- "${BASH_SOURCE[0]}")
DEFAULT_THEME=catppuccin-mocha-pink
STATE_HOME=${XDG_STATE_HOME:-"$HOME/.local/state"}
DATA_HOME=${XDG_DATA_HOME:-"$HOME/.local/share"}
CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
THEME_ROOT="$STATE_HOME/dotfiles/theme"
WM_TEMPLATES_DIR="$DATA_HOME/dotfiles/theme/templates"
RELOAD_DIR="$DATA_HOME/dotfiles/theme/reload.d"
PALETTES_DIR=''
SHARED_TEMPLATES_DIR=''
THEME_ID=''
PALETTE=''
RENDER_TEMP=''
NAME_PATTERN='^[a-z0-9]+(-[a-z0-9]+)*$'

# Palette values by key, and the value type of every schema key.
declare -A VALUES=()
declare -A KEY_TYPES=()
declare -a WM_DIRS=()

fail() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

warn() {
  printf '%s: aviso: %s\n' "$PROGRAM_NAME" "$*" >&2
}

cleanup_render() {
  if [[ -n "$RENDER_TEMP" && "$RENDER_TEMP" == "$THEME_ROOT"/.render.* && \
        -d "$RENDER_TEMP" ]]; then
    rm -rf -- "$RENDER_TEMP"
  fi
}
trap cleanup_render EXIT

usage() {
  printf 'Uso: %s render [id]|set <id>|list|current|validate [id]|path\n' "$PROGRAM_NAME"
}

# The engine is stowed as a link into the checkout; the repository is the
# first ancestor of the real script that holds themes/palettes.
locate_repo() {
  local dir=${SCRIPT_PATH%/*}

  while [[ "$dir" != / ]]; do
    if [[ -d "$dir/themes/palettes" ]]; then
      PALETTES_DIR="$dir/themes/palettes"
      SHARED_TEMPLATES_DIR="$dir/themes/templates"
      return 0
    fi
    dir=${dir%/*}
    [[ -n "$dir" ]] || dir=/
  done
  fail "no se encontró themes/palettes sobre $SCRIPT_PATH"
}

palette_path() {
  printf '%s/%s.conf\n' "$PALETTES_DIR" "$1"
}

theme_exists() {
  [[ "$1" =~ $NAME_PATTERN && -f "$(palette_path "$1")" ]]
}

resolve_theme_id() {
  if [[ -n "${DOTFILES_THEME-}" ]]; then
    printf '%s\n' "$DOTFILES_THEME"
    return 0
  fi
  local saved=''
  if [[ -r "$THEME_ROOT/selected" ]]; then
    saved=$(<"$THEME_ROOT/selected")
  fi
  if [[ -n "$saved" ]] && theme_exists "$saved"; then
    printf '%s\n' "$saved"
  else
    printf '%s\n' "$DEFAULT_THEME"
  fi
}

# Schema 2 keys and their value type: meta, color, font or cursor_*. Every key
# is required exactly once.
declare_schema() {
  local key

  for key in schema id family flavour accent_name; do
    KEY_TYPES["$key"]=meta
  done
  for key in \
    background_deep background_alt background surface surface_hover \
    surface_strong foreground foreground_muted foreground_subtle \
    foreground_disabled border accent accent_fg urgent warning success info \
    selection_bg selection_fg cursor cursor_fg \
    ansi_black ansi_red ansi_green ansi_yellow ansi_blue ansi_magenta \
    ansi_cyan ansi_white ansi_bright_black ansi_bright_red ansi_bright_green \
    ansi_bright_yellow ansi_bright_blue ansi_bright_magenta ansi_bright_cyan \
    ansi_bright_white \
    syntax_keyword syntax_string syntax_number syntax_constant \
    syntax_function syntax_type syntax_property syntax_tag syntax_operator \
    syntax_regex syntax_variable syntax_punctuation syntax_comment \
    hue_red hue_orange hue_yellow hue_green hue_teal hue_cyan hue_blue \
    hue_indigo hue_purple hue_pink hue_rose hue_maroon; do
    KEY_TYPES["$key"]=color
  done
  for key in font_mono font_text font_display font_inscription; do
    KEY_TYPES["$key"]=font
  done
  KEY_TYPES[cursor_theme]=cursor_theme
  KEY_TYPES[cursor_size]=cursor_size
}

# Fails unless the value of key $1 matches the pattern of its type. Metadata
# is checked by read_palette.
validate_value() {
  local key=$1 pattern

  case "${KEY_TYPES[$key]}" in
    color) pattern='^#[0-9a-fA-F]{6}$' ;;
    font) pattern='^[A-Za-z0-9][A-Za-z0-9 ]*$' ;;
    cursor_theme) pattern='^[A-Za-z0-9][A-Za-z0-9._-]*$' ;;
    cursor_size) pattern='^[0-9]{2,3}$' ;;
    *) return 0 ;;
  esac
  [[ "${VALUES[$key]}" =~ $pattern ]] || fail "valor inválido para $key"
}

read_palette() {
  local line key value

  THEME_ID=$1
  [[ "$THEME_ID" =~ $NAME_PATTERN ]] || fail "id de tema inseguro: $THEME_ID"
  PALETTE=$(palette_path "$THEME_ID")
  [[ -r "$PALETTE" ]] || fail "tema desconocido: $THEME_ID"
  declare_schema
  VALUES=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" && "$line" != \#* ]] || continue
    [[ "$line" == *=* ]] || fail "línea inválida en la paleta: $line"
    key=${line%%=*}
    value=${line#*=}
    # Checked before the keys so an older palette reports its schema.
    [[ "$key" != schema || "$value" == 2 ]] || fail 'schema de paleta no soportado'
    [[ -v "KEY_TYPES[$key]" ]] || fail "clave desconocida en la paleta: $key"
    [[ ! -v "VALUES[$key]" ]] || fail "clave duplicada en la paleta: $key"
    VALUES["$key"]=$value
  done < "$PALETTE"

  for key in "${!KEY_TYPES[@]}"; do
    [[ -v "VALUES[$key]" ]] || fail "falta la clave de paleta: $key"
  done

  [[ "${VALUES[id]}" == "$THEME_ID" ]] || fail 'el id no coincide con el tema solicitado'
  [[ "${VALUES[family]}" =~ ^[a-z0-9-]+$ ]] || fail 'familia inválida'
  [[ "${VALUES[flavour]}" =~ ^[a-z0-9-]+$ ]] || fail 'flavour inválido'
  [[ "${VALUES[accent_name]}" =~ ^[a-z0-9-]+$ ]] || fail 'accent_name inválido'

  for key in "${!VALUES[@]}"; do
    validate_value "$key"
  done
}

# Collects the installed WM template directories into WM_DIRS. It runs in the
# main shell so an unsafe name stops the render instead of a subshell. A name
# taken by a shared output (yazi, foot, ...) would overwrite it.
collect_wm_template_dirs() {
  local dir name

  WM_DIRS=()
  [[ -d "$WM_TEMPLATES_DIR" ]] || return 0
  for dir in "$WM_TEMPLATES_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    dir=${dir%/}
    name=${dir##*/}
    [[ "$name" =~ $NAME_PATTERN && ! -e "$SHARED_TEMPLATES_DIR/$name" ]] || \
      fail "nombre de plantillas de WM inválido: $name"
    WM_DIRS+=("$dir")
  done
}

# Template files below $1, relative to it, one per line, sorted.
template_files() {
  [[ -d "$1" ]] || return 0
  (cd -- "$1" && find -L . -type f -printf '%P\n' | LC_ALL=C sort)
}

# Replaces {{key}} with the palette value and, for colors only, {{key.raw}}
# with the value without its leading '#'. Any other {{...}} marker is an error.
render_template() {
  local source=$1 destination=$2 content='' key value

  IFS= read -r -d '' content < "$source" || true
  for key in "${!VALUES[@]}"; do
    value=${VALUES[$key]}
    if [[ "${KEY_TYPES[$key]}" == color ]]; then
      content=${content//"{{$key.raw}}"/"${value#\#}"}
    fi
    content=${content//"{{$key}}"/"$value"}
  done
  if [[ "$content" =~ \{\{[^}]*\}\} ]]; then
    fail "marcador desconocido ${BASH_REMATCH[0]} en $source"
  fi
  mkdir -p -- "$(dirname -- "$destination")"
  printf '%s' "$content" > "$destination"
}

render_tree() {
  local source_dir=$1 destination_dir=$2 relative

  while IFS= read -r relative; do
    [[ -n "$relative" ]] || continue
    render_template "$source_dir/$relative" "$destination_dir/$relative"
  done < <(template_files "$source_dir")
}

render_all() {
  local destination=$1 dir

  render_tree "$SHARED_TEMPLATES_DIR" "$destination"
  for dir in "${WM_DIRS[@]}"; do
    render_tree "$dir" "$destination/${dir##*/}"
  done
  printf '%s\n' "${VALUES[background]}" > "$destination/background"
  printf '%s\n' 'schema=2' "id=${VALUES[id]}" "family=${VALUES[family]}" \
    "flavour=${VALUES[flavour]}" "accent_name=${VALUES[accent_name]}" \
    > "$destination/metadata"
}

# Every template, shared or from a WM, must have rendered a non-empty file.
validate_outputs() {
  local destination=$1 dir relative required

  for required in background metadata; do
    [[ -s "$destination/$required" ]] || fail "output de tema vacío o ausente: $required"
  done
  while IFS= read -r relative; do
    [[ -n "$relative" ]] || continue
    [[ -s "$destination/$relative" ]] || fail "output de tema vacío o ausente: $relative"
  done < <(template_files "$SHARED_TEMPLATES_DIR")
  grep -Fq "${VALUES[accent]}" "$destination/gtk.css" || \
    fail 'GTK no recibió el acento del tema'
  grep -Fq "${VALUES[accent]}" "$destination/yazi/flavor.toml" || \
    fail 'Yazi no recibió el acento del tema'
  grep -Fxq "id=${VALUES[id]}" "$destination/metadata" || \
    fail 'metadata de tema inconsistente'
  for dir in "${WM_DIRS[@]}"; do
    while IFS= read -r relative; do
      [[ -n "$relative" ]] || continue
      [[ -s "$destination/${dir##*/}/$relative" ]] || \
        fail "output de tema vacío o ausente: ${dir##*/}/$relative"
    done < <(template_files "$dir")
  done
}

# The revision covers the palette, this engine and every template, including
# its path, so adding, renaming or editing a template renders a new revision.
theme_digest() {
  local dir relative digest

  digest=$(
    {
      sha256sum < "$PALETTE"
      sha256sum < "$SCRIPT_PATH"
      while IFS= read -r relative; do
        [[ -n "$relative" ]] || continue
        printf 'shared/%s ' "$relative"
        sha256sum < "$SHARED_TEMPLATES_DIR/$relative"
      done < <(template_files "$SHARED_TEMPLATES_DIR")
      for dir in "${WM_DIRS[@]}"; do
        while IFS= read -r relative; do
          [[ -n "$relative" ]] || continue
          printf '%s/%s ' "${dir##*/}" "$relative"
          sha256sum < "$dir/$relative"
        done < <(template_files "$dir")
      done
    } | sha256sum
  )
  printf '%s\n' "${digest:0:12}"
}

# Links $CONFIG_HOME/$1 to the rendered output $2 under current/, only when
# the application's config directory (the first component of $1) exists. A
# real file or directory in its place is never replaced.
link_output() {
  local link="$CONFIG_HOME/$1" app_dir="$CONFIG_HOME/${1%%/*}"

  [[ -d "$app_dir" ]] || return 0
  if [[ -e "$link" && ! -L "$link" ]]; then
    warn "no se reemplaza $link: no es un enlace simbólico"
    return 0
  fi
  mkdir -p -- "${link%/*}"
  ln -sfn -- "$THEME_ROOT/current/$2" "$link"
}

# Outputs an application only finds inside its own config directory.
link_outputs() {
  link_output yazi/flavors/theme.yazi yazi
  link_output bat/themes/dotfiles.tmTheme bat/dotfiles.tmTheme
  link_output btop/themes/dotfiles.theme btop/dotfiles.theme
  link_output micro/colorschemes/default.micro micro/default.micro
}

promote() {
  local revision=$1 next_link="$THEME_ROOT/.current.$$"

  if [[ -e "$THEME_ROOT/current" && ! -L "$THEME_ROOT/current" ]]; then
    fail "$THEME_ROOT/current existe y no es un enlace simbólico"
  fi
  ln -s -- "$revision" "$next_link"
  mv -Tf -- "$next_link" "$THEME_ROOT/current"
  link_outputs
}

render_theme() {
  local revision

  mkdir -p -- "$THEME_ROOT"
  command -v flock >/dev/null 2>&1 || fail 'flock es necesario para renderizar temas'
  exec 9>"$THEME_ROOT/render.guard"
  flock 9
  collect_wm_template_dirs
  revision="${VALUES[id]}-$(theme_digest)"

  if [[ ! -d "$THEME_ROOT/$revision" ]]; then
    RENDER_TEMP=$(mktemp -d "$THEME_ROOT/.render.XXXXXX")
    render_all "$RENDER_TEMP"
    validate_outputs "$RENDER_TEMP"
    chmod -R u=rwX,go=rX -- "$RENDER_TEMP"
    mv -- "$RENDER_TEMP" "$THEME_ROOT/$revision"
    RENDER_TEMP=''
  else
    validate_outputs "$THEME_ROOT/$revision"
  fi

  promote "$revision"
  printf '%s\n' "$THEME_ROOT/$revision"
}

gnome_accent() {
  case "${VALUES[accent_name]}" in
    blue|sapphire) printf 'blue\n' ;;
    teal|sky) printf 'teal\n' ;;
    green) printf 'green\n' ;;
    yellow) printf 'yellow\n' ;;
    peach) printf 'orange\n' ;;
    red|maroon) printf 'red\n' ;;
    pink|flamingo) printf 'pink\n' ;;
    mauve|lavender) printf 'purple\n' ;;
    *) printf 'slate\n' ;;
  esac
}

# Live reload after `set`: the GNOME accent, then every WM reload hook. A
# failing hook only warns; the theme is already promoted.
reload_live() {
  local hook

  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface accent-color "$(gnome_accent)" \
      2>/dev/null || true
  fi
  [[ -d "$RELOAD_DIR" ]] || return 0
  for hook in "$RELOAD_DIR"/*; do
    [[ -f "$hook" && -x "$hook" ]] || continue
    DOTFILES_THEME_DIR="$THEME_ROOT/current" "$hook" || \
      warn "la recarga ${hook##*/} falló"
  done
}

set_theme() {
  theme_exists "$1" || fail "tema desconocido: $1"
  read_palette "$1"
  render_theme
  printf '%s\n' "$1" > "$THEME_ROOT/selected"
  reload_live
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --urgency=low --app-name=dotfiles "Tema aplicado" \
      "$1 (${VALUES[accent_name]}: ${VALUES[accent]})" 2>/dev/null || true
  fi
}

list_themes() {
  local palette

  for palette in "$PALETTES_DIR"/*.conf; do
    [[ -f "$palette" ]] || continue
    palette=${palette##*/}
    printf '%s\n' "${palette%.conf}"
  done | LC_ALL=C sort
}

main() {
  local command=${1-}
  shift || true

  locate_repo
  case "$command" in
    render)
      (( $# <= 1 )) || { usage >&2; exit 2; }
      read_palette "${1:-$(resolve_theme_id)}"
      render_theme
      ;;
    set)
      (( $# == 1 )) || { usage >&2; exit 2; }
      set_theme "$1"
      ;;
    list)
      list_themes
      ;;
    current)
      read_palette "$(resolve_theme_id)"
      printf '%s (acento: %s, %s)\n' "$THEME_ID" "${VALUES[accent_name]}" "${VALUES[accent]}"
      ;;
    validate)
      (( $# <= 1 )) || { usage >&2; exit 2; }
      read_palette "${1:-$(resolve_theme_id)}"
      printf 'OK: %s\n' "$PALETTE"
      ;;
    path)
      if [[ ! -d "$THEME_ROOT/current" ]]; then
        read_palette "$(resolve_theme_id)"
        render_theme >/dev/null
      fi
      printf '%s\n' "$THEME_ROOT/current"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
